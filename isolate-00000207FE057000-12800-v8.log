script-source,102,file:///C:/Users/Basant/Desktop/NodeJS/Car-Pool-Website/src/adapters/outbound/persistence/PostgreSQLBookingRepository.js,import Booking from "../../../domain/entities/Booking.js";\x0d\nimport BookingRepository from "../../../application/ports/BookingRepository.js";\x0d\n\x0d\nexport default class PostgreSQLBookingRepository extends BookingRepository  {\x0d\n\x0d\n    constructor(pool) {\x0d\n        super();\x0d\n        this.pool = pool;\x0d\n    }\x0d\n\x0d\n    async create(booking) {\x0d\n\x0d\n        const query = `\x0d\n            INSERT INTO bookings (\x0d\n                ride_id\x2C\x0d\n                passenger_id\x0d\n            )\x0d\n            VALUES ($1\x2C $2)\x0d\n            RETURNING\x0d\n                id\x2C\x0d\n                ride_id\x2C\x0d\n                passenger_id\x0d\n        `;\x0d\n\x0d\n        const values = [\x0d\n            booking.rideId\x2C\x0d\n            booking.passengerId\x0d\n        ];\x0d\n\x0d\n        const result = await this.pool.query(query\x2C values);\x0d\n\x0d\n        return new Booking({\x0d\n            id: result.rows[0].id\x2C\x0d\n            rideId: result.rows[0].ride_id\x2C\x0d\n            passengerId: result.rows[0].passenger_id\x0d\n        });\x0d\n    }\x0d\n\x0d\n    async findByRideAndPassenger(rideId\x2C passengerId) {\x0d\n\x0d\n        const query = `\x0d\n            SELECT\x0d\n                id\x2C\x0d\n                ride_id\x2C\x0d\n                passenger_id\x0d\n            FROM bookings\x0d\n            WHERE ride_id = $1\x0d\n              AND passenger_id = $2\x0d\n        `;\x0d\n\x0d\n        const result = await this.pool.query(\x0d\n            query\x2C\x0d\n            [rideId\x2C passengerId]\x0d\n        );\x0d\n\x0d\n        if (result.rows.length === 0) {\x0d\n            return null;\x0d\n        }\x0d\n\x0d\n        const row = result.rows[0];\x0d\n\x0d\n        return new Booking({\x0d\n            id: row.id\x2C\x0d\n            rideId: row.ride_id\x2C\x0d\n            passengerId: row.passenger_id\x0d\n        });\x0d\n    }\x0d\n\x0d\n    async findByUserId(userId) {\x0d\n\x0d\n        const query = `\x0d\n            SELECT\x0d\n                b.id\x2C\x0d\n                b.ride_id\x2C\x0d\n                b.passenger_id\x0d\n            FROM bookings b\x0d\n            WHERE b.passenger_id = $1\x0d\n            ORDER BY b.id\x0d\n        `;\x0d\n\x0d\n        const result = await this.pool.query(query\x2C [userId]);\x0d\n\x0d\n        return result.rows.map(row => new Booking({\x0d\n            id: row.id\x2C\x0d\n            rideId: row.ride_id\x2C\x0d\n            passengerId: row.passenger_id\x0d\n        }));\x0d\n    }\x0d\n}\x0d\n
