script-source,346,node:internal/js_stream_socket,'use strict';\x0d\n\x0d\nconst {\x0d\n  Symbol\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst { setImmediate } = require('timers');\x0d\nconst assert = require('internal/assert');\x0d\nconst { Socket } = require('net');\x0d\nconst { JSStream } = internalBinding('js_stream');\x0d\nconst uv = internalBinding('uv');\x0d\nlet debug = require('internal/util/debuglog').debuglog(\x0d\n  'stream_socket'\x2C\x0d\n  (fn) => {\x0d\n    debug = fn;\x0d\n  }\x2C\x0d\n);\x0d\nconst { owner_symbol } = require('internal/async_hooks').symbols;\x0d\nconst { ERR_STREAM_WRAP } = require('internal/errors').codes;\x0d\nconst { kBoundSession } = require('internal/stream_base_commons');\x0d\n\x0d\nconst kCurrentWriteRequest = Symbol('kCurrentWriteRequest');\x0d\nconst kCurrentShutdownRequest = Symbol('kCurrentShutdownRequest');\x0d\nconst kPendingShutdownRequest = Symbol('kPendingShutdownRequest');\x0d\nconst kPendingClose = Symbol('kPendingClose');\x0d\n\x0d\nfunction isClosing() { return this[owner_symbol].isClosing(); }\x0d\n\x0d\nfunction onreadstart() { return this[owner_symbol].readStart(); }\x0d\n\x0d\nfunction onreadstop() { return this[owner_symbol].readStop(); }\x0d\n\x0d\nfunction onshutdown(req) { return this[owner_symbol].doShutdown(req); }\x0d\n\x0d\nfunction onwrite(req\x2C bufs) { return this[owner_symbol].doWrite(req\x2C bufs); }\x0d\n\x0d\n/* This class serves as a wrapper for when the C++ side of Node wants access\x0d\n * to a standard JS stream. For example\x2C TLS or HTTP do not operate on network\x0d\n * resources conceptually\x2C although that is the common case and what we are\x0d\n * optimizing for; in theory\x2C they are completely composable and can work with\x0d\n * any stream resource they see.\x0d\n *\x0d\n * For the common case\x2C i.e. a TLS socket wrapping around a net.Socket\x2C we\x0d\n * can skip going through the JS layer and let TLS access the raw C++ handle\x0d\n * of a net.Socket. The flipside of this is that\x2C to maintain composability\x2C\x0d\n * we need a way to create "fake" net.Socket instances that call back into a\x0d\n * "real" JavaScript stream. JSStreamSocket is exactly this.\x0d\n */\x0d\nclass JSStreamSocket extends Socket {\x0d\n  constructor(stream) {\x0d\n    const handle = new JSStream();\x0d\n    handle.close = (cb) => {\x0d\n      debug('close');\x0d\n      this.doClose(cb);\x0d\n    };\x0d\n    // Inside of the following functions\x2C `this` refers to the handle\x0d\n    // and `this[owner_symbol]` refers to this JSStreamSocket instance.\x0d\n    handle.isClosing = isClosing;\x0d\n    handle.onreadstart = onreadstart;\x0d\n    handle.onreadstop = onreadstop;\x0d\n    handle.onshutdown = onshutdown;\x0d\n    handle.onwrite = onwrite;\x0d\n\x0d\n    stream.pause();\x0d\n    stream.on('error'\x2C (err) => this.emit('error'\x2C err));\x0d\n    const ondata = (chunk) => {\x0d\n      if (typeof chunk === 'string' ||\x0d\n          stream.readableObjectMode === true) {\x0d\n        // Make sure that no further `data` events will happen.\x0d\n        stream.pause();\x0d\n        stream.removeListener('data'\x2C ondata);\x0d\n\x0d\n        this.emit('error'\x2C new ERR_STREAM_WRAP());\x0d\n        return;\x0d\n      }\x0d\n\x0d\n      debug('data'\x2C chunk.length);\x0d\n      if (this._handle)\x0d\n        this._handle.readBuffer(chunk);\x0d\n    };\x0d\n    stream.on('data'\x2C ondata);\x0d\n    stream.once('end'\x2C () => {\x0d\n      debug('end');\x0d\n      if (this._handle)\x0d\n        this._handle.emitEOF();\x0d\n    });\x0d\n    // Some `Stream` don't pass `hasError` parameters when closed.\x0d\n    stream.once('close'\x2C () => {\x0d\n      // Errors emitted from `stream` have also been emitted to this instance\x0d\n      // so that we don't pass errors to `destroy()` again.\x0d\n      this.destroy();\x0d\n    });\x0d\n\x0d\n    super({ handle\x2C manualStart: true });\x0d\n    this.stream = stream;\x0d\n    this[kCurrentWriteRequest] = null;\x0d\n    this[kCurrentShutdownRequest] = null;\x0d\n    this[kPendingShutdownRequest] = null;\x0d\n    this[kPendingClose] = false;\x0d\n    this.readable = stream.readable;\x0d\n    this.writable = stream.writable;\x0d\n\x0d\n    // Start reading.\x0d\n    this.read(0);\x0d\n  }\x0d\n\x0d\n  // Allow legacy requires in the test suite to keep working:\x0d\n  //   const { StreamWrap } = require('internal/js_stream_socket')\x0d\n  static get StreamWrap() {\x0d\n    return JSStreamSocket;\x0d\n  }\x0d\n\x0d\n  isClosing() {\x0d\n    return !this.readable || !this.writable;\x0d\n  }\x0d\n\x0d\n  readStart() {\x0d\n    this.stream.resume();\x0d\n    return 0;\x0d\n  }\x0d\n\x0d\n  readStop() {\x0d\n    this.stream.pause();\x0d\n    return 0;\x0d\n  }\x0d\n\x0d\n  doShutdown(req) {\x0d\n    // TODO(addaleax): It might be nice if we could get into a state where\x0d\n    // DoShutdown() is not called on streams while a write is still pending.\x0d\n    //\x0d\n    // Currently\x2C the only part of the code base where that happens is the\x0d\n    // TLS implementation\x2C which calls both DoWrite() and DoShutdown() on the\x0d\n    // underlying network stream inside of its own DoShutdown() method.\x0d\n    // Working around that on the native side is not quite trivial (yet?)\x2C\x0d\n    // so for now that is supported here.\x0d\n\x0d\n    if (this[kCurrentWriteRequest] !== null) {\x0d\n      this[kPendingShutdownRequest] = req;\x0d\n      return 0;\x0d\n    }\x0d\n\x0d\n    assert(this[kCurrentWriteRequest] === null);\x0d\n    assert(this[kCurrentShutdownRequest] === null);\x0d\n    this[kCurrentShutdownRequest] = req;\x0d\n\x0d\n    if (this[kPendingClose]) {\x0d\n      // If doClose is pending\x2C the stream & this._handle are gone. We can't do\x0d\n      // anything. doClose will call finishShutdown with ECANCELED for us shortly.\x0d\n      return 0;\x0d\n    }\x0d\n\x0d\n    const handle = this._handle;\x0d\n    assert(handle !== null);\x0d\n\x0d\n    process.nextTick(() =