meout: false\x2C\n\n  // Terminate any session with an open transaction that has been idle for longer than the specified duration in milliseconds\n  // false=unlimited\n  idle_in_transaction_session_timeout: false\x2C\n\n  // max milliseconds to wait for query to complete (client side)\n  query_timeout: false\x2C\n\n  connect_timeout: 0\x2C\n\n  keepalives: 1\x2C\n\n  keepalives_idle: 0\x2C\n}\n\nconst pgTypes = require('pg-types')\n// save default parsers\nconst parseBigInteger = pgTypes.getTypeParser(20\x2C 'text')\nconst parseBigIntegerArray = pgTypes.getTypeParser(1016\x2C 'text')\n\n// parse int8 so you can get your count values as actual numbers\nmodule.exports.__defineSetter__('parseInt8'\x2C function (val) {\n  pgTypes.setTypeParser(20\x2C 'text'\x2C val ? pgTypes.getTypeParser(23\x2C 'text') : parseBigInteger)\n  pgTypes.setTypeParser(1016\x2C 'text'\x2C val ? pgTypes.getTypeParser(1007\x2C 'text') : parseBigIntegerArray)\n})\n
