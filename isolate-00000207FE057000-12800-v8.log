ring(6\x2C 'T'\x2C null);\n    if (str.startsWith(ZERO_DATE)) {\n      // fresh instance: Date is mutable\x2C a shared invalid-date singleton\n      // could be corrupted by callers (see the parseDateTime tests)\n      return new Date(NaN);\n    }\n    if (str.length === 10) {\n      str += 'T00:00:00';\n    }\n    return new Date(str + timezone);\n  }\n\n  readDateTimeString(decimals\x2C timeSep\x2C columnType) {\n    const length = this.readInt8();\n    let y = 0;\n    let m = 0;\n    let d = 0;\n    let H = 0;\n    let M = 0;\n    let S = 0;\n    let ms = 0;\n    let str = ZERO_DATE;\n    if (length > 3) {\n      y = this.readInt16();\n      m = this.readInt8();\n      d = this.readInt8();\n      str = [leftPad(4\x2C y)\x2C leftPad(2\x2C m)\x2C leftPad(2\x2C d)].join('-');\n    }\n    if (length > 6) {\n      H = this.readInt8();\n      M = this.readInt8();\n      S = this.readInt8();\n      str += `${timeSep || ' '}${[\n        leftPad(2\x2C H)\x2C\n        leftPad(2\x2C M)\x2C\n        leftPad(2\x2C S)\x2C\n      ].join(':')}`;\n    } else if (\n      columnType === Types.DATETIME ||\n      columnType === Types.TIMESTAMP\n    ) {\n      str += ' 00:00:00';\n    }\n    if (length > 10) {\n      ms = this.readInt32();\n      str += '.';\n      if (decimals) {\n        ms = leftPad(6\x2C ms);\n        if (ms.length > decimals) {\n          ms = ms.substring(0\x2C decimals); // rounding is done at the MySQL side\x2C only 0 are here\n        }\n      }\n      str += ms;\n    }\n    return str;\n  }\n\n  // TIME - value as a string\x2C Can be negative\n  readTimeString(convertTtoMs) {\n    const length = this.readInt8();\n    if (length === 0) {\n      return '00:00:00';\n    }\n    const sign = this.readInt8() ? -1 : 1; // 'isNegative' flag byte\n    let d = 0;\n    let H = 0;\n    let M = 0;\n    let S = 0;\n    let ms = 0;\n    if (length > 6) {\n      d = this.readInt32();\n      H = this.readInt8();\n      M = this.readInt8();\n      S = this.readInt8();\n    }\