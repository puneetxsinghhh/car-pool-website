onst op = keyOps[n];\x0d\n    const opMask = kUsageMasks[op];\x0d\n    // Skipping unknown key ops\x0d\n    if (opMask === undefined)\x0d\n      continue;\x0d\n    // Have we seen it already? if so\x2C error\x0d\n    if (keyOpsMask & opMask)\x0d\n      throw lazyDOMException('Duplicate key operation'\x2C 'DataError');\x0d\n    keyOpsMask |= opMask;\x0d\n\x0d\n    // TODO(@jasnell): RFC7517 section 4.3 strong recommends validating\x0d\n    // key usage combinations. Specifically\x2C it says that unrelated key\x0d\n    // ops SHOULD NOT be used together. We're not yet validating that here.\x0d\n  }\x0d\n\x0d\n  if (usagesSet !== undefined) {\x0d\n    const usagesMask = getUsagesMask(usagesSet);\x0d\n    if ((keyOpsMask & usagesMask) !== usagesMask) {\x0d\n      throw lazyDOMException(\x0d\n        'Key operations and usage mismatch'\x2C\x0d\n        'DataError');\x0d\n    }\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction secureHeapUsed() {\x0d\n  const val = _secureHeapUsed();\x0d\n  if (val === undefined)\x0d\n    return { total: 0\x2C used: 0\x2C utilization: 0\x2C min: 0 };\x0d\n  const used = Number(_secureHeapUsed());\x0d\n  const total = Number(getOptionValue('--secure-heap'));\x0d\n  const min = Number(getOptionValue('--secure-heap-min'));\x0d\n  const utilization = used / total;\x0d\n  return { total\x2C used\x2C utilization\x2C min };\x0d\n}\x0d\n\x0d\nmodule.exports = {\x0d\n  getArrayBufferOrView\x2C\x0d\n  getCiphers\x2C\x0d\n  getCurves\x2C\x0d\n  getDataViewOrTypedArrayBuffer\x2C\x0d\n  getHashes\x2C\x0d\n  kHandle\x2C\x0d\n  setEngine\x2C\x0d\n  toBuf\x2C\x0d\n\x0d\n  kNamedCurveAliases\x2C\x0d\n  kSupportedAlgorithms\x2C\x0d\n  normalizeAlgorithm\x2C\x0d\n  normalizeHashName\x2C\x0d\n  hasAnyNotIn\x2C\x0d\n  validateByteSource\x2C\x0d\n  validateKeyOps\x2C\x0d\n  jobPromise\x2C\x0d\n  jobPromiseThen\x2C\x0d\n  cleanupWebCryptoResult\x2C\x0d\n  prepareWebCryptoResult\x2C\x0d\n  validateMaxBufferLength\x2C\x0d\n  numBitsToBytes\x2C\x0d\n  truncateToBitLength\x2C\x0d