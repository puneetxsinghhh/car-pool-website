script-source,251,node:internal/crypto/keys,'use strict';\x0d\n\x0d\nconst {\x0d\n  ArrayPrototypeSlice\x2C\x0d\n  ObjectDefineProperties\x2C\x0d\n  ObjectPrototypeHasOwnProperty\x2C\x0d\n  ObjectSetPrototypeOf\x2C\x0d\n  SafeSet\x2C\x0d\n  SymbolToStringTag\x2C\x0d\n  Uint8Array\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst {\x0d\n  KeyObjectHandle\x2C\x0d\n  createNativeKeyObjectClass\x2C\x0d\n  // eslint-disable-next-line no-restricted-syntax -- intended here\x0d\n  getKeyObjectSlots: nativeGetKeyObjectSlots\x2C\x0d\n  createCryptoKeyClass\x2C\x0d\n  // eslint-disable-next-line no-restricted-syntax -- intended here\x0d\n  getCryptoKeySlots: nativeGetCryptoKeySlots\x2C\x0d\n  kKeyTypeSecret\x2C\x0d\n  kKeyTypePublic\x2C\x0d\n  kKeyTypePrivate\x2C\x0d\n  kKeyFormatPEM\x2C\x0d\n  kKeyFormatDER\x2C\x0d\n  kKeyFormatJWK\x2C\x0d\n  kKeyFormatRawPublic\x2C\x0d\n  kKeyFormatRawPrivate\x2C\x0d\n  kKeyFormatRawSeed\x2C\x0d\n  kKeyEncodingPKCS1\x2C\x0d\n  kKeyEncodingPKCS8\x2C\x0d\n  kKeyEncodingSPKI\x2C\x0d\n  kKeyEncodingSEC1\x2C\x0d\n} = internalBinding('crypto');\x0d\n\x0d\nconst {\x0d\n  crypto: {\x0d\n    POINT_CONVERSION_COMPRESSED\x2C\x0d\n    POINT_CONVERSION_UNCOMPRESSED\x2C\x0d\n  }\x2C\x0d\n} = internalBinding('constants');\x0d\n\x0d\nconst {\x0d\n  validateObject\x2C\x0d\n  validateOneOf\x2C\x0d\n  validateString\x2C\x0d\n} = require('internal/validators');\x0d\n\x0d\nconst {\x0d\n  codes: {\x0d\n    ERR_CRYPTO_INCOMPATIBLE_KEY_OPTIONS\x2C\x0d\n    ERR_CRYPTO_INVALID_KEY_OBJECT_TYPE\x2C\x0d\n    ERR_ILLEGAL_CONSTRUCTOR\x2C\x0d\n    ERR_INVALID_ARG_TYPE\x2C\x0d\n    ERR_INVALID_ARG_VALUE\x2C\x0d\n    ERR_INVALID_THIS\x2C\x0d\n  }\x2C\x0d\n} = require('internal/errors');\x0d\n\x0d\nconst {\x0d\n  getArrayBufferOrView\x2C\x0d\n  bigIntArrayToUnsignedBigInt\x2C\x0d\n  normalizeAlgorithm\x2C\x0d\n  hasAnyNotIn\x2C\x0d\n  getUsagesMask\x2C\x0d\n  getUsagesFromMask\x2C\x0d\n  hasUsage\x2C\x0d\n} = require('internal/crypto/util');\x0d\n\x0d\nconst {\x0d\n  isAnyArrayBuffer\x2C\x0d\n  isArrayBufferView\x2C\x0d\n} = require('internal/util/types');\x0d\n\x0d\nconst {\x0d\n  customInspectSymbol: kInspect\x2C\x0d\n  getDeprecationWarningEmitter\x2C\x0d\n  kEnumerableProperty\x2C\x0d\n  kEmptyObject\x2C\x0d\n  lazyDOMException\x2C\x0d\n} = require('internal/util');\x0d\n\x0d\nconst { inspect } = require('internal/util/inspect');\x0d\n\x0d\nconst emitDEP0203 = getDeprecationWarningEmitter(\x0d\n  'DEP0203'\x2C\x0d\n  'Passing a CryptoKey to node:crypto functions is deprecated.'\x2C\x0d\n);\x0d\n\x0d\nconst maybeEmitDEP0204 = getDeprecationWarningEmitter(\x0d\n  'DEP0204'\x2C\x0d\n  'Passing a non-extractable CryptoKey to KeyObject.from() is deprecated.'\x2C\x0d\n  undefined\x2C\x0d\n  false\x2C\x0d\n  (key) => !getCryptoKeyExtractable(key)\x2C\x0d\n);\x0d\n\x0d\n// Key input contexts.\x0d\nconst kConsumePublic = 0;\x0d\nconst kConsumePrivate = 1;\x0d\nconst kCreatePublic = 2;\x0d\nconst kCreatePrivate = 3;\x0d\n\x0d\nconst encodingNames = [];\x0d\nfor (const m of [[kKeyEncodingPKCS1\x2C 'pkcs1']\x2C [kKeyEncodingPKCS8\x2C 'pkcs8']\x2C\x0d\n                 [kKeyEncodingSPKI\x2C 'spki']\x2C [kKeyEncodingSEC1\x2C 'sec1']])\x0d\n  encodingNames[m[0]] = m[1];\x0d\n\x0d\n// KeyObject state lives on the native NativeKeyObject base class. JS reads\x0d\n// the native type enum and a KeyObjectHandle in one call and caches that\x0d\n// slot tuple in a private field so no forgeable own Symbols are exposed on\x0d\n// public KeyObject instances.\x0d\nlet getKeyObjectSlots; // Populated by the createNativeKeyObjectClass callback.\x0d\n\x0d\nconst kKeyObjectSlotType = 0;\x0d\nconst kKeyObjectSlotHandle = 1;\x0d\n// The native slot tuple stops at kKeyObjectSlotHandle. The remaining entries\x0d\n// are JS-side lazy cache slots derived from the KeyObjectHandle on first use.\x0d\nconst kKeyObjectSlotSymmetricKeySize = 2;\x0d\nconst kKeyObjectSlotAsymmetricKeyType = 3;\x0d\nconst kKeyObjectSlotAsymmetricKeyDetails = 4;\x0d\n\x0d\nfunction normalizeKeyDetails(details = kEmptyObject) {\x0d\n  if (details.publicExponent !== undefined) {\x0d\n    return {\x0d\n      __proto__: null\x2C\x0d\n      ...details\x2C\x0d\n      publicExponent:\x0d\n        bigIntArrayToUnsignedBigInt(new Uint8Array(details.publicExponent))\x2C\x0d\n    };\x0d\n  }\x0d\n  return details;\x0d\n}\x0d\n\x0d\n// Creating the KeyObject class is a little complicated due to inheritance\x0d\n// and the fact that KeyObjects should be transferable between threads\x2C\x0d\n// which requires the KeyObject base class to be implemented in C++.\x0d\n// The creation requires a callback to make sure that the NativeKeyObject\x0d\n// base class cannot exist without the other KeyObject implementations.\x0d\nconst {\x0d\n  0: KeyObject\x2C\x0d\n  1: SecretKeyObject\x2C\x0d\n  2: PublicKeyObject\x2C\x0d\n  3: PrivateKeyObject\x2C\x0d\n} = createNativeKeyObjectClass((NativeKeyObject) => {\x0d\n  let webidl;\x0d\n\x0d\n  // Publicly visible KeyObject class.\x0d\n  class KeyObject extends NativeKeyObject {\x0d\n    #slots;\x0d\n\x0d\n    constructor(type\x2C handle) {\x0d\n      if (type !== 'secret' && type !== 'public' && type !== 'private')\x0d\n        throw new ERR_INVALID_ARG_VALUE('type'\x2C type);\x0d\n      if (typeof handle !== 'object' || !(handle instanceof KeyObjectHandle))\x0d\n        throw new ERR_INVALID_ARG_TYPE('handle'\x2C 'object'\x2C handle);\x0d\n\x0d\n      super(handle);\x0d\n    }\x0d\n\x0d\n    get type() {\x0d\n      return getKeyObjectType(this);\x0d\n    }\x0d\n\x0d\n    toCryptoKey(algorithm\x2C extractable\x2C keyUsages) {\x0d\n      webidl ??= require('internal/crypto/webidl');\x0d\n      algorithm = normalizeAlgorithm(webidl.converters.AlgorithmIdentifier(algorithm)\x2C 'importKey');\x0d\n      extractable = webidl.converters.boolean(extractable);\x0d\n      keyUsages = webidl.converters['sequence<KeyUsage>'](keyUsages);\x0d\n\x0d\n      const type = getKeyObjectType(this);\x0d\n      const handle = getKeyObjectHandle(this);\x0d\n      switch (type) {\x0d\n        case 'secret':\x0d\n          return toCryptoKeySecret(\x0d\n            handle\x2C\x0d\n            algorithm\x2C\x0d\n            extractable\x2C\x0d\n            keyUsages);\x0d\n        case 'public':\x0d\n          // Fall through\x0d\n        case 'private':\x0d\n          return toCryptoKey(\x0d\n            handle\x2C\x0d\n            algorithm\x2C\x0d\n            extractable\x2C\x0d\n            keyUsages);\x0d\n      }\x0d\n    }\x0d\n\x0d\n    static from(key) {\x0d\n      if (!isCryptoKey(key))\x0d\n        throw new ERR_INVALID_ARG_TYPE('key'\x2C 'CryptoKey'\x2C key);\x0d\n      maybeEmitDEP0204(key);\x0d\n      const handle = getCryptoKeyHandle(key);\x0d\n      switch (getCryptoKeyType(key)) {\x0d\n        /* eslint-disable no-use-before-define */\x0d\n        case 'secret': return new SecretKeyObject(handle);\x0d\n        case 'public': return new PublicKeyObject(handle);\x0d\n        case 'private': return new PrivateKeyObject(handle);\x0d\n        /* eslint-enable no-use-before-define */\x0d\n      }\x0d\n    }\x0d\n\x0d\n    equals(otherKeyObject) {\x0d\n      if (!isKeyObject(otherKeyObject)) {\x0d\n        throw new ERR_INVALID_ARG_TYPE(\x0d\n          'otherKeyObject'\x2C 'KeyObject'\x2C otherKeyObject);\x0d\n      }\x0d\n\x0d\n      const slots = getKeyObjectSlots(this);\x0d\n      const otherSlots = getKeyObjectSlots(otherKeyObject);\x0d\n      return slots[kKeyObjectSlotType] === otherSlots[kKeyObjectSlotType] &&\x0d\n        slots[kKeyObjectSlotHandle].equals(\x0d\n          otherSlots[kKeyObjectSlotHandle]);\x0d\n    }\x0d\n\x0d\n    static {\x0d\n      getKeyObjectSlots = (key) => {\x0d\n        if (!key || typeof key !== 'object')\x0d\n          throw new ERR_INVALID_THIS('KeyObject');\x0d\n        if (#slots in key) {\x0d\n          const cached = key.#slots;\x0d\n          if (cached !== undefined) return cached;\x0d\n        }\x0d\n        const slots = nativeGetKeyObjectSlots(key);\x0d\n        key.#slots = slots;\x0d\n        return slots;\x0d\n      };\x0d\n    }\x0d\n  }\x0d\n\x0d\n  ObjectDefineProperties(KeyObject.prototype\x2C {\x0d\n    [SymbolToStringTag]: {\x0d\n      __proto__: null\x2C\x0d\n      configurable: true\x2C\x0d\n      value: 'KeyObject'\x2C\x0d\n    }\x2C\x0d\n  });\x0d\n\x0d\n  class SecretKeyObject extends KeyObject {\x0d\n    constructor(handle) {\x0d\n      super('secret'\x2C handle);\x0d\n    }\x0d\n\x0d\n    get symmetricKeySize() {\x0d\n      return getKeyObjectSymmetricKeySize(this);\x0d\n    }\x0d\n\x0d\n    export(options) {\x0d\n      const handle = getKeyObjectHandle(this);\x0d\n      if (options !== undefined) {\x0d\n        validateObject(options\x2C 'options');\x0d\n        validateOneOf(\x0d\n          options.format\x2C 'options.format'\x2C [undefined\x2C 'buffer'\x2C 'jwk']);\x0d\n        if (options.format === 'jwk') {\x0d\n          return handle.exportJwk({}\x2C false);\x0d\n        }\x0d\n      }\x0d\n      return handle.export();\x0d\n    }\x0d\n  }\x0d\n\x0d\n  class AsymmetricKeyObject extends KeyObject {\x0d\n    get asymmetricKeyType() {\x0d\n      return getKeyObjectAsymmetricKeyType(this);\x0d\n    }\x0d\n\x0d\n    get asymmetricKeyDetails() {\x0d\n      return { ...getKeyObjectAsymmetricKeyDetails(this) };\x0d\n    }\x0d\n  }\x0d\n\x0d\n  class PublicKeyObject extends AsymmetricKeyObject {\x0d\n    constructor(handle) {\x0d\n      super('public'\x2C handle);\x0d\n    }\x0d\n\x0d\n    export(options) {\x0d\n      switch (options?.format) {\x0d\n        case 'jwk':\x0d\n          return getKeyObjectHandle(this).exportJwk({}\x2C false);\x0d\n        case 'raw-public': {\x0d\n          const handle = getKeyObjectHandle(this);\x0d\n          const asymmetricKeyType = getKeyObjectAsymmetricKeyType(this);\x0d\n          if (asymmetricKeyType === 'ec') {\x0d\n            const { type = 'uncompressed' } = options;\x0d\n            validateOneOf(type\x2C 'options.type'\x2C ['compressed'\x2C 'uncompressed']);\x0d\n            const form = type === 'compressed' ?\x0d\n              POINT_CONVERSION_COMPRESSED : POINT_CONVERSION_UNCOMPRESSED;\x0d\n            return handle.exportECPublicRaw(form);\x0d\n          }\x0d\n          return handle.rawPublicKey();\x0d\n        }\x0d\n        default: {\x0d\n          const asymmetricKeyType = getKeyObjectAsymmetricKeyType(this);\x0d\n          const handle = getKeyObjectHandle(this);\x0d\n          const {\x0d\n            format\x2C\x0d\n            type\x2C\x0d\n          } = parsePublicKeyEncoding(options\x2C asymmetricKeyType);\x0d\n          return handle.export(format\x2C type);\x0d\n        }\x0d\n      }\x0d\n    }\x0d\n  }\x0d\n\x0d\n  class PrivateKeyObject extends AsymmetricKeyObject {\x0d\n    constructor(handle) {\x0d\n      super('private'\x2C handle);\x0d\n    }\x0d\n\x0d\n    export(options) {\x0d\n      if (options?.passphrase !== undefined &&\x0d\n          options.format !== 'pem' && options.format !== 'der') {\x0d\n        throw new ERR_CRYPTO_INCOMPATIBLE_KEY_OPTIONS(\x0d\n          options.format\x2C 'does not support encryption');\x0d\n      }\x0d\n      switch (options?.format) {\x0d\n        case 'jwk':\x0d\n          return getKeyObjectHandle(this).exportJwk({}\x2C false);\x0d\n        case 'raw-private': {\x0d\n          const handle = getKeyObjectHandle(this);\x0d\n          const asymmetricKeyType = getKeyObjectAsymmetricKeyType(this);\x0d\n          if (asymmetricKeyType === 'ec') {\x0d\n            return handle.exportECPrivateRaw();\x0d\n          }\x0d\n          return handle.rawPrivateKey();\x0d\n        }\x0d\n        case 'raw-seed':\x0d\n          return getKeyObjectHandle(this).rawSeed();\x0d\n        default: {\x0d\n          const asymmetricKeyType = getKeyObjectAsymmetricKeyType(this);\x0d\n          const handle = getKeyObjectHandle(this);\x0d\n          const {\x0d\n            format\x2C\x0d\n            type\x2C\x0d\n            cipher\x2C\x0d\n            passphrase\x2C\x0d\n          } = parsePrivateKeyEncoding(options\x2C asymmetricKeyType);\x0d\n          return handle.export(format\x2C type\x2C cipher\x2C passphrase);\x0d\n        }\x0d\n      }\x0d\n    }\x0d\n  }\x0d\n\x0d\n  return [KeyObject\x2C SecretKeyObject\x2C PublicKeyObject\x2C PrivateKeyObject];\x0d\n});\x0d\n\x0d\nfunction parseKeyFormat(formatStr\x2C defaultFormat\x2C optionName) {\x0d\n  if (formatStr === undefined && defaultFormat !== undefined)\x0d\n    return defaultFormat;\x0d\n  else if (formatStr === 'pem')\x0d\n    return kKeyFormatPEM;\x0d\n  else if (formatStr === 'der')\x0d\n    return kKeyFormatDER;\x0d\n  else if (formatStr === 'jwk')\x0d\n    return kKeyFormatJWK;\x0d\n  else if (formatStr === 'raw-public')\x0d\n    return kKeyFormatRawPublic;\x0d\n  else if (formatStr === 'raw-private')\x0d\n    return kKeyFormatRawPrivate;\x0d\n  else if (formatStr === 'raw-seed')\x0d\n    return kKeyFormatRawSeed;\x0d\n  throw new ERR_INVALID_ARG_VALUE(optionName\x2C formatStr);\x0d\n}\x0d\n\x0d\nfunction parseKeyType(typeStr\x2C required\x2C keyType\x2C isPublic\x2C optionName) {\x0d\n  if (typeStr === undefined && !required) {\x0d\n    return undefined;\x0d\n  } else if (typeStr === 'pkcs1') {\x0d\n    if (keyType !== undefined && keyType !== 'rsa') {\x0d\n      throw new ERR_CRYPTO_INCOMPATIBLE_KEY_OPTIONS(\x0d\n        typeStr\x2C 'can only be used for RSA keys');\x0d\n    }\x0d\n    return kKeyEncodingPKCS1;\x0d\n  } else if (typeStr === 'spki' && isPublic !== false) {\x0d\n    return kKeyEncodingSPKI;\x0d\n  } else if (typeStr === 'pkcs8' && isPublic !== true) {\x0d\n    return kKeyEncodingPKCS8;\x0d\n  } else if (typeStr === 'sec1' && isPublic !== true) {\x0d\n    if (keyType !== undefined && keyType !== 'ec') {\x0d\n      throw new ERR_CRYPTO_INCOMPATIBLE_KEY_OPTIONS(\x0d\n        typeStr\x2C 'can only be used for EC keys');\x0d\n    }\x0d\n    return kKeyEncodingSEC1;\x0d\n  }\x0d\n\x0d\n  throw new ERR_INVALID_ARG_VALUE(optionName\x2C typeStr);\x0d\n}\x0d\n\x0d\nfunction option(name\x2C prefix) {\x0d\n  return prefix === undefined ?\x0d\n    `options.${name}` : `${prefix}.${name}`;\x0d\n}\x0d\n\x0d\nfunction parseKeyFormatAndType(enc\x2C keyType\x2C isPublic\x2C objName) {\x0d\n  const { format: formatStr\x2C type: typeStr } = enc;\x0d\n\x0d\n  const isInput = keyType === undefined;\x0d\n  const format = parseKeyFormat(formatStr\x2C\x0d\n                                isInput ? kKeyFormatPEM : undefined\x2C\x0d\n                                option('format'\x2C objName));\x0d\n\x0d\n  if (format === kKeyFormatRawPublic) {\x0d\n    if (isPublic === false) {\x0d\n      throw new ERR_INVALID_ARG_VALUE(option('format'\x2C objName)\x2C 'raw-public');\x0d\n    }\x0d\n    let type;\x0d\n    if (typeStr === undefined || typeStr === 'uncompressed') {\x0d\n      type = POINT_CONVERSION_UNCOMPRESSED;\x0d\n    } else if (typeStr === 'compressed') {\x0d\n      type = POINT_CONVERSION_COMPRESSED;\x0d\n    } else {\x0d\n      throw new ERR_INVALID_ARG_VALUE(option('type'\x2C objName)\x2C typeStr);\x0d\n    }\x0d\n    return { format\x2C type };\x0d\n  }\x0d\n\x0d\n  if (format === kKeyFormatRawPrivate || format === kKeyFormatRawSeed) {\x0d\n    if (isPublic === true) {\x0d\n      throw new ERR_INVALID_ARG_VALUE(\x0d\n        option('format'\x2C objName)\x2C\x0d\n        format === kKeyFormatRawPrivate ? 'raw-private' : 'raw-seed');\x0d\n    }\x0d\n    if (typeStr !== undefined) {\x0d\n      throw new ERR_INVALID_ARG_VALUE(option('type'\x2C objName)\x2C typeStr);\x0d\n    }\x0d\n    return { format };\x0d\n  }\x0d\n\x0d\n  const isRequired = (!isInput ||\x0d\n                      format === kKeyFormatDER) &&\x0d\n                      format !== kKeyFormatJWK;\x0d\n  const type = parseKeyType(typeStr\x2C\x0d\n                            isRequired\x2C\x0d\n                            keyType\x2C\x0d\n                            isPublic\x2C\x0d\n                            option('type'\x2C objName));\x0d\n  return { format\x2C type };\x0d\n}\x0d\n\x0d\nfunction isStringOrBuffer(val) {\x0d\n  return typeof val === 'string' ||\x0d\n         isArrayBufferView(val) ||\x0d\n         isAnyArrayBuffer(val);\x0d\n}\x0d\n\x0d\nfunction parseKeyEncoding(enc\x2C keyType\x2C isPublic\x2C objName) {\x0d\n  validateObject(enc\x2C 'options');\x0d\n\x0d\n  const isInput = keyType === undefined;\x0d\n\x0d\n  const {\x0d\n    format\x2C\x0d\n    type\x2C\x0d\n  } = parseKeyFormatAndType(enc\x2C keyType\x2C isPublic\x2C objName);\x0d\n\x0d\n  let cipher\x2C passphrase\x2C encoding;\x0d\n  if (isPublic !== true) {\x0d\n    ({ cipher\x2C passphrase\x2C encoding } = enc);\x0d\n\x0d\n    if (format === kKeyFormatRawPrivate || format === kKeyFormatRawSeed) {\x0d\n      if (cipher != null || passphrase !== undefined) {\x0d\n        throw new ERR_CRYPTO_INCOMPATIBLE_KEY_OPTIONS(\x0d\n          'raw format'\x2C 'does not support encryption');\x0d\n      }\x0d\n      return { format\x2C type };\x0d\n    }\x0d\n\x0d\n    if (!isInput) {\x0d\n      if (cipher != null) {\x0d\n        if (typeof cipher !== 'string')\x0d\n          throw new ERR_INVALID_ARG_VALUE(option('cipher'\x2C objName)\x2C cipher);\x0d\n        if (format === kKeyFormatDER &&\x0d\n            (type === kKeyEncodingPKCS1 ||\x0d\n             type === kKeyEncodingSEC1)) {\x0d\n          throw new ERR_CRYPTO_INCOMPATIBLE_KEY_OPTIONS(\x0d\n            encodingNames[type]\x2C 'does not support encryption');\x0d\n        }\x0d\n      } else if (passphrase !== undefined) {\x0d\n        throw new ERR_INVALID_ARG_VALUE(option('cipher'\x2C objName)\x2C cipher);\x0d\n      }\x0d\n    }\x0d\n\x0d\n    if ((isInput && passphrase !== undefined &&\x0d\n         !isStringOrBuffer(passphrase)) ||\x0d\n        (!isInput && cipher != null && !isStringOrBuffer(passphrase))) {\x0d\n      throw new ERR_INVALID_ARG_VALUE(option('passphrase'\x2C objName)\x2C\x0d\n                                      passphrase);\x0d\n    }\x0d\n  }\x0d\n\x0d\n  if (passphrase !== undefined)\x0d\n    passphrase = getArrayBufferOrView(passphrase\x2C 'key.passphrase'\x2C encoding);\x0d\n\x0d\n  return { format\x2C type\x2C cipher\x2C passphrase };\x0d\n}\x0d\n\x0d\n// Parses the public key encoding based on an object. keyType must be undefined\x0d\n// when this is used to parse an input encoding and must be a valid key type if\x0d\n// used to parse an output encoding.\x0d\nfunction parsePublicKeyEncoding(enc\x2C keyType\x2C objName) {\x0d\n  return parseKeyEncoding(enc\x2C keyType\x2C keyType ? true : undefined\x2C objName);\x0d\n}\x0d\n\x0d\n// Parses the private key encoding based on an object. keyType must be undefined\x0d\n// when this is used to parse an input encoding and must be a valid key type if\x0d\n// used to parse an output encoding.\x0d\nfunction parsePrivateKeyEncoding(enc\x2C keyType\x2C objName) {\x0d\n  return parseKeyEncoding(enc\x2C keyType\x2C false\x2C objName);\x0d\n}\x0d\n\x0d\nfunction validateAsymmetricKeyType(type\x2C ctx\x2C key) {\x0d\n  if (ctx === kCreatePrivate) {\x0d\n    throw new ERR_INVALID_ARG_TYPE(\x0d\n      'key'\x2C\x0d\n      ['string'\x2C 'ArrayBuffer'\x2C 'Buffer'\x2C 'TypedArray'\x2C 'DataView']\x2C\x0d\n      key\x2C\x0d\n    );\x0d\n  }\x0d\n\x0d\n  if (type !== 'private') {\x0d\n    if (ctx === kConsumePrivate || ctx === kCreatePublic)\x0d\n      throw new ERR_CRYPTO_INVALID_KEY_OBJECT_TYPE(type\x2C 'private');\x0d\n    if (type !== 'public') {\x0d\n      throw new ERR_CRYPTO_INVALID_KEY_OBJECT_TYPE(type\x2C\x0d\n                                                   'private or public');\x0d\n    }\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction getKeyTypes(allowKeyObject\x2C bufferOnly = false) {\x0d\n  const types = [\x0d\n    'ArrayBuffer'\x2C\x0d\n    'Buffer'\x2C\x0d\n    'TypedArray'\x2C\x0d\n    'DataView'\x2C\x0d\n    'string'\x2C // Only if bufferOnly == false\x0d\n    'KeyObject'\x2C // Only if allowKeyObject == true && bufferOnly == false\x0d\n    'CryptoKey'\x2C // Only if allowKeyObject == true && bufferOnly == false\x0d\n  ];\x0d\n  if (bufferOnly) {\x0d\n    return ArrayPrototypeSlice(types\x2C 0\x2C 4);\x0d\n  } else if (!allowKeyObject) {\x0d\n    return ArrayPrototypeSlice(types\x2C 0\x2C 5);\x0d\n  }\x0d\n  return types;\x0d\n}\x0d\n\x0d\n\x0d\nfunction prepareAsymmetricKey(key\x2C ctx\x2C name = 'key') {\x0d\n  if (isKeyObject(key)) {\x0d\n    // Best case: A key object\x2C as simple as that.\x0d\n    const type = getKeyObjectType(key);\x0d\n    validateAsymmetricKeyType(type\x2C ctx\x2C key);\x0d\n    return { data: getKeyObjectHandle(key) };\x0d\n  }\x0d\n  if (isCryptoKey(key)) {\x0d\n    emitDEP0203();\x0d\n    validateAsymmetricKeyType(getCryptoKeyType(key)\x2C ctx\x2C key);\x0d\n    return { data: getCryptoKeyHandle(key) };\x0d\n  }\x0d\n  if (isStringOrBuffer(key)) {\x0d\n    // Expect PEM by default\x2C mostly for backward compatibility.\x0d\n    return { format: kKeyFormatPEM\x2C data: getArrayBufferOrView(key\x2C name) };\x0d\n  }\x0d\n  if (typeof key === 'object') {\x0d\n    const { key: data\x2C encoding\x2C format } = key;\x0d\n\x0d\n    // The 'key' property can be a KeyObject as well to allow specifying\x0d\n    // additional options such as padding along with the key.\x0d\n    if (isKeyObject(data)) {\x0d\n      const type = getKeyObjectType(data);\x0d\n      validateAsymmetricKeyType(type\x2C ctx\x2C data);\x0d\n      return { data: getKeyObjectHandle(data) };\x0d\n    }\x0d\n    if (isCryptoKey(data)) {\x0d\n      emitDEP0203();\x0d\n      validateAsymmetricKeyType(getCryptoKeyType(data)\x2C ctx\x2C data);\x0d\n      return { data: getCryptoKeyHandle(data) };\x0d\n    }\x0d\n    if (format === 'jwk') {\x0d\n      validateObject(data\x2C `${name}.key`);\x0d\n      return { data\x2C format: kKeyFormatJWK };\x0d\n    } else if (format === 'raw-public' || format === 'raw-private' ||\x0d\n               format === 'raw-seed') {\x0d\n      if ((ctx === kConsumePrivate || ctx === kCreatePrivate) &&\x0d\n          format === 'raw-public') {\x0d\n        throw new ERR_INVALID_ARG_VALUE(`${name}.format`\x2C format);\x0d\n      }\x0d\n      if (!isArrayBufferView(data) && !isAnyArrayBuffer(data)) {\x0d\n        throw new ERR_INVALID_ARG_TYPE(\x0d\n          `${name}.key`\x2C\x0d\n          ['ArrayBuffer'\x2C 'Buffer'\x2C 'TypedArray'\x2C 'DataView']\x2C\x0d\n          data);\x0d\n      }\x0d\n      validateString(key.asymmetricKeyType\x2C `${name}.asymmetricKeyType`);\x0d\n      if (key.asymmetricKeyType === 'ec') {\x0d\n        validateString(key.namedCurve\x2C `${name}.namedCurve`);\x0d\n      }\x0d\n      const rawFormat = parseKeyFormat(format\x2C undefined\x2C `${name}.format`);\x0d\n      return {\x0d\n        data: getArrayBufferOrView(data\x2C `${name}.key`)\x2C\x0d\n        format: rawFormat\x2C\x0d\n        type: key.asymmetricKeyType\x2C\x0d\n        namedCurve: key.namedCurve ?? null\x2C\x0d\n      };\x0d\n    }\x0d\n\x0d\n    // Either PEM or DER using PKCS#1 or SPKI.\x0d\n    if (!isStringOrBuffer(data)) {\x0d\n      throw new ERR_INVALID_ARG_TYPE(\x0d\n        `${name}.key`\x2C\x0d\n        getKeyTypes(ctx !== kCreatePrivate)\x2C\x0d\n        data);\x0d\n    }\x0d\n\x0d\n    const isPublic =\x0d\n      (ctx === kConsumePrivate || ctx === kCreatePrivate) ? false : undefined;\x0d\n    return {\x0d\n      data: getArrayBufferOrView(data\x2C `${name}.key`\x2C encoding)\x2C\x0d\n      ...parseKeyEncoding(key\x2C undefined\x2C isPublic\x2C name)\x2C\x0d\n    };\x0d\n  }\x0d\n\x0d\n  throw new ERR_INVALID_ARG_TYPE(\x0d\n    name\x2C\x0d\n    getKeyTypes(ctx !== kCreatePrivate)\x2C\x0d\n    key);\x0d\n}\x0d\n\x0d\nfunction preparePrivateKey(key\x2C name) {\x0d\n  return prepareAsymmetricKey(key\x2C kConsumePrivate\x2C name);\x0d\n}\x0d\n\x0d\nfunction preparePublicOrPrivateKey(key\x2C name) {\x0d\n  return prepareAsymmetricKey(key\x2C kConsumePublic\x2C name);\x0d\n}\x0d\n\x0d\nfunction prepareSecretKey(key\x2C encoding\x2C bufferOnly = false) {\x0d\n  if (!bufferOnly) {\x0d\n    if (isKeyObject(key)) {\x0d\n      const type = getKeyObjectType(key);\x0d\n      if (type !== 'secret')\x0d\n        throw new ERR_CRYPTO_INVALID_KEY_OBJECT_TYPE(type\x2C 'secret');\x0d\n      return getKeyObjectHandle(key);\x0d\n    }\x0d\n    if (isCryptoKey(key)) {\x0d\n      emitDEP0203();\x0d\n      const type = getCryptoKeyType(key);\x0d\n      if (type !== 'secret')\x0d\n        throw new ERR_CRYPTO_INVALID_KEY_OBJECT_TYPE(type\x2C 'secret');\x0d\n      return getCryptoKeyHandle(key);\x0d\n    }\x0d\n  }\x0d\n  if (typeof key !== 'string' &&\x0d\n      !isArrayBufferView(key) &&\x0d\n      !isAnyArrayBuffer(key)) {\x0d\n    throw new ERR_INVALID_ARG_TYPE(\x0d\n      'key'\x2C\x0d\n      getKeyTypes(!bufferOnly\x2C bufferOnly)\x2C\x0d\n      key);\x0d\n  }\x0d\n  return getArrayBufferOrView(key\x2C 'key'\x2C encoding);\x0d\n}\x0d\n\x0d\nfunction createSecretKey(key\x2C encoding) {\x0d\n  key = prepareSecretKey(key\x2C encoding\x2C true);\x0d\n  const handle = new KeyObjectHandle();\x0d\n  handle.init(kKeyTypeSecret\x2C key);\x0d\n  return new SecretKeyObject(handle);\x0d\n}\x0d\n\x0d\nfunction createPublicKey(key) {\x0d\n  const { format\x2C type\x2C data\x2C passphrase\x2C namedCurve } =\x0d\n    prepareAsymmetricKey(key\x2C kCreatePublic);\x0d\n  const handle = new KeyObjectHandle();\x0d\n  handle.init(kKeyTypePublic\x2C data\x2C format ?? null\x2C\x0d\n              type ?? null\x2C passphrase ?? null\x2C namedCurve ?? null);\x0d\n  return new PublicKeyObject(handle);\x0d\n}\x0d\n\x0d\n/**\x0d\n * Converts a secret KeyObjectHandle to a CryptoKey by dispatching to the\x0d\n * algorithm-specific Web Crypto import path.\x0d\n * @param {KeyObjectHandle} keyData\x0d\n * @param {object} algorithm\x0d\n * @param {boolean} extractable\x0d\n * @param {string[]} keyUsages\x0d\n * @returns {CryptoKey}\x0d\n */\x0d\nfunction toCryptoKeySecret(\x0d\n  keyData\x2C\x0d\n  algorithm\x2C\x0d\n  extractable\x2C\x0d\n  keyUsages\x2C\x0d\n) {\x0d\n  let result;\x0d\n  switch (algorithm.name) {\x0d\n    case 'HMAC':\x0d\n      // Fall through\x0d\n    case 'KMAC128':\x0d\n      // Fall through\x0d\n    case 'KMAC256':\x0d\n      result = require('internal/crypto/mac')\x0d\n        .macImportKey('KeyObjectHandle'\x2C keyData\x2C algorithm\x2C extractable\x2C keyUsages);\x0d\n      break;\x0d\n    case 'AES-CTR':\x0d\n      // Fall through\x0d\n    case 'AES-CBC':\x0d\n      // Fall through\x0d\n    case 'AES-GCM':\x0d\n      // Fall through\x0d\n    case 'AES-KW':\x0d\n      // Fall through\x0d\n    case 'AES-OCB':\x0d\n      result = require('internal/crypto/aes')\x0d\n        .aesImportKey(algorithm\x2C 'KeyObjectHandle'\x2C keyData\x2C extractable\x2C keyUsages);\x0d\n      break;\x0d\n    case 'ChaCha20-Poly1305':\x0d\n      result = require('internal/crypto/chacha20_poly1305')\x0d\n        .c20pImportKey(algorithm\x2C 'KeyObjectHandle'\x2C keyData\x2C extractable\x2C keyUsages);\x0d\n      break;\x0d\n    case 'HKDF':\x0d\n      // Fall through\x0d\n    case 'PBKDF2':\x0d\n      // Fall through\x0d\n    case 'Argon2d':\x0d\n      // Fall through\x0d\n    case 'Argon2i':\x0d\n      // Fall through\x0d\n    case 'Argon2id':\x0d\n      result = importGenericSecretKey(\x0d\n        algorithm\x2C\x0d\n        'KeyObjectHandle'\x2C\x0d\n        keyData\x2C\x0d\n        extractable\x2C\x0d\n        keyUsages);\x0d\n      break;\x0d\n    default:\x0d\n      throw lazyDOMException('Unrecognized algorithm name'\x2C 'NotSupportedError');\x0d\n  }\x0d\n\x0d\n  if (getCryptoKeyUsagesMask(result) === 0) {\x0d\n    throw lazyDOMException(\x0d\n      `Usages cannot be empty when importing a ${getCryptoKeyType(result)} key.`\x2C\x0d\n      'SyntaxError');\x0d\n  }\x0d\n\x0d\n  return result;\x0d\n}\x0d\n\x0d\n/**\x0d\n * Converts an asymmetric KeyObjectHandle to a CryptoKey by dispatching to\x0d\n * the algorithm-specific Web Crypto import path. This preserves the same\x0d\n * algorithm and usage validation used by SubtleCrypto.importKey().\x0d\n * @param {KeyObjectHandle} keyData\x0d\n * @param {object} algorithm\x0d\n * @param {boolean} extractable\x0d\n * @param {string[]} keyUsages\x0d\n * @returns {CryptoKey}\x0d\n */\x0d\nfunction toCryptoKey(\x0d\n  keyData\x2C\x0d\n  algorithm\x2C\x0d\n  extractable\x2C\x0d\n  keyUsages\x2C\x0d\n) {\x0d\n  let result;\x0d\n  switch (algorithm.name) {\x0d\n    case 'RSASSA-PKCS1-v1_5':\x0d\n      // Fall through\x0d\n    case 'RSA-PSS':\x0d\n      // Fall through\x0d\n    case 'RSA-OAEP':\x0d\n      result = require('internal/crypto/rsa')\x0d\n        .rsaImportKey('KeyObjectHandle'\x2C keyData\x2C algorithm\x2C extractable\x2C keyUsages);\x0d\n      break;\x0d\n    case 'ECDSA':\x0d\n      // Fall through\x0d\n    case 'ECDH':\x0d\n      result = require('internal/crypto/ec')\x0d\n        .ecImportKey('KeyObjectHandle'\x2C keyData\x2C algorithm\x2C extractable\x2C keyUsages);\x0d\n      break;\x0d\n    case 'Ed25519':\x0d\n      // Fall through\x0d\n    case 'Ed448':\x0d\n      // Fall through\x0d\n    case 'X25519':\x0d\n      // Fall through\x0d\n    case 'X448':\x0d\n      result = require('internal/crypto/cfrg')\x0d\n        .cfrgImportKey('KeyObjectHandle'\x2C keyData\x2C algorithm\x2C extractable\x2C keyUsages);\x0d\n      break;\x0d\n    case 'ML-DSA-44':\x0d\n      // Fall through\x0d\n    case 'ML-DSA-65':\x0d\n      // Fall through\x0d\n    case 'ML-DSA-87':\x0d\n      result = require('internal/crypto/ml_dsa')\x0d\n        .mlDsaImportKey('KeyObjectHandle'\x2C keyData\x2C algorithm\x2C extractable\x2C keyUsages);\x0d\n      break;\x0d\n    case 'ML-KEM-512':\x0d\n      // Fall through\x0d\n    case 'ML-KEM-768':\x0d\n      // Fall through\x0d\n    case 'ML-KEM-1024':\x0d\n      result = require('internal/crypto/ml_kem')\x0d\n        .mlKemImportKey('KeyObjectHandle'\x2C keyData\x2C algorithm\x2C extractable\x2C keyUsages);\x0d\n      break;\x0d\n    default:\x0d\n      throw lazyDOMException('Unrecognized algorithm name'\x2C 'NotSupportedError');\x0d\n  }\x0d\n\x0d\n  const resultType = getCryptoKeyType(result);\x0d\n  if (resultType === 'private' && getCryptoKeyUsagesMask(result) === 0) {\x0d\n    throw lazyDOMException(\x0d\n      `Usages cannot be empty when importing a ${resultType} key.`\x2C\x0d\n      'SyntaxError');\x0d\n  }\x0d\n\x0d\n  return result;\x0d\n}\x0d\n\x0d\n/**\x0d\n * Derives a public CryptoKey from a private CryptoKey. The resulting key uses\x0d\n * the private key's algorithm\x2C is extractable\x2C and validates the requested\x0d\n * public usages through the shared asymmetric import path.\x0d\n * @param {CryptoKey} key\x0d\n * @param {string[]} keyUsages\x0d\n * @returns {CryptoKey}\x0d\n */\x0d\nfunction toPublicCryptoKey(key\x2C keyUsages) {\x0d\n  const handle = new KeyObjectHandle();\x0d\n  handle.init(kKeyTypePublic\x2C getCryptoKeyHandle(key)\x2C\x0d\n              null\x2C null\x2C null\x2C null);\x0d\n  return toCryptoKey(\x0d\n    handle\x2C\x0d\n    getCryptoKeyAlgorithm(key)\x2C\x0d\n    true\x2C\x0d\n    keyUsages);\x0d\n}\x0d\n\x0d\nfunction createPrivateKey(key) {\x0d\n  const { format\x2C type\x2C data\x2C passphrase\x2C namedCurve } =\x0d\n    prepareAsymmetricKey(key\x2C kCreatePrivate);\x0d\n  const handle = new KeyObjectHandle();\x0d\n  handle.init(kKeyTypePrivate\x2C data\x2C format ?? null\x2C\x0d\n              type ?? null\x2C passphrase ?? null\x2C namedCurve ?? null);\x0d\n  return new PrivateKeyObject(handle);\x0d\n}\x0d\n\x0d\nfunction keyObjectTypeToString(type) {\x0d\n  switch (type) {\x0d\n    case kKeyTypeSecret: return 'secret';\x0d\n    case kKeyTypePublic: return 'public';\x0d\n    case kKeyTypePrivate: return 'private';\x0d\n    default: {\x0d\n      const assert = require('internal/assert');\x0d\n      assert.fail('Unreachable code');\x0d\n    }\x0d\n  }\x0d\n}\x0d\n\x0d\n// The helpers below return a KeyObject's native-backed slot values\x2C\x0d\n// populating the per-instance cache on first access via a single native\x0d\n// call. The public getters delegate to these helpers\x2C and internal\x0d\n// consumers use them directly to avoid user-replaceable public accessors.\x0d\n// Derived metadata such as key size and asymmetric key details is expanded\x0d\n// lazily from the cached KeyObjectHandle. The public asymmetric key details\x0d\n// getter returns a clone so the cached details object stays internal.\x0d\n\x0d\n/**\x0d\n * Returns the KeyObject's native type slot as a string.\x0d\n * @param {KeyObject} key\x0d\n * @returns {'secret' | 'public' | 'private'}\x0d\n */\x0d\nfunction getKeyObjectType(key) {\x0d\n  return keyObjectTypeToString(getKeyObjectSlots(key)[kKeyObjectSlotType]);\x0d\n}\x0d\n\x0d\n/**\x0d\n * Returns the KeyObjectHandle wrapping the KeyObject's underlying key\x0d\n * material.\x0d\n * @param {KeyObject} key\x0d\n * @returns {KeyObjectHandle}\x0d\n */\x0d\nfunction getKeyObjectHandle(key) {\x0d\n  return getKeyObjectSlots(key)[kKeyObjectSlotHandle];\x0d\n}\x0d\n\x0d\n/**\x0d\n * Returns the KeyObject's symmetric key size\x2C bypassing the public\x0d\n * `symmetricKeySize` getter. The value is derived lazily from the cached\x0d\n * KeyObjectHandle.\x0d\n * @param {SecretKeyObject} key\x0d\n * @returns {number}\x0d\n */\x0d\nfunction getKeyObjectSymmetricKeySize(key) {\x0d\n  const slots = getKeyObjectSlots(key);\x0d\n  if (slots[kKeyObjectSlotType] !== kKeyTypeSecret)\x0d\n    throw new ERR_INVALID_THIS('SecretKeyObject');\x0d\n\x0d\n  let cached = slots[kKeyObjectSlotSymmetricKeySize];\x0d\n  if (cached === undefined) {\x0d\n    cached = slots[kKeyObjectSlotHandle].getSymmetricKeySize();\x0d\n    slots[kKeyObjectSlotSymmetricKeySize] = cached;\x0d\n  }\x0d\n  return cached;\x0d\n}\x0d\n\x0d\n/**\x0d\n * Returns the KeyObject's asymmetric key type\x2C bypassing the public\x0d\n * `asymmetricKeyType` getter. The value is derived lazily from the cached\x0d\n * KeyObjectHandle.\x0d\n * @param {PublicKeyObject|PrivateKeyObject} key\x0d\n * @returns {string}\x0d\n */\x0d\nfunction getKeyObjectAsymmetricKeyType(key) {\x0d\n  const slots = getKeyObjectSlots(key);\x0d\n  if (slots[kKeyObjectSlotType] === kKeyTypeSecret)\x0d\n    throw new ERR_INVALID_THIS('AsymmetricKeyObject');\x0d\n\x0d\n  let cached = slots[kKeyObjectSlotAsymmetricKeyType];\x0d\n  if (cached === undefined) {\x0d\n    cached = slots[kKeyObjectSlotHandle].getAsymmetricKeyType();\x0d\n    slots[kKeyObjectSlotAsymmetricKeyType] = cached;\x0d\n  }\x0d\n  return cached;\x0d\n}\x0d\n\x0d\n/**\x0d\n * Returns the KeyObject's cached asymmetric key details\x2C bypassing the\x0d\n * public `asymmetricKeyDetails` getter (which returns a cloned copy).\x0d\n * The value is derived lazily from the cached KeyObjectHandle.\x0d\n * @param {PublicKeyObject|PrivateKeyObject} key\x0d\n * @returns {object}\x0d\n */\x0d\nfunction getKeyObjectAsymmetricKeyDetails(key) {\x0d\n  const slots = getKeyObjectSlots(key);\x0d\n  if (slots[kKeyObjectSlotType] === kKeyTypeSecret)\x0d\n    throw new ERR_INVALID_THIS('AsymmetricKeyObject');\x0d\n\x0d\n  let cached = slots[kKeyObjectSlotAsymmetricKeyDetails];\x0d\n  if (cached === undefined) {\x0d\n    let asymmetricKeyType = slots[kKeyObjectSlotAsymmetricKeyType];\x0d\n    if (asymmetricKeyType === undefined) {\x0d\n      asymmetricKeyType = slots[kKeyObjectSlotHandle].getAsymmetricKeyType();\x0d\n      slots[kKeyObjectSlotAsymmetricKeyType] = asymmetricKeyType;\x0d\n    }\x0d\n    switch (asymmetricKeyType) {\x0d\n      case 'rsa':\x0d\n      case 'rsa-pss':\x0d\n      case 'dsa':\x0d\n      case 'ec':\x0d\n        cached = normalizeKeyDetails(\x0d\n          slots[kKeyObjectSlotHandle].keyDetail({ __proto__: null })\x2C\x0d\n        );\x0d\n        break;\x0d\n      default:\x0d\n        cached = kEmptyObject;\x0d\n        break;\x0d\n    }\x0d\n    slots[kKeyObjectSlotAsymmetricKeyDetails] = cached;\x0d\n  }\x0d\n  return cached;\x0d\n}\x0d\n\x0d\nfunction isKeyObject(obj) {\x0d\n  if (obj == null || typeof obj !== 'object')\x0d\n    return false;\x0d\n\x0d\n  try {\x0d\n    getKeyObjectSlots(obj);\x0d\n    return true;\x0d\n  } catch {\x0d\n    return false;\x0d\n  }\x0d\n}\x0d\n\x0d\n// CryptoKey is a plain JS class whose prototype's [[Prototype]] is\x0d\n// Object.prototype\x2C as Web Crypto requires. Instance storage (type enum\x2C\x0d\n// extractable\x2C algorithm\x2C usages mask\x2C and the KeyObject handle) lives\x0d\n// on a C++ class\x2C NativeCryptoKey\x2C created by createCryptoKeyClass.\x0d\n// InternalCryptoKey is the only constructor we expose to internal\x0d\n// code; it extends NativeCryptoKey to get that storage and then has\x0d\n// its prototype spliced so the chain visible to user code is:\x0d\n//   instance -> InternalCryptoKey.prototype\x0d\n//            -> CryptoKey.prototype\x0d\n//            -> Object.prototype\x0d\n//\x0d\n// All five internal slots are read from C++ in a single call via\x0d\n// `getCryptoKeySlots`. The resulting array is cached in a private\x0d\n// class field on `InternalCryptoKey` so that it is invisible to\x0d\n// reflection (`Object.getOwnPropertySymbols` etc.) and leaves each\x0d\n// CryptoKey's hidden class pristine. The `getCryptoKey{Type\x2C\x0d\n// Extractable\x2CAlgorithm\x2CUsages\x2CHandle}` helpers index into that\x0d\n// array and convert native enums/masks back to Web Crypto strings.\x0d\n// The internal algorithm object is stored as a null-prototype clone\x0d\n// so it cannot observe polluted Object.prototype properties.\x0d\n// The public `algorithm` getter caches a cloned dictionary and the\x0d\n// public `usages` getter caches a synthesized array (as Web Crypto\x0d\n// requires repeat reads to return the same object so a consumer's\x0d\n// mutation is visible next time).\x0d\nlet getSlots; // Populated by the createCryptoKeyClass callback below.\x0d\n\x0d\nconst kSlotType = 0;\x0d\nconst kSlotExtractable = 1;\x0d\nconst kSlotAlgorithm = 2;\x0d\nconst kSlotUsagesMask = 3;\x0d\nconst kSlotHandle = 4;\x0d\nconst kSlotClonedAlgorithm = 5;\x0d\nconst kSlotClonedUsages = 6;\x0d\nconst kSlotUsages = 7;\x0d\n\x0d\nfunction cloneAlgorithm(raw) {\x0d\n  const cloned = { ...raw };\x0d\n  if (ObjectPrototypeHasOwnProperty(cloned\x2C 'hash') &&\x0d\n      cloned.hash !== undefined) {\x0d\n    cloned.hash = { ...cloned.hash };\x0d\n  }\x0d\n  if (ObjectPrototypeHasOwnProperty(cloned\x2C 'publicExponent') &&\x0d\n      cloned.publicExponent !== undefined) {\x0d\n    cloned.publicExponent = new Uint8Array(cloned.publicExponent);\x0d\n  }\x0d\n  return cloned;\x0d\n}\x0d\n\x0d\nfunction cloneInternalAlgorithm(raw) {\x0d\n  const cloned = { __proto__: null\x2C ...raw };\x0d\n  if (ObjectPrototypeHasOwnProperty(cloned\x2C 'hash') &&\x0d\n      cloned.hash !== undefined) {\x0d\n    cloned.hash = { __proto__: null\x2C ...cloned.hash };\x0d\n  }\x0d\n  if (ObjectPrototypeHasOwnProperty(cloned\x2C 'publicExponent') &&\x0d\n      cloned.publicExponent !== undefined) {\x0d\n    cloned.publicExponent = new Uint8Array(cloned.publicExponent);\x0d\n  }\x0d\n  return cloned;\x0d\n}\x0d\n\x0d\nconst {\x0d\n  0: CryptoKey\x2C\x0d\n  1: InternalCryptoKey\x2C\x0d\n} = createCryptoKeyClass((NativeCryptoKey) => {\x0d\n  class CryptoKey {\x0d\n    constructor() {\x0d\n      throw new ERR_ILLEGAL_CONSTRUCTOR();\x0d\n    }\x0d\n\x0d\n    [kInspect](depth\x2C options) {\x0d\n      if (depth < 0)\x0d\n        return this;\x0d\n\x0d\n      const opts = {\x0d\n        ...options\x2C\x0d\n        depth: options.depth == null ? null : options.depth - 1\x2C\x0d\n      };\x0d\n\x0d\n      return `CryptoKey ${inspect({\x0d\n        type: getCryptoKeyType(this)\x2C\x0d\n        extractable: getCryptoKeyExtractable(this)\x2C\x0d\n        algorithm: cloneAlgorithm(getCryptoKeyAlgorithm(this))\x2C\x0d\n        usages: ArrayPrototypeSlice(getCryptoKeyUsages(this)\x2C 0)\x2C\x0d\n      }\x2C opts)}`;\x0d\n    }\x0d\n\x0d\n    get type() {\x0d\n      return getCryptoKeyType(this);\x0d\n    }\x0d\n\x0d\n    get extractable() {\x0d\n      return getCryptoKeyExtractable(this);\x0d\n    }\x0d\n\x0d\n    get algorithm() {\x0d\n      const slots = getSlots(this);\x0d\n      let cached = slots[kSlotClonedAlgorithm];\x0d\n      if (cached === undefined) {\x0d\n        cached = cloneAlgorithm(slots[kSlotAlgorithm]);\x0d\n        slots[kSlotClonedAlgorithm] = cached;\x0d\n      }\x0d\n      return cached;\x0d\n    }\x0d\n\x0d\n    get usages() {\x0d\n      const slots = getSlots(this);\x0d\n      let cached = slots[kSlotClonedUsages];\x0d\n      if (cached === undefined) {\x0d\n        cached = ArrayPrototypeSlice(getCryptoKeyUsagesFromSlots(slots)\x2C 0);\x0d\n        slots[kSlotClonedUsages] = cached;\x0d\n      }\x0d\n      return cached;\x0d\n    }\x0d\n  }\x0d\n\x0d\n  class InternalCryptoKey extends NativeCryptoKey {\x0d\n    #slots;\x0d\n\x0d\n    constructor(handle\x2C algorithm\x2C usagesMask\x2C extractable) {\x0d\n      if (algorithm !== undefined)\x0d\n        algorithm = cloneInternalAlgorithm(algorithm);\x0d\n      super(handle\x2C algorithm\x2C usagesMask\x2C extractable);\x0d\n    }\x0d\n\x0d\n    static {\x0d\n      getSlots = (key) => {\x0d\n        if (!key || typeof key !== 'object')\x0d\n          throw new ERR_INVALID_THIS('CryptoKey');\x0d\n        if (#slots in key) {\x0d\n          const cached = key.#slots;\x0d\n          if (cached !== undefined) return cached;\x0d\n        }\x0d\n        const slots = nativeGetCryptoKeySlots(key);\x0d\n        slots[kSlotAlgorithm] = cloneInternalAlgorithm(slots[kSlotAlgorithm]);\x0d\n        key.#slots = slots;\x0d\n        return slots;\x0d\n      };\x0d\n    }\x0d\n  }\x0d\n  // Hide NativeCryptoKey from user code.\x0d\n  InternalCryptoKey.prototype.constructor = CryptoKey;\x0d\n  ObjectSetPrototypeOf(InternalCryptoKey.prototype\x2C CryptoKey.prototype);\x0d\n\x0d\n  ObjectDefineProperties(CryptoKey.prototype\x2C {\x0d\n    type: kEnumerableProperty\x2C\x0d\n    extractable: kEnumerableProperty\x2C\x0d\n    algorithm: kEnumerableProperty\x2C\x0d\n    usages: kEnumerableProperty\x2C\x0d\n    [SymbolToStringTag]: {\x0d\n      __proto__: null\x2C\x0d\n      configurable: true\x2C\x0d\n      value: 'CryptoKey'\x2C\x0d\n    }\x2C\x0d\n  });\x0d\n\x0d\n  return [CryptoKey\x2C InternalCryptoKey];\x0d\n});\x0d\n\x0d\n// The helpers below return a CryptoKey's internal slot value\x2C\x0d\n// populating the per-instance cache on first access via a single\x0d\n// native call. The public `type` getter converts the native enum to\x0d\n// the Web Crypto string. The `usages` helper converts the native usage\x0d\n// mask to Web Crypto strings. The public `algorithm` / `usages` getters\x0d\n// on `CryptoKey.prototype` cache their returned objects.\x0d\n\x0d\n/**\x0d\n * Returns the value of a CryptoKey's `[[type]]` internal slot.\x0d\n * @param {CryptoKey} key\x0d\n * @returns {'secret' | 'public' | 'private'}\x0d\n */\x0d\nfunction getCryptoKeyType(key) {\x0d\n  switch (getSlots(key)[kSlotType]) {\x0d\n    case kKeyTypeSecret: return 'secret';\x0d\n    case kKeyTypePublic: return 'public';\x0d\n    case kKeyTypePrivate: return 'private';\x0d\n    default: {\x0d\n      const assert = require('internal/assert');\x0d\n      assert.fail('Unreachable code');\x0d\n    }\x0d\n  }\x0d\n}\x0d\n\x0d\n/**\x0d\n * Returns the value of a CryptoKey's `[[extractable]]` internal slot.\x0d\n * @param {CryptoKey} key\x0d\n * @returns {boolean}\x0d\n */\x0d\nfunction getCryptoKeyExtractable(key) {\x0d\n  return getSlots(key)[kSlotExtractable];\x0d\n}\x0d\n\x0d\n/**\x0d\n * Returns the CryptoKey's `[[algorithm]]` internal slot\x2C bypassing the\x0d\n * public `algorithm` getter (which returns a cloned copy).\x0d\n * @param {CryptoKey} key\x0d\n * @returns {object}\x0d\n */\x0d\nfunction getCryptoKeyAlgorithm(key) {\x0d\n  return getSlots(key)[kSlotAlgorithm];\x0d\n}\x0d\n\x0d\n/**\x0d\n * Returns the CryptoKey's native `[[usages]]` mask.\x0d\n * @param {CryptoKey} key\x0d\n * @returns {number}\x0d\n */\x0d\nfunction getCryptoKeyUsagesMask(key) {\x0d\n  return getSlots(key)[kSlotUsagesMask];\x0d\n}\x0d\n\x0d\n/**\x0d\n * Returns whether a CryptoKey's `[[usages]]` contains `usage`.\x0d\n * @param {CryptoKey} key\x0d\n * @param {string} usage\x0d\n * @returns {boolean}\x0d\n */\x0d\nfunction hasCryptoKeyUsage(key\x2C usage) {\x0d\n  return hasUsage(getCryptoKeyUsagesMask(key)\x2C usage);\x0d\n}\x0d\n\x0d\n/**\x0d\n * Returns the CryptoKey's cached canonical usages array for internal\x0d\n * consumers\x2C expanding it from the native usage mask on first access.\x0d\n * @param {Array} slots\x0d\n * @returns {string[]}\x0d\n */\x0d\nfunction getCryptoKeyUsagesFromSlots(slots) {\x0d\n  let usages = slots[kSlotUsages];\x0d\n  if (usages === undefined) {\x0d\n    usages = getUsagesFromMask(slots[kSlotUsagesMask]);\x0d\n    slots[kSlotUsages] = usages;\x0d\n  }\x0d\n  return usages;\x0d\n}\x0d\n\x0d\n/**\x0d\n * Returns the CryptoKey's `[[usages]]` internal slot\x2C bypassing the\x0d\n * public `usages` getter (which returns a cloned array). The internal\x0d\n * array is expanded lazily from the native usage mask.\x0d\n * @param {CryptoKey} key\x0d\n * @returns {string[]}\x0d\n */\x0d\nfunction getCryptoKeyUsages(key) {\x0d\n  return getCryptoKeyUsagesFromSlots(getSlots(key));\x0d\n}\x0d\n\x0d\n/**\x0d\n * Returns the KeyObjectHandle wrapping the CryptoKey's underlying\x0d\n * key material.\x0d\n * @param {CryptoKey} key\x0d\n * @returns {KeyObjectHandle}\x0d\n */\x0d\nfunction getCryptoKeyHandle(key) {\x0d\n  return getSlots(key)[kSlotHandle];\x0d\n}\x0d\n\x0d\nfunction isCryptoKey(obj) {\x0d\n  if (obj == null || typeof obj !== 'object')\x0d\n    return false;\x0d\n\x0d\n  try {\x0d\n    getSlots(obj);\x0d\n    return true;\x0d\n  } catch {\x0d\n    return false;\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction importGenericSecretKey(\x0d\n  algorithm\x2C\x0d\n  format\x2C\x0d\n  keyData\x2C\x0d\n  extractable\x2C\x0d\n  keyUsages\x2C\x0d\n) {\x0d\n  const usagesSet = new SafeSet(keyUsages);\x0d\n  const { name } = algorithm;\x0d\n  if (extractable)\x0d\n    throw lazyDOMException(`${name} keys are not extractable`\x2C 'SyntaxError');\x0d\n\x0d\n  if (hasAnyNotIn(usagesSet\x2C ['deriveKey'\x2C 'deriveBits'])) {\x0d\n    throw lazyDOMException(\x0d\n      `Unsupported key usage for a ${name} key`\x2C\x0d\n      'SyntaxError');\x0d\n  }\x0d\n\x0d\n  let handle;\x0d\n  switch (format) {\x0d\n    case 'KeyObjectHandle': {\x0d\n      handle = keyData;\x0d\n      break;\x0d\n    }\x0d\n    case 'raw-secret':\x0d\n    case 'raw': {\x0d\n      handle = new KeyObjectHandle();\x0d\n      handle.init(kKeyTypeSecret\x2C keyData);\x0d\n      break;\x0d\n    }\x0d\n    default:\x0d\n      return undefined;\x0d\n  }\x0d\n\x0d\n  return new InternalCryptoKey(\x0d\n    handle\x2C\x0d\n    { name }\x2C\x0d\n    getUsagesMask(usagesSet)\x2C\x0d\n    false);\x0d\n}\x0d\n\x0d\nmodule.exports = {\x0d\n  // Public API.\x0d\n  createSecretKey\x2C\x0d\n  createPublicKey\x2C\x0d\n  createPrivateKey\x2C\x0d\n  KeyObject\x2C\x0d\n  CryptoKey\x2C\x0d\n  InternalCryptoKey\x2C\x0d\n\x0d\n  // These are designed for internal use only and should not be exposed.\x0d\n  parsePublicKeyEncoding\x2C\x0d\n  parsePrivateKeyEncoding\x2C\x0d\n  parseKeyEncoding\x2C\x0d\n  toPublicCryptoKey\x2C\x0d\n  preparePrivateKey\x2C\x0d\n  preparePublicOrPrivateKey\x2C\x0d\n  prepareSecretKey\x2C\x0d\n  SecretKeyObject\x2C\x0d\n  PublicKeyObject\x2C\x0d\n  PrivateKeyObject\x2C\x0d\n  isKeyObject\x2C\x0d\n  getKeyObjectType\x2C\x0d\n  getKeyObjectHandle\x2C\x0d\n  getKeyObjectSymmetricKeySize\x2C\x0d\n  getKeyObjectAsymmetricKeyType\x2C\x0d\n  getKeyObjectAsymmetricKeyDetails\x2C\x0d\n  isCryptoKey\x2C\x0d\n  getCryptoKeyType\x2C\x0d\n  getCryptoKeyExtractable\x2C\x0d\n  getCryptoKeyAlgorithm\x2C\x0d\n  getCryptoKeyUsages\x2C\x0d\n  getCryptoKeyUsagesMask\x2C\x0d\n  hasCryptoKeyUsage\x2C\x0d\n  getCryptoKeyHandle\x2C\x0d\n  importGenericSecretKey\x2C\x0d\n};\x0d\n
