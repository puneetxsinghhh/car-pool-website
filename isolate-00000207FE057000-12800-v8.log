script-source,76,node:internal/modules/esm/translators,'use strict';\x0d\n\x0d\nconst {\x0d\n  ArrayPrototypePush\x2C\x0d\n  FunctionPrototypeCall\x2C\x0d\n  JSONParse\x2C\x0d\n  ObjectAssign\x2C\x0d\n  ObjectPrototypeHasOwnProperty\x2C\x0d\n  ReflectApply\x2C\x0d\n  SafeMap\x2C\x0d\n  SafeSet\x2C\x0d\n  SafeWeakMap\x2C\x0d\n  StringPrototypeIncludes\x2C\x0d\n  StringPrototypeReplaceAll\x2C\x0d\n  StringPrototypeSlice\x2C\x0d\n  StringPrototypeStartsWith\x2C\x0d\n  globalThis\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst {\x0d\n  compileFunctionForCJSLoader\x2C\x0d\n} = internalBinding('contextify');\x0d\n\x0d\nconst { BuiltinModule } = require('internal/bootstrap/realm');\x0d\nconst assert = require('internal/assert');\x0d\nconst { dirname\x2C extname } = require('path');\x0d\nconst {\x0d\n  assertBufferSource\x2C\x0d\n  loadBuiltinModule\x2C\x0d\n  stringify\x2C\x0d\n  stripBOM\x2C\x0d\n  urlToFilename\x2C\x0d\n} = require('internal/modules/helpers');\x0d\nconst { stripTypeScriptModuleTypes } = require('internal/modules/typescript');\x0d\nconst {\x0d\n  kIsCachedByESMLoader\x2C\x0d\n  Module: CJSModule\x2C\x0d\n  wrapModuleLoad\x2C\x0d\n  kModuleSource\x2C\x0d\n  kModuleExport\x2C\x0d\n  kModuleExportNames\x2C\x0d\n  findLongestRegisteredExtension\x2C\x0d\n  resolveForCJSWithHooks\x2C\x0d\n  loadSourceForCJSWithHooks\x2C\x0d\n  populateCJSExportsFromESM\x2C\x0d\n} = require('internal/modules/cjs/loader');\x0d\nconst { fileURLToPath\x2C pathToFileURL\x2C URL } = require('internal/url');\x0d\nlet debug = require('internal/util/debuglog').debuglog('esm'\x2C (fn) => {\x0d\n  debug = fn;\x0d\n});\x0d\nconst { emitExperimentalWarning\x2C kEmptyObject\x2C setOwnProperty\x2C isWindows } = require('internal/util');\x0d\nconst {\x0d\n  ERR_INVALID_RETURN_PROPERTY_VALUE\x2C\x0d\n  ERR_UNKNOWN_BUILTIN_MODULE\x2C\x0d\n} = require('internal/errors').codes;\x0d\nconst { maybeCacheSourceMap } = require('internal/source_map/source_map_cache');\x0d\nconst moduleWrap = internalBinding('module_wrap');\x0d\nconst { ModuleWrap\x2C kEvaluationPhase } = moduleWrap;\x0d\n\x0d\nconst { getSourceSync } = require('internal/modules/esm/load');\x0d\n\x0d\nconst { parse: cjsParse } = internalBinding('cjs_lexer');\x0d\n\x0d\nconst translators = new SafeMap();\x0d\nexports.translators = translators;\x0d\n\x0d\n/**\x0d\n * Converts a URL to a file path if the URL protocol is 'file:'.\x0d\n * @param {string} url - The URL to convert.\x0d\n * @returns {string|URL}\x0d\n */\x0d\nfunction errPath(url) {\x0d\n  const parsed = new URL(url);\x0d\n  if (parsed.protocol === 'file:') {\x0d\n    return fileURLToPath(parsed);\x0d\n  }\x0d\n  return url;\x0d\n}\x0d\n\x0d\n// Strategy for loading a standard JavaScript module.\x0d\ntranslators.set('module'\x2C function moduleStrategy(url\x2C translateContext\x2C parentURL) {\x0d\n  let { source } = translateContext;\x0d\n  const isMain = (parentURL === undefined);\x0d\n  assertBufferSource(source\x2C true\x2C 'load');\x0d\n  source = stringify(source);\x0d\n  debug(`Translating StandardModule ${url}`\x2C translateContext);\x0d\n  const { compileSourceTextModule } = require('internal/modules/esm/utils');\x0d\n  const context = isMain ? { isMain } : undefined;\x0d\n  const module = compileSourceTextModule(url\x2C source\x2C this\x2C context);\x0d\n  return module;\x0d\n});\x0d\n\x0d\nconst { requestTypes: { kRequireInImportedCJS } } = require('internal/modules/esm/utils');\x0d\nconst kShouldSkipModuleHooks = { __proto__: null\x2C shouldSkipModuleHooks: true };\x0d\nconst kShouldNotSkipModuleHooks = { __proto__: null\x2C shouldSkipModuleHooks: false };\x0d\n\x0d\n/**\x0d\n * This may be eventually removed when module.register() reaches end-of-life.\x0d\n *\x0d\n * Loads a CommonJS module via the ESM Loader sync CommonJS translator.\x0d\n * This translator creates its own version of the `require` function passed into CommonJS modules.\x0d\n * Any monkey patches applied to the CommonJS Loader will not affect this module.\x0d\n * Any `require` calls in this module will load all children in the same way.\x0d\n * @param {import('internal/modules/cjs/loader').Module} module - The module to load.\x0d\n * @param {string} source - The source code of the module.\x0d\n * @param {string} url - The URL of the module.\x0d\n * @param {string} filename - The filename of the module.\x0d\n * @param {boolean} isMain - Whether the module is the entrypoint\x0d\n * @param {TranslateContext} translateContext Context for the translator\x0d\n */\x0d\nfunction loadCJSModuleWithSpecialRequire(module\x2C source\x2C url\x2C filename\x2C isMain\x2C translateContext) {\x0d\n  // Use the full URL as the V8 resource name so that any search params\x0d\n  // (e.g. ?node-test-mock) are preserved in coverage reports.\x0d\n  const compileResult = compileFunctionForCJSLoader(source\x2C url\x2C false /* is_sea_main */\x2C false);\x0d\n\x0d\n  const { function: compiledWrapper\x2C sourceMapURL\x2C sourceURL } = compileResult;\x0d\n  // Cache the source map for the cjs module if present.\x0d\n  if (sourceMapURL) {\x0d\n    maybeCacheSourceMap(url\x2C source\x2C module\x2C false\x2C sourceURL\x2C sourceMapURL);\x0d\n  }\x0d\n  const cascadedLoader = require('internal/modules/esm/loader').getOrInitializeCascadedLoader();\x0d\n  const __dirname = dirname(filename);\x0d\n  // eslint-disable-next-line func-name-matching\x2Cfunc-style\x0d\n  const requireFn = function require(specifier) {\x0d\n    let importAttributes = kEmptyObject;\x0d\n    if (!StringPrototypeStartsWith(specifier\x2C 'node:') && !BuiltinModule.normalizeRequirableId(specifier)) {\x0d\n      // TODO: do not depend on the monkey-patchable CJS loader here.\x0d\n      const path = CJSModule._resolveFilename(specifier\x2C module);\x0d\n      switch (extname(path)) {\x0d\n        case '.json':\x0d\n          importAttributes = { __proto__: null\x2C type: 'json' };\x0d\n          break;\x0d\n        case '.node':\x0d\n          // If it gets here in the translators\x2C the hooks must have already been invoked\x0d\n          // in the loader. Skip them in the synthetic module evaluation step.\x0d\n          return wrapModuleLoad(specifier\x2C module\x2C false\x2C kShouldSkipModuleHooks);\x0d\n        default:\x0d\n            // fall through\x0d\n      }\x0d\n      specifier = `${pathToFileURL(path)}`;\x0d\n    }\x0d\n\x0d\n    // NOTE: This re-invented require() is only used on the loader-hook worker thread.\x0d\n    // On the main thread\x2C the authentic require() is used instead (fixed by #60380).\x0d\n    const request = { specifier\x2C attributes: importAttributes\x2C phase: kEvaluationPhase\x2C __proto__: null };\x0d\n    const job = cascadedLoader.getOrCreateModuleJob(url\x2C request\x2C kRequireInImportedCJS);\x0d\n    job.runSync();\x0d\n    let mod = cjsCache.get(job.url);\x0d\n    assert(job.module\x2C `Imported CJS module ${url} failed to load module ${job.url} using require() due to race condition`);\x0d\n\x0d\n    if (job.module.synthetic) {\x0d\n      assert(mod\x2C `Imported CJS module ${url} failed to load module ${job.url} using require() due to missed cache`);\x0d\n      return mod.exports;\x0d\n    }\x0d\n\x0d\n    // The module being required is a source text module.\x0d\n    if (!mod) {\x0d\n      mod = cjsEmplaceModuleCacheEntry(job.url);\x0d\n      cjsCache.set(job.url\x2C mod);\x0d\n    }\x0d\n    // The module has been cached by the re-invented require. Update the exports object\x0d\n    // from the namespace object and return the evaluated exports.\x0d\n    if (!mod.loaded) {\x0d\n      debug('populateCJSExportsFromESM from require(esm) in imported CJS'\x2C url\x2C mod\x2C job.module);\x0d\n      populateCJSExportsFromESM(mod\x2C job.module\x2C job.module.getNamespace());\x0d\n      mod.loaded = true;\x0d\n    }\x0d\n    return mod.exports;\x0d\n  };\x0d\n  setOwnProperty(requireFn\x2C 'resolve'\x2C function resolve(specifier) {\x0d\n    if (!StringPrototypeStartsWith(specifier\x2C 'node:')) {\x0d\n      cons