script-source,109,file:///C:/Users/Basant/Desktop/NodeJS/Car-Pool-Website/src/application/useCases/CreateRide.js,import Ride from "../../domain/entities/Ride.js";\x0d\n\x0d\nexport default class CreateRide {\x0d\n    constructor(rideRepository\x2C userRepository) {\x0d\n        this.rideRepository = rideRepository;\x0d\n        this.userRepository = userRepository;\x0d\n    }\x0d\n\x0d\n    async execute({\x0d\n        driverId\x2C\x0d\n        origin\x2C\x0d\n        destination\x2C\x0d\n        totalSeats\x0d\n    }) {\x0d\n\x0d\n        const driver = await this.userRepository.findById(driverId);\x0d\n\x0d\n        if (!driver) {\x0d\n            throw new Error("Driver not found");\x0d\n        }\x0d\n\x0d\n        if (driver.role !== "DRIVER") {\x0d\n            throw new Error("User is not registered as a driver");\x0d\n        }\x0d\n\x0d\n        const ride = new Ride({\x0d\n            driverId\x2C\x0d\n            origin\x2C\x0d\n            destination\x2C\x0d\n            totalSeats\x2C\x0d\n            availableSeats: totalSeats\x0d\n        });\x0d\n\x0d\n        return await this.rideRepository.create(ride);\x0d\n    }\x0d\n}
