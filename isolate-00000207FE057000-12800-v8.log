script-source,99,file:///C:/Users/Basant/Desktop/NodeJS/Car-Pool-Website/src/adapters/outbound/persistence/PostgreSQLRideRepository.js,import RideRepository from "../../../application/ports/RideRepository.js";\x0d\nimport Ride from "../../../domain/entities/Ride.js";\x0d\n\x0d\nexport default class PostgreSQLRideRepository extends RideRepository {\x0d\n\x0d\n    constructor(pool) {\x0d\n        super();\x0d\n        this.pool = pool;\x0d\n    }\x0d\n\x0d\n    async create(ride) {\x0d\n\x0d\n        const query = `\x0d\n            INSERT INTO rides (\x0d\n                driver_id\x2C\x0d\n                origin\x2C\x0d\n                destination\x2C\x0d\n                total_seats\x2C\x0d\n                available_seats\x0d\n            )\x0d\n            VALUES ($1\x2C $2\x2C $3\x2C $4\x2C $5)\x0d\n            RETURNING\x0d\n                id\x2C\x0d\n                driver_id\x2C\x0d\n                origin\x2C\x0d\n                destination\x2C\x0d\n                total_seats\x2C\x0d\n                available_seats\x0d\n        `;\x0d\n\x0d\n        const values = [\x0d\n            ride.driverId\x2C\x0d\n            ride.origin\x2C\x0d\n            ride.destination\x2C\x0d\n            ride.totalSeats\x2C\x0d\n            ride.availableSeats\x0d\n        ];\x0d\n\x0d\n        const result = await this.pool.query(query\x2C values);\x0d\n\x0d\n        return new Ride({\x0d\n            id: result.rows[0].id\x2C\x0d\n            driverId: result.rows[0].driver_id\x2C\x0d\n            origin: result.rows[0].origin\x2C\x0d\n            destination: result.rows[0].destination\x2C\x0d\n            totalSeats: result.rows[0].total_seats\x2C\x0d\n            availableSeats: result.rows[0].available_seats\x0d\n        });\x0d\n    }\x0d\n\x0d\n    async findAll() {\x0d\n\x0d\n        const query = `\x0d\n            SELECT\x0d\n                id\x2C\x0d\n                driver_id\x2C\x0d\n                origin\x2C\x0d\n                destination\x2C\x0d\n                total_seats\x2C\x0d\n                available_seats\x0d\n            FROM rides\x0d\n            WHERE available_seats > 0\x0d\n            ORDER BY id\x0d\n        `;\x0d\n\x0d\n        const result = await this.pool.query(query);\x0d\n\x0d\n        return result.rows.map(row => new Ride({\x0d\n            id: row.id\x2C\x0d\n            driverId: row.driver_id\x2C\x0d\n            origin: row.origin\x2C\x0d\n            destination: row.destination\x2C\x0d\n            totalSeats: row.total_seats\x2C\x0d\n            availableSeats: row.available_seats\x0d\n        }));\x0d\n    }\x0d\n\x0d\n    async findById(id) {\x0d\n\x0d\n        const query = `\x0d\n            SELECT\x0d\n                id\x2C\x0d\n                driver_id\x2C\x0d\n                origin\x2C\x0d\n                destination\x2C\x0d\n                total_seats\x2C\x0d\n                available_seats\x0d\n            FROM rides\x0d\n            WHERE id = $1\x0d\n        `;\x0d\n\x0d\n        const result = await this.pool.query(query\x2C [id]);\x0d\n\x0d\n        if (result.rows.length === 0) {\x0d\n            return null;\x0d\n        }\x0d\n\x0d\n        const row = result.rows[0];\x0d\n\x0d\n        return new Ride({\x0d\n            id: row.id\x2C\x0d\n            driverId: row.driver_id\x2C\x0d\n            origin: row.origin\x2C\x0d\n            destination: row.destination\x2C\x0d\n            totalSeats: row.total_seats\x2C\x0d\n            availableSeats: row.available_seats\x0d\n        });\x0d\n    }\x0d\n\x0d\n    async update(ride) {\x0d\n\x0d\n        const query = `\x0d\n            UPDATE rides\x0d\n            SET available_seats = $1\x0d\n            WHERE id = $2\x0d\n            RETURNING\x0d\n                id\x2C\x0d\n                driver_id\x2C\x0d\n                origin\x2C\x0d\n                destination\x2C\x0d\n                total_seats\x2C\x0d\n                available_seats\x0d\n        `;\x0d\n\x0d\n        const values = [\x0d\n            ride.availableSeats\x2C\x0d\n            ride.id\x0d\n        ];\x0d\n\x0d\n        const result = await this.pool.query(query\x2C values);\x0d\n\x0d\n        if (result.rows.length === 0) {\x0d\n            return null;\x0d\n        }\x0d\n\x0d\n        const row = result.rows[0];\x0d\n\x0d\n        return new Ride({\x0d\n            id: row.id\x2C\x0d\n            driverId: row.driver_id\x2C\x0d\n            origin: row.origin\x2C\x0d\n            destination: row.destination\x2C\x0d\n            totalSeats: row.total_seats\x2C\x0d\n            availableSeats: row.available_seats\x0d\n        });\x0d\n    }\x0d\n\x0d\n    async findRideDetailsById(id) {\x0d\n        const query = `\x0d\n                SELECT \x0d\n                        r.id AS ride_id\x2C \x0d\n                        r.origin\x2C \x0d\n                        r.destination\x2C\x0d\n                        r.total_seats\x2C\x0d\n                        r.available_seats\x2C\x0d\n\x0d\n                        d.id AS driver_id\x2C\x0d\n                        d.name AS driver_name\x2C\x0d\n                        d.email AS driver_email\x2C\x0d\n\x0d\n                        p.id AS passenger_id\x2C\x0d\n                        p.name AS passenger_name\x2C\x0d\n                        p.email AS passenger_email\x0d\n\x0d\n                    FROM rides r\x0d\n\x0d\n                    INNER JOIN users d\x0d\n                        ON r.driver_id = d.id\x0d\n\x0d\n                    LEFT JOIN bookings b\x0d\n                        ON r.id = b.ride_id\x0d\n\x0d\n                    LEFT JOIN users p\x0d\n                        ON b.passenger_id = p.id\x0d\n\x0d\n                    WHERE r.id = $1\x0d\n\x0d\n                    ORDER BY p.id;\x0d\n                    `;\x0d\n\x0d\n                const result = await this.pool.query(query\x2C [id]);\x0d\n\x0d\n                return result.rows;\x0d\n    }\x0d\n\x0d\n\x0d\n    // transactional ride confirmation \x0d\n    async joinRide(rideId\x2C passengerId) {\x0d\n\x0d\n    const client = await this.pool.connect();\x0d\n\x0d\n    try {\x0d\n\x0d\n        // Start transaction\x0d\n        await client.query("BEGIN");\x0d\n\x0d\n        // -----------------------------------------\x0d\n        // 1. Check ride and available seats\x0d\n        // -----------------------------------------\x0d\n\x0d\n        const rideQuery = `\x0d\n            SELECT\x0d\n                id\x2C\x0d\n                available_seats\x0d\n            FROM rides\x0d\n            WHERE id = $1\x0d\n            FOR UPDATE\x0d\n        `;\x0d\n\x0d\n        const rideResult = await client.query(\x0d\n            rideQuery\x2C\x0d\n            [rideId]\x0d\n        );\x0d\n\x0d\n        if (rideResult.rows.length === 0) {\x0d\n            throw new Error("Ride not found");\x0d\n        }\x0d\n\x0d\n        const ride = rideResult.rows[0];\x0d\n\x0d\n        if (ride.available_seats <= 0) {\x0d\n            throw new Error("No available seats");\x0d\n        }\x0d\n\x0d\n\x0d\n        // -----------------------------------------\x0d\n        // 2. Check duplicate booking\x0d\n        // -----------------------------------------\x0d\n\x0d\n        const bookingCheckQuery = `\x0d\n            SELECT id\x0d\n            FROM bookings\x0d\n            WHERE ride_id = $1\x0d\n              AND passenger_id = $2\x0d\n        `;\x0d\n\x0d\n        const bookingResult = await client.query(\x0d\n            bookingCheckQuery\x2C\x0d\n            [rideId\x2C passengerId]\x0d\n        );\x0d\n\x0d\n        if (bookingResult.rows.length > 0) {\x0d\n            throw new Error(\x0d\n                "Passenger already joined this ride"\x0d\n            );\x0d\n        }\x0d\n\x0d\n\x0d\n        // -----------------------------------------\x0d\n        // 3. Create booking\x0d\n        // -----------------------------------------\x0d\n\x0d\n        const createBookingQuery = `\x0d\n            INSERT INTO bookings (\x0d\n                ride_id\x2C\x0d\n                passenger_id\x0d\n            )\x0d\n            VALUES ($1\x2C $2)\x0d\n            RETURNING\x0d\n                id\x2C\x0d\n                ride_id\x2C\x0d\n                passenger_id\x0d\n        `;\x0d\n\x0d\n        const newBooking =\x0d\n            await client.query(\x0d\n                createBookingQuery\x2C\x0d\n                [rideId\x2C passengerId]\x0d\n            );\x0d\n\x0d\n        // -----------------------------------------\x0d\n        // 4. Decrease available seats\x0d\n        // -----------------------------------------\x0d\n\x0d\n        const updateRideQuery = `\x0d\n            UPDATE rides\x0d\n            SET available_seats = available_seats - 1\x0d\n            WHERE id = $1\x0d\n        `;\x0d\n\x0d\n        await client.query(\x0d\n            updateRideQuery\x2C\x0d\n            [rideId]\x0d\n        );\x0d\n\x0d\n\x0d\n        // -----------------------------------------\x0d\n        // 5. Commit transaction\x0d\n        // -----------------------------------------\x0d\n\x0d\n        await client.query("COMMIT");\x0d\n\x0d\n        return newBooking.rows[0];\x0d\n\x0d\n    } catch (error) {\x0d\n\x0d\n        // -----------------------------------------\x0d\n        // Rollback if anything fails\x0d\n        // -----------------------------------------\x0d\n\x0d\n        await client.query("ROLLBACK");\x0d\n\x0d\n        throw error;\x0d\n\x0d\n    } finally {\x0d\n\x0d\n        // Release database connection\x0d\n        client.release();\x0d\n    }\x0d\n}\x0d\n\x0d\n}
