script-source,117,file:///C:/Users/Basant/Desktop/NodeJS/Car-Pool-Website/src/adapters/inbound/http/controllers/RideController.js,export default class RideController {\x0d\n\x0d\n    constructor(\x0d\n        createRide\x2C\x0d\n        getRides\x2C\x0d\n        getRideById\x2C\x0d\n        joinRide\x2C \x0d\n        getRideDetails\x0d\n    ) {\x0d\n        this.createRide = createRide;\x0d\n        this.getRides = getRides;\x0d\n        this.getRideById = getRideById;\x0d\n        this.joinRide = joinRide;\x0d\n        this.getRideDetailsUseCase = getRideDetails;\x0d\n    }\x0d\n\x0d\n    async create(req\x2C res\x2C next) {\x0d\n        try {\x0d\n            const ride = await this.createRide.execute(req.body);\x0d\n\x0d\n            res.status(201).json(ride);\x0d\n        } catch (error) {\x0d\n            next(error);\x0d\n        }\x0d\n    } \x0d\n\x0d\n    async getAll(req\x2C res\x2C next) {\x0d\n        try {\x0d\n            debugger;\x0d\n            const rides = await this.getRides.execute();\x0d\n\x0d\n            res.status(200).json(rides);\x0d\n        } catch (error) {\x0d\n            next(error);\x0d\n        }\x0d\n    }\x0d\n\x0d\n    async getById(req\x2C res\x2C next) {\x0d\n        try {\x0d\n            const ride = await this.getRideById.execute(\x0d\n                Number(req.params.id)\x0d\n            );\x0d\n\x0d\n            res.status(200).json(ride);\x0d\n        } catch (error) {\x0d\n            next(error);\x0d\n        }\x0d\n    }\x0d\n\x0d\n    async getRideDetails(req\x2C res\x2C next) {\x0d\n        try {\x0d\n            const rideId = Number(req.params.id);\x0d\n\x0d\n            const result = await this.getRideDetailsUseCase.execute(rideId);\x0d\n\x0d\n            res.status(200).json(result);\x0d\n        } catch (error) {\x0d\n            next(error);\x0d\n        }\x0d\n    }     \x0d\n\x0d\n    async join(req\x2C res\x2C next) {\x0d\n        try {\x0d\n            const booking = await this.joinRide.execute(\x0d\n                Number(req.params.id)\x2C\x0d\n                req.body.passengerId\x0d\n            );\x0d\n\x0d\n            res.status(201).json(booking);\x0d\n        } catch (error) {\x0d\n            next(error);\x0d\n        }\x0d\n    }\x0d\n   \x0d\n}
