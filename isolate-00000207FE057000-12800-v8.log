OUBLE = 0x05; // aka DOUBLE\x2C 8 bytes\nmodule.exports.NULL = 0x06; // NULL (used for prepared statements\x2C I think)\nmodule.exports.TIMESTAMP = 0x07; // aka TIMESTAMP\nmodule.exports.LONGLONG = 0x08; // aka BIGINT\x2C 8 bytes\nmodule.exports.INT24 = 0x09; // aka MEDIUMINT\x2C 3 bytes\nmodule.exports.DATE = 0x0a; // aka DATE\nmodule.exports.TIME = 0x0b; // aka TIME\nmodule.exports.DATETIME = 0x0c; // aka DATETIME\nmodule.exports.YEAR = 0x0d; // aka YEAR\x2C 1 byte (don't ask)\nmodule.exports.NEWDATE = 0x0e; // aka ?\nmodule.exports.VARCHAR = 0x0f; // aka VARCHAR (?)\nmodule.exports.BIT = 0x10; // aka BIT\x2C 1-8 byte\nmodule.exports.VECTOR = 0xf2;\nmodule.exports.JSON = 0xf5;\nmodule.exports.NEWDECIMAL = 0xf6; // aka DECIMAL\nmodule.exports.ENUM = 0xf7; // aka ENUM\nmodule.exports.SET = 0xf8; // aka SET\nmodule.exports.TINY_BLOB = 0xf9; // aka TINYBLOB\x2C TINYTEXT\nmodule.exports.MEDIUM_BLOB = 0xfa; // aka MEDIUMBLOB\x2C MEDIUMTEXT\nmodule.exports.LONG_BLOB = 0xfb; // aka LONGBLOG\x2C LONGTEXT\nmodule.exports.BLOB = 0xfc; // aka BLOB\x2C TEXT\nmodule.exports.VAR_STRING = 0xfd; // aka VARCHAR\x2C VARBINARY\nmodule.exports.STRING = 0xfe; // aka CHAR\x2C BINARY\nmodule.exports.GEOMETRY = 0xff; // aka GEOMETRY\n
