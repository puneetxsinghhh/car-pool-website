\n  /**\x0d\n   * @returns {string}\x0d\n   */\x0d\n  get userAgent() {\x0d\n    this.#userAgent ??= `Node.js/${StringPrototypeSlice(nodeVersion\x2C 1\x2C StringPrototypeIndexOf(nodeVersion\x2C '.'))}`;\x0d\n    return this.#userAgent;\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * @returns {string}\x0d\n   */\x0d\n  get platform() {\x0d\n    this.#platform ??= getNavigatorPlatform(arch\x2C platform);\x0d\n    return this.#platform;\x0d\n  }\x0d\n}\x0d\n\x0d\nObjectDefineProperties(Navigator.prototype\x2C {\x0d\n  hardwareConcurrency: kEnumerableProperty\x2C\x0d\n  language: kEnumerableProperty\x2C\x0d\n  languages: kEnumerableProperty\x2C\x0d\n  userAgent: kEnumerableProperty\x2C\x0d\n  platform: kEnumerableProperty\x2C\x0d\n  locks: kEnumerableProperty\x2C\x0d\n});\x0d\n\x0d\nmodule.exports = {\x0d\n  getNavigatorPlatform\x2C\x0d\n  navigator: new Navigator(kInitialize)\x2C\x0d\n  Navigator\x2C\x0d\n};\x0d\n
