script-source,378,C:\\Users\\Basant\\Desktop\\NodeJS\\Car-Pool-Website\\node_modules\\.pnpm\\mysql2@3.24.1_@types+node@26.2.0\\node_modules\\mysql2\\lib\\packets\\query.js,'use strict';\n\nconst Packet = require('../packets/packet.js');\nconst CommandCode = require('../constants/commands.js');\nconst StringParser = require('../parsers/string.js');\nconst CharsetToEncoding = require('../constants/charset_encodings.js');\nconst ClientConstants = require('../constants/client.js');\nconst { toParameter } = require('./encode_parameter.js');\n\nconst { hasFastUtf8Write } = StringParser;\n\nfunction toQueryPacket(buffer\x2C headerLength\x2C length) {\n  buffer[4] = CommandCode.QUERY;\n  if (headerLength === 7) {\n    buffer[5] = 0; // parameter_count\n    buffer[6] = 1; // parameter_set_count\x2C always 1\n  }\n  const packet = new Packet(0\x2C buffer\x2C 0\x2C length);\n  packet.offset = length;\n  return packet;\n}\n\nclass Query {\n  constructor(sql\x2C charsetNumber\x2C attributes\x2C clientFlags) {\n    this.query = sql;\n    this.charsetNumber = charsetNumber;\n    this.encoding = CharsetToEncoding[charsetNumber];\n    this.attributes = attributes;\n    this.clientFlags = clientFlags || 0;\n  }\n\n  toPacket() {\n    const useQueryAttributes =\n      this.clientFlags & ClientConstants.CLIENT_QUERY_ATTRIBUTES;\n    const attributeCount =\n      useQueryAttributes && this.attributes\n        ? Object.keys(this.attributes).length\n        : 0;\n\n    if (attributeCount === 0) {\n      // fast path: no attribute values to serialize\x2C so the packet is the\n      // header plus the encoded SQL\n      const headerLength = useQueryAttributes ? 7 : 5;\n      if (\n        hasFastUtf8Write &&\n        (this.encoding === 'utf8' || this.encoding === 'utf-8')\n      ) {\n        const length = headerLength + Buffer.byteLength(this.query\x2C 'utf8');\n        const buffer = Buffer.allocUnsafe(length);\n        buffer.utf8Write(this.query\x2C headerLength\x2C length - headerLength);\n        return toQueryPacket(buffer\x2C headerLength\x2C length);\n      }\n      if (Buffer.isEncoding(this.encoding)) {\n        const length =\n          headerLength + Buffer.byteLength(this.query\x2C this.encoding);\n        const buffer = Buffer.allocUnsafe(length);\n        buffer.write(this.query\x2C headerLength\x2C this.encoding);\n        return toQueryPacket(buffer\x2C headerLength\x2C length);\n      }\n      const sqlBuffer = StringParser.encode(this.query\x2C this.encoding);\n      const length = headerLength + sqlBuffer.length;\n      const buffer = Buffer.allocUnsafe(length);\n      sqlBuffer.copy(buffer\x2C headerLength);\n      return toQueryPacket(buffer\x2C headerLength\x2C length);\n    }\n\n    const names = Object.keys(this.attributes);\n    const parameters = new Array(attributeCount);\n    const nameBuffers = new Array(attributeCount);\n\n    // packet header\x2C command\x2C parameter count\x2C parameter_set_count (always\n    // the single-byte form)\x2C null bitmap\x2C new_params_bind_flag\x2C type and\n    // unsigned byte per parameter\n    let length =\n      5 +\n      Packet.lengthCodedNumberLength(attributeCount) +\n      1 +\n      ((attributeCount + 7) >> 3) +\n      1 +\n      attributeCount * 2;\n    for (let i = 0; i < attributeCount; i++) {\n      parameters[i] = toParameter(\n        this.attributes[names[i]]\x2C\n        this.encoding\x2C\n        'local'\n      );\n      const name = StringParser.encode(names[i]\x2C this.encoding);\n      nameBuffers[i] = name;\n      length += Packet.lengthCodedNumberLength(name.length) + name.length;\n      if (!parameters[i].isNull) {\n        length += parameters[i].length;\n      }\n    }\n    const sqlBuffer = StringParser.encode(this.query\x2C this.encoding);\n    length += sqlBuffer.length;\n\n    const packet = new Packet(0\x2C Buffer.allocUnsafe(length)\x2C 0\x2C length);\n    packet.offset = 4;\n    packet.writeInt8(CommandCode.QUERY);\n    packet.writeLengthCodedNumber(attributeCount);\n    packet.writeLengthCodedNumber(1); // parameter_set_count\x2C always 1\n\n    let bitmap = 0;\n    let bitValue = 1;\n    for (let i = 0; i < attributeCount; i++) {\n      if (parameters[i].isNull) {\n        bitmap |= bitValue;\n      }\n      bitValue *= 2;\n      if (bitValue === 256) {\n        packet.writeInt8(bitmap);\n        bitmap = 0;\n        bitValue = 1;\n      }\n    }\n    if (bitValue !== 1) {\n      packet.writeInt8(bitmap);\n    }\n\n    packet.writeInt8(1); // new_params_bind_flag\n\n    for (let i = 0; i < attributeCount; i++) {\n      packet.writeInt8(parameters[i].type);\n      packet.writeInt8(parameters[i].unsigned ? 0x80 : 0);\n      packet.writeLengthCodedBuffer(nameBuffers[i]);\n    }\n\n    for (let i = 0; i < attributeCount; i++) {\n      if (!parameters[i].isNull) {\n        parameters[i].writer.call(\n          packet\x2C\n          parameters[i].value\x2C\n          parameters[i].byteLength\n        );\n      }\n    }\n\n    packet.writeBuffer(sqlBuffer);\n\n    if (packet.offset !== length) {\n      throw new Error(\n        `Internal error: COM_QUERY serialized ${packet.offset - 4} bytes\x2C expected ${length - 4}`\n      );\n    }\n    return packet;\n  }\n}\n\nmodule.exports = Query;\n
