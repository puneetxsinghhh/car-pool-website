script-source,119,file:///C:/Users/Basant/Desktop/NodeJS/Car-Pool-Website/src/adapters/inbound/http/validators/userValidator.js,export function validateCreateUser(req\x2C res\x2C next) {\x0d\n\x0d\n    const { name\x2C email\x2C role } = req.body;\x0d\n\x0d\n    if (!name || name.trim() === "") {\x0d\n        return res.status(400).json({\x0d\n            success: false\x2C\x0d\n            message: "Name is required"\x0d\n        });\x0d\n    }\x0d\n\x0d\n    if (!email || email.trim() === "") {\x0d\n        return res.status(400).json({\x0d\n            success: false\x2C\x0d\n            message: "Email is required"\x0d\n        });\x0d\n    }\x0d\n\x0d\n    if (!email.includes("@")) {\x0d\n        return res.status(400).json({\x0d\n            success: false\x2C\x0d\n            message: "Invalid email format"\x0d\n        });\x0d\n    }\x0d\n\x0d\n    if (!role) {\x0d\n        return res.status(400).json({\x0d\n            success: false\x2C\x0d\n            message: "Role is required"\x0d\n        });\x0d\n    }\x0d\n\x0d\n    if (!["DRIVER"\x2C "PASSENGER"].includes(role)) {\x0d\n        return res.status(400).json({\x0d\n            success: false\x2C\x0d\n            message: "Role must be DRIVER or PASSENGER"\x0d\n        });\x0d\n    }\x0d\n\x0d\n    next();\x0d\n}
