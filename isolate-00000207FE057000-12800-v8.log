script-source,326,node:internal/navigator,'use strict';\x0d\n\x0d\nconst {\x0d\n  ObjectDefineProperties\x2C\x0d\n  ObjectFreeze\x2C\x0d\n  StringPrototypeIndexOf\x2C\x0d\n  StringPrototypeSlice\x2C\x0d\n  StringPrototypeToUpperCase\x2C\x0d\n  Symbol\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst {\x0d\n  ERR_ILLEGAL_CONSTRUCTOR\x2C\x0d\n} = require('internal/errors').codes;\x0d\n\x0d\nconst {\x0d\n  kEnumerableProperty\x2C\x0d\n} = require('internal/util');\x0d\n\x0d\nconst {\x0d\n  getAvailableParallelism\x2C\x0d\n} = internalBinding('os');\x0d\n\x0d\nconst kInitialize = Symbol('kInitialize');\x0d\n\x0d\nconst {\x0d\n  platform\x2C\x0d\n  arch\x2C\x0d\n  version: nodeVersion\x2C\x0d\n} = require('internal/process/per_thread');\x0d\n\x0d\nconst {\x0d\n  getDefaultLocale\x2C\x0d\n} = internalBinding('config');\x0d\n\x0d\n/**\x0d\n * @param {string} arch\x0d\n * @param {string} platform\x0d\n * @returns {string}\x0d\n */\x0d\nfunction getNavigatorPlatform(arch\x2C platform) {\x0d\n  if (platform === 'darwin') {\x0d\n    // On macOS\x2C modern browsers return 'MacIntel' even if running on Apple Silicon.\x0d\n    return 'MacIntel';\x0d\n  } else if (platform === 'win32') {\x0d\n    // On Windows\x2C modern browsers return 'Win32' even if running on a 64-bit version of Windows.\x0d\n    // https://developer.mozilla.org/en-US/docs/Web/API/Navigator/platform#usage_notes\x0d\n    return 'Win32';\x0d\n  } else if (platform === 'linux') {\x0d\n    if (arch === 'ia32') {\x0d\n      return 'Linux i686';\x0d\n    } else if (arch === 'x64') {\x0d\n      return 'Linux x86_64';\x0d\n    }\x0d\n    return `Linux ${arch}`;\x0d\n  } else if (platform === 'freebsd') {\x0d\n    if (arch === 'ia32') {\x0d\n      return 'FreeBSD i386';\x0d\n    } else if (arch === 'x64') {\x0d\n      return 'FreeBSD amd64';\x0d\n    }\x0d\n    return `FreeBSD ${arch}`;\x0d\n  } else if (platform === 'openbsd') {\x0d\n    if (arch === 'ia32') {\x0d\n      return 'OpenBSD i386';\x0d\n    } else if (arch === 'x