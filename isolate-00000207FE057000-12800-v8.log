script-source,389,C:\\Users\\Basant\\Desktop\\NodeJS\\Car-Pool-Website\\node_modules\\.pnpm\\mysql2@3.24.1_@types+node@26.2.0\\node_modules\\mysql2\\lib\\commands\\command.js,'use strict';\n\nconst EventEmitter = require('events').EventEmitter;\nconst Timers = require('timers');\n\nclass Command extends EventEmitter {\n  constructor() {\n    super();\n    this.next = null;\n  }\n\n  // slow. debug only\n  stateName() {\n    const state = this.next;\n    for (const i in this) {\n      if (this[i] === state && i !== 'next') {\n        return i;\n      }\n    }\n    return 'unknown name';\n  }\n\n  execute(packet\x2C connection) {\n    if (!this.next) {\n      this.next = this.start;\n      connection._resetSequenceId();\n    }\n    if (packet && packet.isError()) {\n      const err = packet.asError(connection.clientEncoding);\n      err.sql = this.sql || this.query;\n      if (this.queryTimeout) {\n        Timers.clearTimeout(this.queryTimeout);\n        this.queryTimeout = null;\n      }\n      if (this.onResult) {\n        this.onResult(err);\n        this.emit('end');\n      } else {\n        this.emit('error'\x2C err);\n        this.emit('end');\n      }\n      return true;\n    }\n    // TODO: don't return anything from execute\x2C it's ugly and error-prone. Listen for 'end' event in connection\n    this.next = this.next(packet\x2C connection);\n    if (this.next) {\n      return false;\n    }\n    this.emit('end');\n    return true;\n  }\n}\n\nmodule.exports = Command;\n
