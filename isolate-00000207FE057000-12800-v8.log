ypeIncludes(checks\x2C s))\x0d\n      return true;\x0d\n  return false;\x0d\n}\x0d\n\x0d\nconst validateByteSource = hideStackFrames((val\x2C name) => {\x0d\n  val = toBuf(val);\x0d\n\x0d\n  if (isAnyArrayBuffer(val) || isArrayBufferView(val))\x0d\n    return val;\x0d\n\x0d\n  throw new ERR_INVALID_ARG_TYPE.HideStackFramesError(\x0d\n    name\x2C\x0d\n    [\x0d\n      'string'\x2C\x0d\n      'ArrayBuffer'\x2C\x0d\n      'TypedArray'\x2C\x0d\n      'DataView'\x2C\x0d\n      'Buffer'\x2C\x0d\n    ]\x2C\x0d\n    val);\x0d\n});\x0d\n\x0d\n/**\x0d\n * @template T\x0d\n * @typedef {{ run(): Promise<T> }} WebCryptoJob\x0d\n */\x0d\n\x0d\n/**\x0d\n * CryptoJob constructors can synchronously throw while running their native\x0d\n * AdditionalConfig hook. WebCrypto needs those operation-specific setup\x0d\n * failures to reject with an OperationError.\x0d\n * @template T\x0d\n * @param {() => WebCryptoJob<T>} getJob\x0d\n * @returns {Promise<T>}\x0d\n */\x0d\nfunction jobPromise(getJob) {\x0d\n  try {\x0d\n    return getJob().run();\x0d\n  } catch (err) {\x0d\n    return PromiseReject(lazyDOMException(\x0d\n      'The operation failed for an operation-specific reason'\x2C\x0d\n      { name: 'OperationError'\x2C cause: err }));\x0d\n  }\x0d\n}\x0d\n\x0d\n/**\x0d\n * Temporarily shadow inherited then accessors on WebCrypto result objects.\x0d\n * Promise resolution reads "then" synchronously for thenable assimilation.\x0d\n * Returning an own undefined data property keeps that lookup from reaching\x0d\n * user-mutated prototypes.\x0d\n * @param {unknown} value\x0d\n * @returns {boolean}\x0d\n */\x0d\nfunction prepareWebCryptoResult(value) {\x0d\n  if ((value === null || typeof value !== 'object') &&\x0d\n      typeof value !== 'function') {\x0d\n    return false;\x0d\n  }\x0d\n  if (isPromise(value) || ObjectPrototypeHasOwnProperty(value\x2C 'then'))\x0d\n    return false;\x0d\n  setOwnProperty(value\x2C 'then'\x2C undefined);\x0d\n  return true;\x0d\n}\x0d\n\x0d\n/**\x0d\n * Remove the temporary then property installed by prepareWebCryptoResult().\x0d\n * @param {{ then?: unknown }} value\x0d\n * @returns {void}\x0d\n */\x0d\nfunction cleanupWebCryptoResult(value) {\x0d\n  delete value.then;\x0d\n}\x0d\n\x0d\n/**\x0d\n * @template T\x0d\n * @typedef {(value: T | PromiseLike<T>) => void} WebCryptoResolve\x0d\n */\x0d\n\x0d\n/**\x0d\n * Resolve a WebCrypto promise while inherited then accessors are shadowed.\x0d\n * @template T\x0d\n * @param {WebCryptoResolve<T>} resolve\x0d\n * @param {T | PromiseLike<T>} value\x0d\n * @returns {void}\x0d\n */\x0d\nfunction resolveWebCryptoResult(resolve\x2C value) {\x0d\n  const shouldCleanupResult = prepareWebCryptoResult(value);\x0d\n  try {\x0d\n    resolve(value);\x0d\n  } finally {\x0d\n    if (shouldCleanupResult)\x0d\n      cleanupWebCryptoResult(value);\x0d\n  }\x0d\n}\x0d\n\x0d\n/**\x0d\n * Run a WebCrypto promise reaction and settle the outer promise.\x0d\n * @template T\x0d\n * @template TResult\x0d\n * @param {((value: T) => TResult | PromiseLike<TResult>) | undefined} handler\x0d\n * @param {WebCryptoResolve<T | TResult>} resolve\x0d\n * @param {(reason?: unknown) => void} reject\x0d\n * @param {T} value\x0d\n * @param {boolean} isRejected\x0d\n * @returns {void}\x0d\n */\x0d\nfunction settleJobPromise(handler\x2C resolve\x2C reject\x2C value\x2C isRejected) {\x0d\n  try {\x0d\n    if (typeof handler === 'function') {\x0d\n      resolveWebCryptoResult(resolve\x2C handler(value));\x0d\n    } else if (isRejected) {\x0d\n      reject(value);\x0d\n    } else {\x0d\n      resolveWebCryptoResult(resolve\x2C value);\x0d\n    }\x0d\n  } catch (err) {\x0d\n    reject(err);\x0d\n  }\x0d\n}\x0d\n\x0d\n/**\x0d\n * Promise.prototype.then gets promise.constructor to determine the result\x0d\n * promise's species. These promises are internal WebCrypto intermediates\x2C so\x0d\n * make that lookup stay on the promise itself instead of user-mutated state.\x0d\n * @template T\x0d\n * @template [TResult1=T]\x0d\n * @template [TResult2=never]\x0d\n * @param {Promise<T>} promise\x0d\n * @param {((value: T) => TResult1 | PromiseLike<TResult1>) | null | undefined} [onFulfilled]\x0d\n * @param {((reason: unknown) => TResult2 | PromiseLike<TResult2>) | null | undefined} [onRejected]\x0d\n * @returns {Promise<TResult1 | TResult2>}\x0d\n */\x0d\nfunction jobPromiseThen(promise\x2C onFulfilled\x2C onRejected) {\x0d\n  const {\x0d\n    promise: resultPromise\x2C\x0d\n    resolve\x2C\x0d\n    reject\x2C\x0d\n  } = PromiseWithResolvers();\x0d\n  setOwnProperty(promise\x2C 'constructor'\x2C undefined);\x0d\n  PromisePrototypeThen(\x0d\n    promise\x2C\x0d\n    (value) => settleJobPromise(onFulfilled\x2C resolve\x2C reject\x2C value\x2C false)\x2C\x0d\n    (value) => settleJobPromise(onRejected\x2C resolve\x2C reject\x2C value\x2C true));\x0d\n  return resultPromise;\x0d\n}\x0d\n\x0d\n// In WebCrypto\x2C the publicExponent option in RSA is represented as a\x0d\n// WebIDL "BigInteger"... that is\x2C a Uint8Array that allows an arbitrary\x0d\n// number of leading zero bits. Our conventional APIs for reading\x0d\n// an unsigned int from a Buffer are not adequate. The implementation\x0d\n// here is adapted from the chromium implementation here:\x0d\n// https://github.com/chromium/chromium/blob/HEAD/third_party/blink/public/platform/web_crypto_algorithm_params.h\x2C but ported to JavaScript\x0d\n// Returns undefined if the conversion was unsuccessful.\x0d\nfunction bigIntArrayToUnsignedInt(input) {\x0d\n  let result = 0;\x0d\n\x0d\n  for (let n = 0; n < input.length; ++n) {\x0d\n    const n_reversed = input.length - n - 1;\x0d\n    if (n_reversed >= 4 && input[n])\x0d\n      return;  // Too large\x0d\n    result |= input[n] << 8 * n_reversed;\x0d\n  }\x0d\n\x0d\n  return result >>> 0;\x0d\n}\x0d\n\x0d\nfunction bigIntArrayToUnsignedBigInt(input) {\x0d\n  let result = 0n;\x0d\n\x0d\n  for (let n = 0; n < input.length; ++n) {\x0d\n    const n_reversed = input.length - n - 1;\x0d\n    result |= BigInt(input[n]) << 8n * BigInt(n_reversed);\x0d\n  }\x0d\n\x0d\n  return result;\x0d\n}\x0d\n\x0d\nfunction getStringOption(options\x2C key) {\x0d\n  let value;\x0d\n  if (options && (value = options[key]) != null)\x0d\n    validateString(value\x2C `options.${key}`);\x0d\n  return value;\x0d\n}\x0d\n\x0d\n// Must be at most 31 entries.\x0d\nconst kCanonicalUsageOrder = [\x0d\n  'encrypt'\x2C 'decrypt'\x2C\x0d\n  'sign'\x2C 'verify'\x2C\x0d\n  'deriveKey'\x2C 'deriveBits'\x2C\x0d\n  'wrapKey'\x2C 'unwrapKey'\x2C\x0d\n  'encapsulateKey'\x2C 'encapsulateBits'\x2C\x0d\n  'decapsulateKey'\x2C 'decapsulateBits'\x2C\x0d\n];\x0d\n\x0d\nconst kUsageMasks = {\x0d\n  __proto__: null\x2C\x0d\n};\x0d\nconst kUsageByMask = {\x0d\n  __proto__: null\x2C\x0d\n};\x0d\n// Derive both lookup tables from kCanonicalUsageOrder so adding a new\x0d\n// usage only requires updating the canonical list above. The numeric\x0d\n// mask uses the usage's canonical index as its bit position.\x0d\nfor (let n = 0; n < kCanonicalUsageOrder.length; n++) {\x0d\n  const usage = kCanonicalUsageOrder[n];\x0d\n  const mask = 1 << n;\x0d\n  kUsageMasks[usage] = mask;\x0d\n  kUsageByMask[mask] = usage;\x0d\n}\x0d\n\x0d\n/**\x0d\n * Returns a bit mask representing the usages from `usageSet`.\x0d\n * @param {SafeSet<string>} usageSet\x0d\n * @returns {number}\x0d\n */\x0d\nfunction getUsagesMask(usageSet) {\x0d\n  // No usages is a valid state for some public keys\x2C represented by a\x0d\n  // zero mask.\x0d\n  if (usageSet.size === 0) return 0;\x0d\n  let mask = 0;\x0d\n  for (const usage of usageSet) {\x0d\n    mask |= kUsageMasks[usage];\x0d\n  }\x0d\n  return mask;\x0d\n}\x0d\n\x0d\n/**\x0d\n * Returns whether `mask` contains `usage`.\x0d\n * @param {number} mask\x0d\n * @param {string} usage\x0d\n * @returns {boolean}\x0d\n */\x0d\nfunction hasUsage(mask\x2C usage) {\x0d\n  return (mask & kUsageMasks[usage]) !== 0;\x0d\n}\x0d\n\x0d\n/**\x0d\n * Returns the usages represented by `mask` in canonical or