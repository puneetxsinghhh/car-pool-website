script-source,116,file:///C:/Users/Basant/Desktop/NodeJS/Car-Pool-Website/src/adapters/inbound/http/controllers/UserController.js,export default class UserController {\x0d\n\x0d\n    constructor(createUser\x2C getUserRides\x2C getDriverSummary) {\x0d\n        this.createUser = createUser;\x0d\n        this.getUserRides = getUserRides;\x0d\n        this.getDriverSummaryUseCase = getDriverSummary;\x0d\n    }\x0d\n\x0d\n    async create(req\x2C res\x2C next) {\x0d\n        try {\x0d\n            const user = await this.createUser.execute(req.body);\x0d\n\x0d\n            res.status(201).json(user);\x0d\n        } catch (error) {\x0d\n            next(error);\x0d\n        }\x0d\n    }\x0d\n\x0d\n    async getRides(req\x2C res\x2C next) {\x0d\n        try {\x0d\n            const rides = await this.getUserRides.execute(\x0d\n                Number(req.params.id)\x0d\n            );\x0d\n\x0d\n            res.status(200).json(rides);\x0d\n        } catch (error) {\x0d\n            next(error);\x0d\n        }\x0d\n    }\x0d\n\x0d\n    async getDriverSummary(req\x2C res\x2C next) {\x0d\n\x0d\n    try {\x0d\n\x0d\n        const driverId =\x0d\n            Number(req.params.id);\x0d\n\x0d\n        const summary =\x0d\n            await this.getDriverSummaryUseCase.execute(\x0d\n                driverId\x0d\n            );\x0d\n\x0d\n        if (!summary) {\x0d\n\x0d\n            return res.status(404).json({\x0d\n                message: "Driver not found"\x0d\n            });\x0d\n        }\x0d\n\x0d\n        res.status(200).json(summary);\x0d\n\x0d\n    } \x0d\n    catch (error) {\x0d\n\x0d\n        next(error);\x0d\n     }\x0d\n    }\x0d\n\x0d\n}
