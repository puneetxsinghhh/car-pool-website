code-creation,Script,9,662080,0x1da5fbd17b0,96, file:///C:/Users/Basant/Desktop/NodeJS/Car-Pool-Website/src/adapters/outbound/persistence/MySQLBookingRepository.js:1:1,0x3eb54b1e290,~
script-source,107,file:///C:/Users/Basant/Desktop/NodeJS/Car-Pool-Website/src/adapters/outbound/persistence/MySQLBookingRepository.js,import Booking from "../../../domain/entities/Booking.js";\x0d\nimport BookingRepository from "../../../application/ports/BookingRepository.js";\x0d\nimport mysqlPool from "../../../infrastructure/database/mysqlDb.js";\x0d\n\x0d\n// Outbound Adapter:\x0d\n// Implements the BookingRepository port using MySQL.\x0d\nexport default class MySQLBookingRepository extends BookingRepository {\x0d\n\x0d\n    constructor() {\x0d\n        super();\x0d\n\x0d\n        this.pool = mysqlPool;\x0d\n    }\x0d\n\x0d\n    // Creates a new booking in MySQL.\x0d\n    async create(booking) {\x0d\n\x0d\n        const query = `\x0d\n            INSERT INTO bookings (\x0d\n                ride_id\x2C\x0d\n                passenger_id\x0d\n            )\x0d\n            VALUES (?\x2C ?)\x0d\n        `;\x0d\n\x0d\n        const values = [\x0d\n            booking.rideId\x2C\x0d\n            booking.passengerId\x0d\n        ];\x0d\n\x0d\n        const [result] = await this.pool.execute(\x0d\n            query\x2C\x0d\n            values\x0d\n        );\x0d\n\x0d\n        return new Booking({\x0d\n            id: result.insertId\x2C\x0d\n            rideId: booking.rideId\x2C\x0d\n            passengerId: booking.passengerId\x0d\n        });\x0d\n    }\x0d\n\x0d\n    // Checks whether a passenger has already joined a ride.\x0d\n    async findByRideAndPassenger(rideId\x2C passengerId) {\x0d\n\x0d\n        const query = `\x0d\n            SELECT\x0d\n                id\x2C\x0d\n                ride_id\x2C\x0d\n                passenger_id\x0d\n            FROM bookings\x0d\n            WHERE ride_id = ?\x0d\n              AND passenger_id = ?\x0d\n        `;\x0d\n\x0d\n        const [rows] = await this.pool.execute(\x0d\n            query\x2C\x0d\n            [rideId\x2C passengerId]\x0d\n        );\x0d\n\x0d\n        if (rows.length === 0) {\x0d\n            return null;\x0d\n        }\x0d\n\x0d\n        const row = rows[0];\x0d\n\x0d\n        return new Booking({\x0d\n            id: row.id\x2C\x0d\n            rideId: row.ride_id\x2C\x0d\n            passengerId: row.passenger_id\x0d\n        });\x0d\n    }\x0d\n\x0d\n    // Gets all bookings made by a passenger.\x0d\n    async findByUserId(userId) {\x0d\n\x0d\n        const query = `\x0d\n            SELECT\x0d\n                b.id\x2C\x0d\n                b.ride_id\x2C\x0d\n                b.passenger_id\x0d\n            FROM bookings b\x0d\n            WHERE b.passenger_id = ?\x0d\n            ORDER BY b.id\x0d\n        `;\x0d\n\x0d\n        const [rows] = await this.pool.execute(\x0d\n            query\x2C\x0d\n            [userId]\x0d\n        );\x0d\n\x0d\n        return rows.map(row => new Booking({\x0d\n            id: row.id\x2C\x0d\n            rideId: row.ride_id\x2C\x0d\n            passengerId: row.passenger_id\x0d\n        }));\x0d\n    }\x0d\n}
