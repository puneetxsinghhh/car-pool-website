code-creation,Script,9,642349,0x1da5fbd1618,111, file:///C:/Users/Basant/Desktop/NodeJS/Car-Pool-Website/src/adapters/outbound/persistence/MySQLRideRepository.js:1:1,0x3eb54b1d0e8,~
script-source,106,file:///C:/Users/Basant/Desktop/NodeJS/Car-Pool-Website/src/adapters/outbound/persistence/MySQLRideRepository.js,import RideRepository from "../../../application/ports/RideRepository.js";\x0d\nimport mysqlPool from "../../../infrastructure/database/mysqlDb.js";\x0d\nimport Ride from "../../../domain/entities/Ride.js";\x0d\n\x0d\n// Outbound Adapter:\x0d\n// Implements the RideRepository port using MySQL.\x0d\nexport default class MySQLRideRepository extends RideRepository {\x0d\n\x0d\n    constructor() {\x0d\n        super();\x0d\n\x0d\n        this.pool = mysqlPool;\x0d\n    }\x0d\n\x0d\n    // Create a new ride in MySQL\x0d\n    async create(ride) {\x0d\n\x0d\n        const query = `\x0d\n            INSERT INTO rides (\x0d\n                driver_id\x2C\x0d\n                origin\x2C\x0d\n                destination\x2C\x0d\n                total_seats\x2C\x0d\n                available_seats\x0d\n            )\x0d\n            VALUES (?\x2C ?\x2C ?\x2C ?\x2C ?)\x0d\n        `;\x0d\n\x0d\n        const values = [\x0d\n            ride.driverId\x2C\x0d\n            ride.origin\x2C\x0d\n            ride.destination\x2C\x0d\n            ride.totalSeats\x2C\x0d\n            ride.availableSeats\x0d\n        ];\x0d\n\x0d\n        const [result] = await this.pool.execute(query\x2C values);\x0d\n\x0d\n        return {\x0d\n            id: result.insertId\x2C\x0d\n            driverId: ride.driverId\x2C\x0d\n            origin: ride.origin\x2C\x0d\n            destination: ride.destination\x2C\x0d\n            totalSeats: ride.totalSeats\x2C\x0d\n            availableSeats: ride.availableSeats\x0d\n        };\x0d\n    }\x0d\n\x0d\n    // Get all rides from MySQL\x0d\n    async findAll() {\x0d\n\x0d\n        const query = `\x0d\n            SELECT\x0d\n                id\x2C\x0d\n                driver_id\x2C\x0d\n                origin\x2C\x0d\n                destination\x2C\x0d\n                total_seats\x2C\x0d\n                available_seats\x0d\n            FROM rides\x0d\n            WHERE available_seats > 0\x0d\n            ORDER BY id\x0d\n        `;\x0d\n\x0d\n        const [rows] = await this.pool.execute(query);\x0d\n\x0d\n        return rows.map(row => new Ride({\x0d\n            id: row.id\x2C\x0d\n            driverId: row.driver_id\x2C\x0d\n            origin: row.origin\x2C\x0d\n            destination: row.destination\x2C\x0d\n            totalSeats: row.total_seats\x2C\x0d\n            availableSeats: row.available_seats\x0d\n        }));\x0d\n    }\x0d\n\x0d\n    // Find one ride by ID\x0d\n    async findById(id) {\x0d\n        const query = `\x0d\n            SELECT\x0d\n                id\x2C\x0d\n                driver_id\x2C\x0d\n                origin\x2C\x0d\n                destination\x2C\x0d\n                total_seats\x2C\x0d\n                available_seats\x0d\n            FROM rides\x0d\n            WHERE id = ?\x0d\n        `;\x0d\n\x0d\n        const [rows] = await this.pool.execute(query\x2C [id]);\x0d\n\x0d\n        if (rows.length === 0) {\x0d\n            return null;\x0d\n        }\x0d\n\x0d\n        const row = rows[0];\x0d\n\x0d\n        return new Ride({\x0d\n            id: row.id\x2C\x0d\n            driverId: row.driver_id\x2C\x0d\n            origin: row.origin\x2C\x0d\n            destination: row.destination\x2C\x0d\n            totalSeats: row.total_seats\x2C\x0d\n            availableSeats: row.available_seats\x0d\n        });\x0d\n    }\x0d\n\x0d\n\x0d\n    // Update an existing ride\x0d\n    async update(ride) {\x0d\n\x0d\n        const query = `\x0d\n            UPDATE rides\x0d\n            SET\x0d\n                available_seats = ?\x0d\n            WHERE id = ?\x0d\n        `;\x0d\n\x0d\n        const values = [\x0d\n            ride.availableSeats\x2C\x0d\n            ride.id\x0d\n        ];\x0d\n\x0d\n        await this.pool.execute(query\x2C values);\x0d\n\x0d\n        return this.findById(ride.id);\x0d\n    }\x0d\n\x0d\n\x0d\n    // find the ride Details by ID\x0d\n    async findRideDetailsById(id) {\x0d\n\x0d\n        const query = `\x0d\n            SELECT\x0d\n                r.id AS ride_id\x2C\x0d\n                r.origin\x2C\x0d\n                r.destination\x2C\x0d\n                r.total_seats\x2C\x0d\n                r.available_seats\x2C\x0d\n\x0d\n                d.id AS driver_id\x2C\x0d\n                d.name AS driver_name\x2C\x0d\n                d.email AS driver_email\x2C\x0d\n\x0d\n                p.id AS passenger_id\x2C\x0d\n                p.name AS passenger_name\x2C\x0d\n                p.email AS passenger_email\x0d\n\x0d\n            FROM rides r\x0d\n\x0d\n            INNER JOIN users d\x0d\n                ON r.driver_id = d.id\x0d\n\x0d\n            LEFT JOIN bookings b\x0d\n                ON r.id = b.ride_id\x0d\n\x0d\n            LEFT JOIN users p\x0d\n                ON b.passenger_id = p.id\x0d\n\x0d\n            WHERE r.id = ?\x0d\n\x0d\n            ORDER BY p.id\x0d\n        `;\x0d\n\x0d\n        const [rows] = await this.pool.query(\x0d\n            query\x2C\x0d\n            [id]\x0d\n        );\x0d\n\x0d\n        if (rows.length === 0) {\x0d\n            return null;\x0d\n        }\x0d\n\x0d\n        const firstRow = rows[0];\x0d\n\x0d\n        return {\x0d\n            id: firstRow.ride_id\x2C\x0d\n\x0d\n            origin: firstRow.origin\x2C\x0d\n            destination: firstRow.destination\x2C\x0d\n\x0d\n            totalSeats: firstRow.total_seats\x2C\x0d\n            availableSeats: firstRow.available_seats\x2C\x0d\n\x0d\n            driver: {\x0d\n                id: firstRow.driver_id\x2C\x0d\n                name: firstRow.driver_name\x2C\x0d\n                email: firstRow.driver_email\x0d\n            }\x2C\x0d\n\x0d\n            passengers: rows\x0d\n                .filter(row => row.passenger_id !== null)\x0d\n                .map(row => ({\x0d\n                    id: row.passenger_id\x2C\x0d\n                    name: row.passenger_name\x2C\x0d\n                    email: row.passenger_email\x0d\n                }))\x0d\n        };\x0d\n    }\x0d\n\x0d\n\x0d\n    async joinRide(rideId\x2C passengerId) {\x0d\n\x0d\n    // Get a dedicated connection from the pool\x0d\n    const connection =\x0d\n        await this.pool.getConnection();\x0d\n\x0d\n    try {\x0d\n\x0d\n        // -----------------------------------------\x0d\n        // 1. Start transaction\x0d\n        // -----------------------------------------\x0d\n        await connection.beginTransaction();\x0d\n\x0d\n        \x0d\n        // -----------------------------------------\x0d\n        // 2. Check ride and available seats\x0d\n        // -----------------------------------------\x0d\n\x0d\n        const rideQuery = `\x0d\n            SELECT\x0d\n                id\x2C\x0d\n                available_seats\x0d\n            FROM rides\x0d\n            WHERE id = ?\x0d\n            FOR UPDATE\x0d\n        `;\x0d\n\x0d\n        const [rideRows] =\x0d\n            await connection.execute(\x0d\n                rideQuery\x2C\x0d\n                [rideId]\x0d\n            );\x0d\n\x0d\n        if (rideRows.length === 0) {\x0d\n            throw new Error("Ride not found");\x0d\n        }\x0d\n\x0d\n        const ride = rideRows[0];\x0d\n\x0d\n        if (ride.available_seats <= 0) {\x0d\n            throw new Error("No available seats");\x0d\n        }\x0d\n\x0d\n\x0d\n        // -----------------------------------------\x0d\n        // 3. Check duplicate booking\x0d\n        // -----------------------------------------\x0d\n\x0d\n        const bookingCheckQuery = `\x0d\n            SELECT id\x0d\n            FROM bookings\x0d\n            WHERE ride_id = ?\x0d\n              AND passenger_id = ?\x0d\n        `;\x0d\n\x0d\n        const [bookingRows] =\x0d\n            await connection.execute(\x0d\n                bookingCheckQuery\x2C\x0d\n                [rideId\x2C passengerId]\x0d\n            );\x0d\n\x0d\n        if (bookingRows.length > 0) {\x0d\n            throw new Error(\x0d\n                "Passenger already joined this ride"\x0d\n            );\x0d\n        }\x0d\n\x0d\n        // -----------------------------------------\x0d\n        // 4. Create booking\x0d\n        // -----------------------------------------\x0d\n\x0d\n        const createBookingQuery = `\x0d\n            INSERT INTO bookings (\x0d\n                ride_id\x2C\x0d\n                passenger_id\x0d\n            )\x0d\n            VALUES (?\x2C ?)\x0d\n        `;\x0d\n\x0d\n        const [bookingResult] =\x0d\n            await connection.execute(\x0d\n                createBookingQuery\x2C\x0d\n                [rideId\x2C passengerId]\x0d\n            );\x0d\n\x0d\n\x0d\n        // -----------------------------------------\x0d\n        // 5. Decrease available seats\x0d\n        // -----------------------------------------\x0d\n\x0d\n        const updateRideQuery = `\x0d\n            UPDATE rides\x0d\n            SET available_seats = available_seats - 1\x0d\n            WHERE id = ?\x0d\n        `;\x0d\n\x0d\n        await connection.execute(\x0d\n            updateRideQuery\x2C\x0d\n            [rideId]\x0d\n        );\x0d\n\x0d\n\x0d\n        // -----------------------------------------\x0d\n        // 6. Commit transaction\x0d\n        // -----------------------------------------\x0d\n\x0d\n        await connection.commit();\x0d\n\x0d\n\x0d\n        // Return booking information\x0d\n        return {\x0d\n            id: bookingResult.insertId\x2C\x0d\n            rideId: rideId\x2C\x0d\n            passengerId: passengerId\x0d\n        };\x0d\n\x0d\n\x0d\n    } catch (error) {\x0d\n\x0d\n        // -----------------------------------------\x0d\n        // Rollback if anything fails\x0d\n        // -----------------------------------------\x0d\n\x0d\n        await connection.rollback();\x0d\n\x0d\n        throw error;\x0d\n\x0d\n\x0d\n    } finally {\x0d\n\x0d\n        // Return connection to the pool\x0d\n        connection.release();\x0d\n    }\x0d\n}\x0d\n\x0d\n\x0d\n}
