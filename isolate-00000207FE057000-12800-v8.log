 (ekeyinfo.type === 'DH' && ekeyinfo.size < options.minDHSize) {\x0d\n    const err = new ERR_TLS_DH_PARAM_SIZE(ekeyinfo.size);\x0d\n    debug('client emit:'\x2C err);\x0d\n    this.emit('error'\x2C err);\x0d\n    this.destroy();\x0d\n    return;\x0d\n  }\x0d\n\x0d\n  let verifyError = this._handle.verifyError();\x0d\n\x0d\n  // Verify that server's identity matches it's certificate's names\x0d\n  // Unless server has resumed our existing session\x0d\n  if (!verifyError && !this.isSessionReused()) {\x0d\n    const cert = this.getPeerCertificate(true);\x0d\n    verifyError = options.checkServerIdentity(\x0d\n      getSessionServerIdentity(options)\x2C\x0d\n      cert\x2C\x0d\n    );\x0d\n  }\x0d\n\x0d\n  if (verifyError) {\x0d\n    this.authorized = false;\x0d\n    this.authorizationError = verifyError.code || verifyError.message;\x0d\n\x0d\n    // rejectUnauthorized property can be explicitly defined as `undefined`\x0d\n    // causing the assignment to default value (`true`) fail. Before assigning\x0d\n    // it to the tlssock connection options\x2C explicitly check if it is false\x0d\n    // and update rejectUnauthorized property. The property gets used by\x0d\n    // TLSSocket connection handler to allow or reject connection if\x0d\n    // unauthorized.\x0d\n    // This check is potentially redundant\x2C however it is better to keep it\x0d\n    // in case the option object gets modified somewhere.\x0d\n    if (options.rejectUnauthorized !== false) {\x0d\n      this.destroy(verifyError);\x0d\n      return;\x0d\n    }\x0d\n    debug('client emit secureConnect. rejectUnauthorized: %s\x2C ' +\x0d\n          'authorizationError: %s'\x2C options.rejectUnauthorized\x2C\x0d\n          this.authorizationError);\x0d\n  } else {\x0d\n    this.authorized = true;\x0d\n    debug('client emit secureConnect. authorized:'\x2C this.authorized);\x0d\n  }\x0d\n  this.secureConnecting = false;\x0d\n  this.emit('secureConnect');\x0d\n\x0d\n  this[kIsVerified] = true;\x0d\n  const session = this[kPendingSession];\x0d\n  this[kPendingSession] = null;\x0d\n  if (session)\x0d\n    this.emit('session'\x2C session);\x0d\n\x0d\n  this.removeListener('end'\x2C onConnectEnd);\x0d\n}\x0d\n\x0d\nfunction onConnectEnd() {\x0d\n  // NOTE: This logic is shared with _http_client.js\x0d\n  if (!this._hadError) {\x0d\n    const options = this[kConnectOptions];\x0d\n    this._hadError = true;\x0d\n    const error = new ConnResetException('Client network socket disconnected ' +\x0d\n                                         'before secure TLS connection was ' +\x0d\n                                         'established');\x0d\n    error.path = options.path;\x0d\n    error.host = options.host;\x0d\n    error.port = options.port;\x0d\n    error.localAddress = options.localAddress;\x0d\n    this.destroy(error);\x0d\n  }\x0d\n}\x0d\n\x0d\n// Arguments: [port\x2C] [host\x2C] [options\x2C] [cb]\x0d\nexports.connect = function connect(...args) {\x0d\n  args = normalizeConnectArgs(args);\x0d\n  let options = args[0];\x0d\n  const cb = args[1];\x0d\n  const allowUnauthorized = getAllowUnauthorized();\x0d\n\x0d\n  options = {\x0d\n    rejectUnauthorized: !allowUnauthorized\x2C\x0d\n    ciphers: tls.DEFAULT_CIPHERS\x2C\x0d\n    checkServerIdentity: tls.checkServerIdentity\x2C\x0d\n    minDHSize: 1024\x2C\x0d\n    ...options\x2C\x0d\n  };\x0d\n\x0d\n  if (!options.keepAlive)\x0d\n    options.singleUse = true;\x0d\n\x0d\n  validateFunction(options.checkServerIdentity\x2C 'options.checkServerIdentity');\x0d\n  validateNumber(options.minDHSize\x2C 'options.minDHSize'\x2C 1);\x0d\n\x0d\n  const context = options.secureContext || tls.createSecureContext(options);\x0d\n\x0d\n  options.session = getSessionForReuse(options.session\x2C options);\x0d\n\x0d\n  const tlssock = new TLSSocket(options.socket\x2C {\x0d\n    allowHalfOpen: options.allowHalfOpen\x2C\x0d\n    pipe: !!options.path\x2C\x0d\n    secureContext: context\x2C\x0d\n    isServer: false\x2C\x0d\n    requestCert: true\x2C\x0d\n    rejectUnauthorized: options.rejectUnauthorized !== false\x2C\x0d\n    session: options.session\x2C\x0d\n    ALPNProtocols: options.ALPNProtocols\x2C\x0d\n    requestOCSP: options.requestOCSP\x2C\x0d\n    enableTrace: options.enableTrace\x2C\x0d\n    pskCallback: options.pskCallback\x2C\x0d\n    highWaterMark: options.highWaterMark\x2C\x0d\n    onread: options.onread\x2C\x0d\n    signal: options.signal\x2C\x0d\n    noDelay: options.noDelay\x2C\x0d\n    keepAlive: options.keepAlive\x2C\x0d\n    keepAliveInitialDelay: options.keepAliveInitialDelay\x2C\x0d\n  });\x0d\n\x0d\n  // rejectUnauthorized property can be explicitly defined as `undefined`\x0d\n  // causing the assignment to default value (`true`) fail. Before assigning\x0d\n  // it to the tlssock connection options\x2C explicitly check if it is false\x0d\n  // and update rejectUnauthorized property. The property gets used by TLSSocket\x0d\n  // connection handler to allow or reject connection if unauthorized\x0d\n  options.rejectUnauthorized = options.rejectUnauthorized !== false;\x0d\n\x0d\n  tlssock[kConnectOptions] = options;\x0d\n\x0d\n  if (cb)\x0d\n    tlssock.once('secureConnect'\x2C cb);\x0d\n\x0d\n  if (!options.socket) {\x0d\n    // If user provided the socket\x2C it's their responsibility to manage its\x0d\n    // connectivity. If we created one internally\x2C we connect it.\x0d\n    if (options.timeout) {\x0d\n      tlssock.setTimeout(options.timeout);\x0d\n    }\x0d\n\x0d\n    tlssock.connect(options\x2C tlssock._start);\x0d\n  }\x0d\n\x0d\n  tlssock._releaseControl();\x0d\n\x0d\n  if (options.session)\x0d\n    tlssock.setSession(options.session);\x0d\n\x0d\n  if (options.servername) {\x0d\n    if (!ipServernameWarned && net.isIP(options.servername)) {\x0d\n      process.emitWarning(\x0d\n        'Setting the TLS ServerName to an IP address is not permitted by ' +\x0d\n        'RFC 6066. This will be ignored in a future version.'\x2C\x0d\n        'DeprecationWarning'\x2C\x0d\n        'DEP0123'\x2C\x0d\n      );\x0d\n      ipServernameWarned = true;\x0d\n    }\x0d\n    tlssock.setServername(options.servername);\x0d\n  }\x0d\n\x0d\n  if (options.socket)\x0d\n    tlssock._start();\x0d\n\x0d\n  tlssock.on('secure'\x2C onConnectSecure);\x0d\n  tlssock.prependListener('end'\x2C onConnectEnd);\x0d\n\x0d\n  return tlssock;\x0d\n};\x0d\n
