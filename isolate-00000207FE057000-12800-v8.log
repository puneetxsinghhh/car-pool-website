2C ...args);\n  }\n  return fn.apply(thisArg\x2C args);\n}\n\n// tracePromise for operations that are inherently async (connection handshake)\nfunction tracePromise(channel\x2C fn\x2C contextFactory) {\n  if (shouldTrace(channel)) {\n    return channel.tracePromise(fn\x2C contextFactory());\n  }\n  return fn();\n}\n\nmodule.exports = {\n  dc\x2C\n  hasTracingChannel\x2C\n  shouldTrace\x2C\n  queryChannel\x2C\n  executeChannel\x2C\n  connectChannel\x2C\n  poolConnectChannel\x2C\n  getServerContext\x2C\n  traceCallback\x2C\n  tracePromise\x2C\n};\n
