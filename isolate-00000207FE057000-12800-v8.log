n\x0d\nfunction setGlobalProxyFromEnv(env = process.env) {\x0d\n  validateObject(env\x2C 'proxyEnv');\x0d\n  const httpProxy = parseProxyUrl(env\x2C 'http:');\x0d\n  const httpsProxy = parseProxyUrl(env\x2C 'https:');\x0d\n  const noProxy = env.no_proxy || env.NO_PROXY;\x0d\n\x0d\n  if (!httpProxy && !httpsProxy) {\x0d\n    return () => {};\x0d\n  }\x0d\n\x0d\n  if (httpProxy && !URL.canParse(httpProxy)) {\x0d\n    throw new ERR_PROXY_INVALID_CONFIG(httpProxy);\x0d\n  }\x0d\n  if (httpsProxy && !URL.canParse(httpsProxy)) {\x0d\n    throw new ERR_PROXY_INVALID_CONFIG(httpsProxy);\x0d\n  }\x0d\n\x0d\n  let originalDispatcher\x2C originalHttpsAgent\x2C originalHttpAgent;\x0d\n  if (httpProxy || httpsProxy) {\x0d\n    // Set it for fetch.\x0d\n    const { setGlobalDispatcher\x2C getGlobalDispatcher\x2C EnvHttpProxyAgent } = lazyUndici();\x0d\n    const envHttpProxyAgent = new EnvHttpProxyAgent({\x0d\n      __proto__: null\x2C httpProxy\x2C httpsProxy\x2C noProxy\x2C\x0d\n    });\x0d\n    originalDispatcher = getGlobalDispatcher();\x0d\n    setGlobalDispatcher(envHttpProxyAgent);\x0d\n  }\x0d\n\x0d\n  if (httpProxy) {\x0d\n    originalHttpAgent = module.exports.globalAgent;\x0d\n    module.exports.globalAgent = getGlobalAgent(env\x2C httpAgent.Agent);\x0d\n  }\x0d\n  if (httpsProxy && !!process.versions.openssl) {\x0d\n    const https = require('https');\x0d\n    originalHttpsAgent = https.globalAgent;\x0d\n    https.globalAgent = getGlobalAgent(env\x2C https.Agent);\x0d\n  }\x0d\n\x0d\n  return function restore() {\x0d\n    if (originalDispatcher) {\x0d\n      const { setGlobalDispatcher } = lazyUndici();\x0d\n      setGlobalDispatcher(originalDispatcher);\x0d\n    }\x0d\n    if (originalHttpAgent) {\x0d\n      module.exports.globalAgent = originalHttpAgent;\x0d\n    }\x0d\n    if (originalHttpsAgent) {\x0d\n      require('https').globalAgent = originalHttpsAgent;\x0d\n    }\x0d\n  };\x0d\n}\x0d\n\x0d\nmodule.exports = {\x0d\n  _connectionListener\x2C\x0d\n  METHODS: me