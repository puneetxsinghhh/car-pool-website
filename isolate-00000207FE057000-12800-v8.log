script-source,96,file:///C:/Users/Basant/Desktop/NodeJS/Car-Pool-Website/src/adapters/outbound/persistence/PostgreSQLUserRepository.js,import User from "../../../domain/entities/User.js";\x0d\nimport UserRepository from "../../../application/ports/UserRepository.js";\x0d\n\x0d\nexport default class PostgreSQLUserRepository extends UserRepository {\x0d\n\x0d\n    constructor(pool) {\x0d\n        super();\x0d\n        this.pool = pool;\x0d\n    }\x0d\n\x0d\n    async create(user) {\x0d\n\x0d\n        const query = `\x0d\n            INSERT INTO users (name\x2C email\x2C role)\x0d\n            VALUES ($1\x2C $2\x2C $3)\x0d\n            RETURNING id\x2C name\x2C email\x2C role\x0d\n        `;\x0d\n\x0d\n        const values = [\x0d\n            user.name\x2C\x0d\n            user.email\x2C\x0d\n            user.role\x0d\n        ];\x0d\n\x0d\n        const result = await this.pool.query(query\x2C values);\x0d\n\x0d\n        return new User(result.rows[0]);\x0d\n    }\x0d\n\x0d\n    async findById(id) {\x0d\n\x0d\n        const query = `\x0d\n            SELECT id\x2C name\x2C email\x2C role\x0d\n            FROM users\x0d\n            WHERE id = $1\x0d\n        `;\x0d\n\x0d\n        const result = await this.pool.query(query\x2C [id]);\x0d\n\x0d\n        if (result.rows.length === 0) {\x0d\n            return null;\x0d\n        }\x0d\n\x0d\n        return new User(result.rows[0]);\x0d\n    }\x0d\n\x0d\n    async getDriverSummary(driverId) {\x0d\n\x0d\n    const query = `\x0d\n        SELECT\x0d\n            u.id AS driver_id\x2C\x0d\n            u.name AS driver_name\x2C\x0d\n\x0d\n            COUNT(DISTINCT r.id) AS total_rides\x2C\x0d\n\x0d\n            COUNT(DISTINCT b.passenger_id)\x0d\n                AS total_passengers\x2C\x0d\n\x0d\n            COALESCE(\x0d\n                SUM(r.total_seats)\x2C\x0d\n                0\x0d\n            ) AS total_seats\x2C\x0d\n\x0d\n            COALESCE(\x0d\n                SUM(r.available_seats)\x2C\x0d\n                0\x0d\n            ) AS available_seats\x0d\n\x0d\n        FROM users u\x0d\n\x0d\n        LEFT JOIN rides r\x0d\n            ON u.id = r.driver_id\x0d\n\x0d\n        LEFT JOIN bookings b\x0d\n            ON r.id = b.ride_id\x0d\n\x0d\n        WHERE u.id = $1\x0d\n          AND u.role = 'DRIVER'\x0d\n\x0d\n        GROUP BY\x0d\n            u.id\x2C\x0d\n            u.name;\x0d\n    `;\x0d\n\x0d\n    const result = await this.pool.query(\x0d\n        query\x2C\x0d\n        [driverId]\x0d\n    );\x0d\n\x0d\n    if (result.rows.length === 0) {\x0d\n        return null;\x0d\n    }\x0d\n\x0d\n    const row = result.rows[0];\x0d\n\x0d\n    return {\x0d\n        driverId: row.driver_id\x2C\x0d\n        driverName: row.driver_name\x2C\x0d\n        totalRides: Number(row.total_rides)\x2C\x0d\n        totalPassengers: Number(row.total_passengers)\x2C\x0d\n        totalSeats: Number(row.total_seats)\x2C\x0d\n        availableSeats: Number(row.available_seats)\x0d\n    };\x0d\n}\x0d\n\x0d\n}
