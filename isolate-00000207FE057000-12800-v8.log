script-source,397,C:\\Users\\Basant\\Desktop\\NodeJS\\Car-Pool-Website\\node_modules\\.pnpm\\mysql2@3.24.1_@types+node@26.2.0\\node_modules\\mysql2\\lib\\commands\\query.js,'use strict';\n\nconst process = require('process');\nconst Timers = require('timers');\n\nconst Readable = require('stream').Readable;\n\nconst Command = require('./command.js');\nconst Packets = require('../packets/index.js');\nconst getTextParser = require('../parsers/text_parser.js');\nconst staticParser = require('../parsers/static_text_parser.js');\nconst ServerStatus = require('../constants/server_status.js');\n\nconst EmptyPacket = new Packets.Packet(0\x2C Buffer.allocUnsafe(4)\x2C 0\x2C 4);\n\n// http://dev.mysql.com/doc/internals/en/com-query.html\nclass Query extends Command {\n  constructor(options\x2C callback) {\n    super();\n    this.sql = options.sql;\n    this.values = options.values;\n    this._queryOptions = options;\n    this.namedPlaceholders = Object.prototype.hasOwnProperty.call(\n      options\x2C\n      'namedPlaceholders'\n    )\n      ? options.namedPlaceholders\n      : undefined;\n    this.onResult = callback;\n    this.timeout = options.timeout;\n    this.queryTimeout = null;\n    this._fieldCount = 0;\n    this._rowParser = null;\n    this._fields = [];\n    this._rows = [];\n    this._currentRows = null;\n    this._currentFields = null;\n    this._receivedFieldsCount = 0;\n    this._resultIndex = 0;\n    this._localStream = null;\n    this._unpipeStream = function () {};\n    this._streamFactory = options.infileStreamFactory;\n    this._connection = null;\n  }\n\n  then() {\n    const err =\n      "You have tried to call .then()\x2C .catch()\x2C or invoked await on the result of query that is not a promise\x2C which is a programming error. Try calling con.promise().query()\x2C or require('mysql2/promise') instead of 'mysql2' for a promise-compatible version of the query interface. To learn how to use async/await or Promises check out documentation at https://sidorares.github.io/node-mysql2/docs#using-promise-wrapper\x2C or the mysql2 documentation at https://sidorares.github.io/node-mysql2/docs/documentation/promise-wrapper";\n\n    console.log(err);\n    throw new Error(err);\n  }\n\n  start(_packet\x2C connection) {\n    if (connection.config.debug) {\n      console.log('        Sending query command: %s'\x2C this.sql);\n    }\n    this._connection = connection;\n    this.options = Object.assign({}\x2C connection.config\x2C this._queryOptions);\n    this._setTimeout();\n\n    const clientFlags =\n      connection.config.clientFlags & (connection.serverCapabilityFlags || 0);\n    const cmdPacket = new Packets.Query(\n      this.sql\x2C\n      connection.config.charsetNumber\x2C\n      this._queryOptions.attributes\x2C\n      clientFlags\n    );\n    connection.writePacket(cmdPacket.toPacket(1));\n    return Query.prototype.resultsetHeader;\n  }\n\n  done() {\n    this._unpipeStream();\n    // if all ready timeout\x2C return null directly\n    if (this.timeout && !this.queryTimeout) {\n      return null;\n    }\n    // else clear timer\n    if (this.queryTimeout) {\n      Timers.clearTimeout(this.queryTimeout);\n      this.queryTimeout = null;\n    }\n    if (this.onResult) {\n      let rows\x2C fields;\n      if (this._resultIndex === 0) {\n        rows = this._rows[0];\n        fields = this._fields[0];\n      } else {\n        rows = this._rows;\n        fields = this._fields;\n      }\n      if (fields) {\n        process.nextTick(() => {\n          this.onResult(null\x2C rows\x2C fields);\n        });\n      } else {\n        process.nextTick(() => {\n          this.onResult(null\x2C rows);\n        });\n      }\n    }\n    return null;\n  }\n\n  doneInsert(rs) {\n    if (this._localStreamError) {\n      if (this.onResult) {\n        this.onResult(this._localStreamError\x2C rs);\n      } else {\n        this.emit('error'\x2C this._localStreamError);\n      }\n      return null;\n    }\n    this._rows.push(rs);\n    this._fields.push(void 0);\n    this.emit('fields'\x2C void 0);\n    this.emit('result'\x2C rs);\n    if (rs.serverStatus & ServerStatus.SERVER_MORE_RESULTS_EXISTS) {\n      this._resultIndex++;\n      return this.resultsetHeader;\n    }\n    return this.done();\n  }\n\n  resultsetHeader(packet\x2C connection) {\n    const rs = new Packets.ResultSetHeader(packet\x2C connection);\n    this._fieldCount = rs.fieldCount;\n    if (connection.config.debug) {\n      console.log(\n        `        Resultset header received\x2C expecting ${rs.fieldCount} column definition packets`\n      );\n    }\n    if (this._fieldCount === 0) {\n      return this.doneInsert(rs);\n    }\n    if (this._fieldCount === null) {\n      return this._streamLocalInfile(connection\x2C rs.infileName);\n    }\n    this._receivedFieldsCount = 0;\n    this._currentRows = [];\n    this._currentFields = [];\n    this._rows.push(this._currentRows);\n    this._fields.push(this._currentFields);\n    return this.readField;\n  }\n\n  _streamLocalInfile(connection\x2C path) {\n    if (this._streamFactory) {\n      this._localStream = this._streamFactory(path);\n    } else {\n      this._localStreamError = new Error(\n        `As a result of LOCAL INFILE command server wants to read ${path} file\x2C but as of v2.0 you must provide streamFactory option returning ReadStream.`\n      );\n      connection.writePacket(EmptyPacket);\n      return this.infileOk;\n    }\n\n    const onConnectionError = () => {\n      this._unpipeStream();\n    };\n    const onDrain = () => {\n      this._localStream.resume();\n    };\n    const onPause = () => {\n      this._localStream.pause();\n    };\n    const onData = function (data) {\n      const dataWithHeader = Buffer.allocUnsafe(data.length + 4);\n      data.copy(dataWithHeader\x2C 4);\n      connection.writePacket(\n        new Packets.Packet(0\x2C dataWithHeader\x2C 0\x2C dataWithHeader.length)\n      );\n    };\n    const onEnd = () => {\n      connection.removeListener('error'\x2C onConnectionError);\n      connection.writePacket(EmptyPacket);\n    };\n    const onError = (err) => {\n      this._localStreamError = err;\n      connection.removeListener('error'\x2C onConnectionError);\n      connection.writePacket(EmptyPacket);\n    };\n    this._unpipeStream = () => {\n      connection.stream.removeListener('pause'\x2C onPause);\n      connection.stream.removeListener('drain'\x2C onDrain);\n      this._localStream.removeListener('data'\x2C onData);\n      this._localStream.removeListener('end'\x2C onEnd);\n      this._localStream.removeListener('error'\x2C onError);\n    };\n    connection.stream.on('pause'\x2C onPause);\n    connection.stream.on('drain'\x2C onDrain);\n    this._localStream.on('data'\x2C onData);\n    this._localStream.on('end'\x2C onEnd);\n    this._localStream.on('error'\x2C onError);\n    connection.once('error'\x2C onConnectionError);\n    return this.infileOk;\n  }\n\n  readField(packet\x2C connection) {\n    this._receivedFieldsCount++;\n    // Often there is much more data in the column definition than in the row itself\n    // If you set manually _fields[0] to array of ColumnDefinition's (from previous call)\n    // you can 'cache' result of parsing. Field packets still received\x2C but ignored in that case\n    // this is the reason _receivedFieldsCount exist (otherwise we could just use current length of fields array)\n    if (this._fields[this._resultIndex].length !== this._fieldCount) {\n      const field = new Packets.ColumnDefinition(\n        packet\x2C\n        connection.clientEncoding\x2C\n        connection._mariadbExtendedMetadata\n      );\n      this._fields[this._resultIndex].push(field);\n      if (connection.config.debug) {\n        console.log('        Column definition:');\n        console.log(`          name: ${field.name}`);\n        console.log(`          type: ${field.columnType}`);\n        console.log(`         flags: ${field.flags}`);\n      }\n    }\n    // last field received\n    if (this._receivedFieldsCount === this._fieldCount) {\n      const fields = this._fields[this._resultIndex];\n      this.emit('fields'\x2C fields);\n      if (this.options.disableEval) {\n        this._rowParser = staticParser(fields\x2C this.options\x2C connection.config);\n      } else {\n        this._rowParser = new (getTextParser(\n          fields\x2C\n          this.options\x2C\n          connection.config\n        ))(fields);\n      }\n      return Query.prototype.fieldsEOF;\n    }\n    return Query.prototype.readField;\n  }\n\n  fieldsEOF(packet\x2C connection) {\n    // check EOF\n    if (!packet.isEOF()) {\n      return connection.protocolError('Expected EOF packet');\n    }\n    return this.row;\n  }\n\n  row(packet\x2C _connection) {\n    if (packet.isEOF()) {\n      const status = packet.eofStatusFlags();\n      const moreResults = status & ServerStatus.SERVER_MORE_RESULTS_EXISTS;\n      if (moreResults) {\n        this._resultIndex++;\n        return Query.prototype.resultsetHeader;\n      }\n      return this.done();\n    }\n    let row;\n    try {\n      row = this._rowParser.next(packet\x2C this._currentFields\x2C this.options);\n    } catch (err) {\n      this._localStreamError = err;\n      return this.doneInsert(null);\n    }\n    if (this.onResult) {\n      this._currentRows.push(row);\n    } else {\n      this.emit('result'\x2C row\x2C this._resultIndex);\n    }\n    return Query.prototype.row;\n  }\n\n  infileOk(packet\x2C connection) {\n    const rs = new Packets.ResultSetHeader(packet\x2C connection);\n    return this.doneInsert(rs);\n  }\n\n  stream(options) {\n    options = options || Object.create(null);\n    options.objectMode = true;\n\n    const stream = new Readable({\n      ...options\x2C\n      emitClose: true\x2C\n      autoDestroy: true\x2C\n      read: () => {\n        this._connection && this._connection.resume();\n      }\x2C\n    });\n\n    // Prevent a breaking change for users that rely on `end` event\n    stream.once('close'\x2C () => {\n      if (!stream.readableEnded) {\n        stream.emit('end');\n      }\n    });\n\n    const onResult = (row\x2C index) => {\n      if (stream.destroyed) return;\n\n      if (!stream.push(row)) {\n        this._connection && this._connection.pause();\n      }\n\n      stream.emit('result'\x2C row\x2C index); // replicate old emitter\n    };\n\n    const onFields = (fields) => {\n      if (stream.destroyed) return;\n\n      stream.emit('fields'\x2C fields); // replicate old emitter\n    };\n\n    const onEnd = () => {\n      if (stream.destroyed) return;\n\n      stream.push(null); // pushing null\x2C indicating EOF\n    };\n\n    const onError = (err) => {\n      stream.destroy(err);\n    };\n\n    stream._destroy = (err\x2C cb) => {\n      this._connection && this._connection.resume();\n\n      this.removeListener('result'\x2C onResult);\n      this.removeListener('fields'\x2C onFields);\n      this.removeListener('end'\x2C onEnd);\n      this.removeListener('error'\x2C onError);\n\n      cb(err); // Pass on any errors\n    };\n\n    this.on('result'\x2C onResult);\n    this.on('fields'\x2C onFields);\n    this.on('end'\x2C onEnd);\n    this.on('error'\x2C onError);\n\n    return stream;\n  }\n\n  _setTimeout() {\n    if (this.timeout) {\n      const timeoutHandler = this._handleTimeoutError.bind(this);\n      this.queryTimeout = Timers.setTimeout(timeoutHandler\x2C this.timeout);\n    }\n  }\n\n  _handleTimeoutError() {\n    if (this.queryTimeout) {\n      Timers.clearTimeout(this.queryTimeout);\n      this.queryTimeout = null;\n    }\n\n    const err = new Error('Query inactivity timeout');\n    err.errorno = 'PROTOCOL_SEQUENCE_TIMEOUT';\n    err.code = 'PROTOCOL_SEQUENCE_TIMEOUT';\n    err.syscall = 'query';\n\n    if (this.onResult) {\n      this.onResult(err);\n    } else {\n      this.emit('error'\x2C err);\n    }\n  }\n}\n\nQuery.prototype.catch = Query.prototype.then;\n\nmodule.exports = Query;\n
