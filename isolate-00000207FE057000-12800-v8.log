0d\nconst kBoldCode = 1;\x0d\n\x0d\n// Close sequence for 24-bit foreground colors (reset to default foreground)\x0d\nconst kHexCloseSeq = kEscape + '39' + kEscapeEnd;\x0d\n\x0d\nlet styleCache;\x0d\n\x0d\nconst kHexStyleCacheMax = 256;\x0d\n\x0d\nlet hexStyleCache;\x0d\n\x0d\nfunction getHexStyleCache() {\x0d\n  hexStyleCache ??= new SafeMap();\x0d\n  return hexStyleCache;\x0d\n}\x0d\n\x0d\nfunction codesToStyle(codes) {\x0d\n  const openNum = codes[0];\x0d\n  return {\x0d\n    __proto__: null\x2C\x0d\n    openSeq: kEscape + openNum + kEscapeEnd\x2C\x0d\n    closeSeq: kEscape + codes[1] + kEscapeEnd\x2C\x0d\n    keepClose: openNum === kDimCode || openNum === kBoldCode\x2C\x0d\n  };\x0d\n}\x0d\n\x0d\nfunction getStyleCache() {\x0d\n  if (styleCache === undefined) {\x0d\n    styleCache = { __proto__: null };\x0d\n    const colors = inspect.colors;\x0d\n    for (const key of ObjectGetOwnPropertyNames(colors)) {\x0d\n      const codes = colors[key];\x0d\n      if (codes) {\x0d\n        styleCache[key] = codesToStyle(codes);\x0d\n      }\x0d\n    }\x0d\n  }\x0d\n  return styleCache;\x0d\n}\x0d\n\x0d\n/**\x0d\n * Returns the cached ANSI escape sequences for a hex color.\x0d\n * Computes and caches on first use to avoid repeated Buffer allocations.\x0d\n * @param {string} hex A valid hex color string (#RGB or #RRGGBB)\x0d\n * @returns {{openSeq: string\x2C closeSeq: string}}\x0d\n */\x0d\nfunction getHexStyle(hex) {\x0d\n  const cache = getHexStyleCache();\x0d\n  const cached = cache.get(hex);\x0d\n  if (cached !== undefined) return cached;\x0d\n  const { 0: r\x2C 1: g\x2C 2: b } = hexToRgb(hex);\x0d\n  const style = {\x0d\n    __proto__: null\x2C\x0d\n    openSeq: kEscape + rgbToAnsi24Bit(r\x2C g\x2C b) + kEscapeEnd\x2C\x0d\n    closeSeq: kHexCloseSeq\x2C\x0d\n  };\x0d\n  if (cache.size >= kHexStyleCacheMax)\x0d\n    cache.delete(cache.keys().next().value);\x0d\n  cache.set(hex\x2C style);\x0d\n  return style;\x0d\n}\x0d\n\x0d\nfunction replaceCloseCode(str\x2C closeSeq\