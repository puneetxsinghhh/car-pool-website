script-source,17,node:internal/priority_queue,'use strict';\x0d\n\x0d\n// The PriorityQueue is a basic implementation of a binary heap that accepts\x0d\n// a custom sorting function via its constructor. This function is passed\x0d\n// the two nodes to compare\x2C similar to the native Array#sort. Crucially\x0d\n// this enables priority queues that are based on a comparison of more than\x0d\n// just a single criteria.\x0d\n\x0d\nmodule.exports = class PriorityQueue {\x0d\n  #compare = (a\x2C b) => a - b;\x0d\n  #heap = [undefined\x2C undefined];\x0d\n  #setPosition;\x0d\n  #size = 0;\x0d\n\x0d\n  constructor(comparator\x2C setPosition) {\x0d\n    if (comparator !== undefined)\x0d\n      this.#compare = comparator;\x0d\n    if (setPosition !== undefined)\x0d\n      this.#setPosition = setPosition;\x0d\n  }\x0d\n\x0d\n  insert(value) {\x0d\n    const heap = this.#heap;\x0d\n    const pos = ++this.#size;\x0d\n    heap[pos] = value;\x0d\n\x0d\n    this.percolateUp(pos);\x0d\n  }\x0d\n\x0d\n  peek() {\x0d\n    return this.#heap[1];\x0d\n  }\x0d\n\x0d\n  peekBottom() {\x0d\n    return this.#heap[this.#size];\x0d\n  }\x0d\n\x0d\n  percolateDown(pos) {\x0d\n    const compare = this.#compare;\x0d\n    const setPosition = this.#setPosition;\x0d\n    const hasSetPosition = setPosition !== undefined;\x0d\n    const heap = this.#heap;\x0d\n    const size = this.#size;\x0d\n    const hsize = size >> 1;\x0d\n    const item = heap[pos];\x0d\n\x0d\n    while (pos <= hsize) {\x0d\n      let child = pos << 1;\x0d\n      const nextChild = child + 1;\x0d\n      let childItem = heap[child];\x0d\n\x0d\n      if (nextChild <= size && compare(heap[nextChild]\x2C childItem) < 0) {\x0d\n        child = nextChild;\x0d\n        childItem = heap[nextChild];\x0d\n      }\x0d\n\x0d\n      if (compare(item\x2C childItem) <= 0) break;\x0d\n\x0d\n      if (hasSetPosition)\x0d\n        setPosition(childItem\x2C pos);\x0d\n\x0d\n      heap[pos] = childItem;\x0d\n      pos = child;\x0d\n    }\x0d\n\x0d\n    heap[pos] = item;\x0d\n    if (hasSetPosition)\x0d\n      setPosition(item\x2C pos);\x0d\n  }\x0d\n\x0d\n  percolateUp(pos) {\x0d\n    const heap = this.#heap;\x0d\n    const compare = this.#compare;\x0d\n    const setPosition = this.#setPosition;\x0d\n    const hasSetPosition = setPosition !== undefined;\x0d\n    const item = heap[pos];\x0d\n\x0d\n    while (pos > 1) {\x0d\n      const parent = pos >> 1;\x0d\n      const parentItem = heap[parent];\x0d\n      if (compare(parentItem\x2C item) <= 0)\x0d\n        break;\x0d\n      heap[pos] = parentItem;\x0d\n      if (hasSetPosition)\x0d\n        setPosition(parentItem\x2C pos);\x0d\n      pos = parent;\x0d\n    }\x0d\n\x0d\n    heap[pos] = item;\x0d\n    if (hasSetPosition)\x0d\n      setPosition(item\x2C pos);\x0d\n  }\x0d\n\x0d\n  removeAt(pos) {\x0d\n    const heap = this.#heap;\x0d\n    let size = this.#size;\x0d\n    heap[pos] = heap[size];\x0d\n    heap[size] = undefined;\x0d\n    size = --this.#size;\x0d\n\x0d\n    if (size > 0 && pos <= size) {\x0d\n      if (pos > 1 && this.#compare(heap[pos >> 1]\x2C heap[pos]) > 0)\x0d\n        this.percolateUp(pos);\x0d\n      else\x0d\n        this.percolateDown(pos);\x0d\n    }\x0d\n  }\x0d\n\x0d\n  shift() {\x0d\n    const heap = this.#heap;\x0d\n    const value = heap[1];\x0d\n    if (value === undefined)\x0d\n      return;\x0d\n\x0d\n    this.removeAt(1);\x0d\n\x0d\n    return value;\x0d\n  }\x0d\n};\x0d\n
