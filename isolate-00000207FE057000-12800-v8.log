script-source,365,C:\\Users\\Basant\\Desktop\\NodeJS\\Car-Pool-Website\\node_modules\\.pnpm\\mysql2@3.24.1_@types+node@26.2.0\\node_modules\\mysql2\\lib\\auth_41.js,'use strict';\n\n/*\n4.1 authentication: (http://bazaar.launchpad.net/~mysql/mysql-server/5.5/view/head:/sql/password.c)\n\n  SERVER:  public_seed=create_random_string()\n           send(public_seed)\n\n  CLIENT:  recv(public_seed)\n           hash_stage1=sha1("password")\n           hash_stage2=sha1(hash_stage1)\n           reply=xor(hash_stage1\x2C sha1(public_seed\x2Chash_stage2)\n\n           // this three steps are done in scramble()\n\n           send(reply)\n\n\n  SERVER:  recv(reply)\n           hash_stage1=xor(reply\x2C sha1(public_seed\x2Chash_stage2))\n           candidate_hash2=sha1(hash_stage1)\n           check(candidate_hash2==hash_stage2)\n\nserver stores sha1(sha1(password)) ( hash_stag2)\n*/\n\nconst crypto = require('crypto');\n\nfunction sha1(msg\x2C msg1\x2C msg2) {\n  const hash = crypto.createHash('sha1');\n  hash.update(msg);\n  if (msg1) {\n    hash.update(msg1);\n  }\n\n  if (msg2) {\n    hash.update(msg2);\n  }\n\n  return hash.digest();\n}\n\nfunction xor(a\x2C b) {\n  const result = Buffer.allocUnsafe(a.length);\n  for (let i = 0; i < a.length; i++) {\n    result[i] = a[i] ^ b[i];\n  }\n  return result;\n}\n\nexports.xor = xor;\n\nfunction token(password\x2C scramble1\x2C scramble2) {\n  if (!password) {\n    return Buffer.alloc(0);\n  }\n  const stage1 = sha1(password);\n  return exports.calculateTokenFromPasswordSha(stage1\x2C scramble1\x2C scramble2);\n}\n\nexports.calculateTokenFromPasswordSha = function (\n  passwordSha\x2C\n  scramble1\x2C\n  scramble2\n) {\n  // we use AUTH 41 here\x2C and we need only the bytes we just need.\n  const authPluginData1 = scramble1.slice(0\x2C 8);\n  const authPluginData2 = scramble2.slice(0\x2C 12);\n  const stage2 = sha1(passwordSha);\n  const stage3 = sha1(authPluginData1\x2C authPluginData2\x2C stage2);\n  return xor(stage3\x2C passwordSha);\n};\n\nexports.calculateToken = token;\n\nexports.verifyToken = function (publicSeed1\x2C publicSeed2\x2C token\x2C doubleSha) {\n  const hashStage1 = xor(token\x2C sha1(publicSeed1\x2C publicSeed2\x2C doubleSha));\n  const candidateHash2 = sha1(hashStage1);\n  return candidateHash2.compare(doubleSha) === 0;\n};\n\nexports.doubleSha1 = function (password) {\n  return sha1(sha1(password));\n};\n\nfunction xorRotating(a\x2C seed) {\n  const result = Buffer.allocUnsafe(a.length);\n  const seedLen = seed.length;\n\n  for (let i = 0; i < a.length; i++) {\n    result[i] = a[i] ^ seed[i % seedLen];\n  }\n  return result;\n}\nexports.xorRotating = xorRotating;\n
