ltOrder\x2C\x0d\n  setDefaultResultOrder\x2C\x0d\n  errorCodes: dnsErrorCodes\x2C\x0d\n  validDnsOrders\x2C\x0d\n  validFamilies\x2C\x0d\n} = require('internal/dns/utils');\x0d\nconst {\x0d\n  Resolver\x2C\x0d\n} = require('internal/dns/callback_resolver');\x0d\nconst {\x0d\n  NODATA\x2C\x0d\n  FORMERR\x2C\x0d\n  SERVFAIL\x2C\x0d\n  NOTFOUND\x2C\x0d\n  NOTIMP\x2C\x0d\n  REFUSED\x2C\x0d\n  BADQUERY\x2C\x0d\n  BADNAME\x2C\x0d\n  BADFAMILY\x2C\x0d\n  BADRESP\x2C\x0d\n  CONNREFUSED\x2C\x0d\n  TIMEOUT\x2C\x0d\n  EOF\x2C\x0d\n  FILE\x2C\x0d\n  NOMEM\x2C\x0d\n  DESTRUCTION\x2C\x0d\n  BADSTR\x2C\x0d\n  BADFLAGS\x2C\x0d\n  NONAME\x2C\x0d\n  BADHINTS\x2C\x0d\n  NOTINITIALIZED\x2C\x0d\n  LOADIPHLPAPI\x2C\x0d\n  ADDRGETNETWORKPARAMS\x2C\x0d\n  CANCELLED\x2C\x0d\n} = dnsErrorCodes;\x0d\nconst {\x0d\n  validateBoolean\x2C\x0d\n  validateFunction\x2C\x0d\n  validateNumber\x2C\x0d\n  validateOneOf\x2C\x0d\n  validatePort\x2C\x0d\n  validateStringWithoutNullBytes\x2C\x0d\n} = require('internal/validators');\x0d\n\x0d\nconst {\x0d\n  GetAddrInfoReqWrap\x2C\x0d\n  GetNameInfoReqWrap\x2C\x0d\n  DNS_ORDER_VERBATIM\x2C\x0d\n  DNS_ORDER_IPV4_FIRST\x2C\x0d\n  DNS_ORDER_IPV6_FIRST\x2C\x0d\n} = cares;\x0d\n\x0d\nconst kPerfHooksDnsLookupContext = Symbol('kPerfHooksDnsLookupContext');\x0d\nconst kPerfHooksDnsLookupServiceContext = Symbol('kPerfHooksDnsLookupServiceContext');\x0d\n\x0d\nconst {\x0d\n  hasObserver\x2C\x0d\n  startPerf\x2C\x0d\n  stopPerf\x2C\x0d\n} = require('internal/perf/observe');\x0d\n\x0d\nlet promises = null; // Lazy loaded\x0d\n\x0d\nfunction onlookup(err\x2C addresses) {\x0d\n  if (err) {\x0d\n    return this.callback(new DNSException(err\x2C 'getaddrinfo'\x2C this.hostname));\x0d\n  }\x0d\n  this.callback(null\x2C addresses[0]\x2C this.family || isIP(addresses[0]));\x0d\n  if (this[kPerfHooksDnsLookupContext] && hasObserver('dns')) {\x0d\n    stopPerf(this\x2C kPerfHooksDnsLookupContext\x2C { detail: { addresses } });\x0d\n  }\x0d\n}\x0d\n\x0d\n\x0d\nfunction onlookupall(err\x2C addresses) {\x0d\n  if (err) {\x0d\n    return this.callback(new DNSException(err\x2C 'getaddrinfo'\x2C this.hostname));\x0d\n  }\x0d\n\x0d\n  const family = this.family;\x0d\n  for (let i = 0; i < addresses.length; i++) {\x0d\n    const addr = addresses[i];\x0d\n    addresses[i] = {\x0d\n      address: addr\x2C\x0d\n      family: family || isIP(addr)\x2C\x0d\n    };\x0d\n  }\x0d\n\x0d\n  this.callback(null\x2C addresses);\x0d\n  if (this[kPerfHooksDnsLookupContext] && hasObserver('dns')) {\x0d\n    stopPerf(this\x2C kPerfHooksDnsLookupContext\x2C { detail: { addresses } });\x0d\n  }\x0d\n}\x0d\n\x0d\n\x0d\n// Easy DNS A/AAAA look up\x0d\n// lookup(hostname\x2C [options\x2C] callback)\x0d\nfunction lookup(hostname\x2C options\x2C callback) {\x0d\n  let hints = 0;\x0d\n  let family = 0;\x0d\n  let all = false;\x0d\n  let dnsOrder = getDefaultResultOrder();\x0d\n\x0d\n  // Parse arguments\x0d\n  if (hostname) {\x0d\n    validateStringWithoutNullBytes(hostname\x2C 'hostname');\x0d\n  }\x0d\n\x0d\n  if (typeof options === 'function') {\x0d\n    callback = options;\x0d\n    family = 0;\x0d\n  } else if (typeof options === 'number') {\x0d\n    validateFunction(callback\x2C 'callback');\x0d\n\x0d\n    validateOneOf(options\x2C 'family'\x2C validFamilies);\x0d\n    // Coerce -0 to +0.\x0d\n    family = options + 0;\x0d\n  } else if (options !== undefined && typeof options !== 'object') {\x0d\n    validateFunction(arguments.length === 2 ? options : callback\x2C 'callback');\x0d\n    throw new ERR_INVALID_ARG_TYPE('options'\x2C ['integer'\x2C 'object']\x2C options);\x0d\n  } else {\x0d\n    validateFunction(callback\x2C 'callback');\x0d\n\x0d\n    if (options?.hints != null) {\x0d\n      validateNumber(options.hints\x2C 'options.hints');\x0d\n      hints = options.hints >>> 0;\x0d\n      validateHints(hints);\x0d\n    }\x0d\n    if (options?.family != null) {\x0d\n      switch (options.family) {\x0d\n        case 'IPv4':\x0d\n          family = 4;\x0d\n          break;\x0d\n        case 'IPv6':\x0d\n          family = 6;\x0d\n          break;\x0d\n        default:\x0d\n          validateOneOf(options.family\x2C 'options.family'\x2C validFamilies);\x0d\n          // Coerce -0 to +0.\x0d\n          family = options.family + 0;\x0d\n          break;\x0d\n      }\x0d\n    }\x0d\n    if (options?.all != null) {\x0d\n      validateBoolean(options.all\x2C 'options.all');\x0d\n      all = options.all;\x0d\n    }\x0d\n    if (options?.verbatim != null) {\x0d\n      validateBoolean(options.verbatim\x2C 'options.verbatim');\x0d\n      dnsOrder = options.verbatim ? 'verbatim' : 'ipv4first';\x0d\n    }\x0d\n    if (options?.order != null) {\x0d\n      validateOneOf(options.order\x2C 'options.order'\x2C validDnsOrders);\x0d\n      dnsOrder = options.order;\x0d\n    }\x0d\n  }\x0d\n\x0d\n  if (!hostname) {\x0d\n    emitInvalidHostnameWarning(hostname);\x0d\n    if (all) {\x0d\n      process.nextTick(callback\x2C null\x2C []);\x0d\n    } else {\x0d\n      process.nextTick(callback\x2C null\x2C null\x2C family === 6 ? 6 : 4);\x0d\n    }\x0d\n    return {};\x0d\n  }\x0d\n\x0d\n  const matchedFamily = isIP(hostname);\x0d\n  if (matchedFamily) {\x0d\n    if (all) {\x0d\n      process.nextTick(\x0d\n        callback\x2C null\x2C [{ address: hostname\x2C family: matchedFamily }]);\x0d\n    } else {\x0d\n      process.nextTick(callback\x2C null\x2C hostname\x2C matchedFamily);\x0d\n    }\x0d\n    return {};\x0d\n  }\x0d\n\x0d\n  const req = new GetAddrInfoReqWrap();\x0d\n  req.callback = callback;\x0d\n  req.family = family;\x0d\n  req.hostname = hostname;\x0d\n  req.oncomplete = all ? onlookupall : onlookup;\x0d\n\x0d\n  let order = DNS_ORDER_VERBATIM;\x0d\n\x0d\n  if (dnsOrder === 'ipv4first') {\x0d\n    order = DNS_ORDER_IPV4_FIRST;\x0d\n  } else if (dnsOrder === 'ipv6first') {\x0d\n    order = DNS_ORDER_IPV6_FIRST;\x0d\n  }\x0d\n\x0d\n  const err = cares.getaddrinfo(\x0d\n    req\x2C hostname\x2C family\x2C hints\x2C order\x2C\x0d\n  );\x0d\n  