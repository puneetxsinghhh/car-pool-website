script-source,120,file:///C:/Users/Basant/Desktop/NodeJS/Car-Pool-Website/src/adapters/inbound/http/routes/rideRoutes.js,import { Router } from "express";\x0d\n\x0d\nexport default function createRideRoutes(rideController) {\x0d\n\x0d\n    const router = Router();\x0d\n\x0d\n    router.get("/"\x2C (req\x2C res\x2C next) =>\x0d\n        rideController.getAll(req\x2C res\x2C next)\x0d\n    );\x0d\n\x0d\n    router.post("/"\x2C (req\x2C res\x2C next) =>\x0d\n        rideController.create(req\x2C res\x2C next)\x0d\n    );\x0d\n\x0d\n    router.get("/:id"\x2C (req\x2C res\x2C next) =>\x0d\n        rideController.getById(req\x2C res\x2C next)\x0d\n    );\x0d\n\x0d\n    router.post("/:id/join"\x2C (req\x2C res\x2C next) =>\x0d\n        rideController.join(req\x2C res\x2C next)\x0d\n    );\x0d\n\x0d\n    router.get(\x0d\n    "/:id/details"\x2C\x0d\n    (req\x2C res\x2C next) =>\x0d\n        rideController.getRideDetails(req\x2C res\x2C next)\x0d\n    );\x0d\n\x0d\n    router.post("/:id/join"\x2C (req\x2C res\x2C next) =>\x0d\n    rideController.join(req\x2C res\x2C next)\x0d\n    );\x0d\n\x0d\n    return router;\x0d\n}
