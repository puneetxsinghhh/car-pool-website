quire('internal/tls/common');\x0d\nconst { kReinitializeHandle } = require('internal/net');\x0d\nconst JSStreamSocket = require('internal/js_stream_socket');\x0d\nconst { Buffer } = require('buffer');\x0d\nlet debug = require('internal/util/debuglog').debuglog('tls'\x2C (fn) => {\x0d\n  debug = fn;\x0d\n});\x0d\nconst { TCP\x2C constants: TCPConstants } = internalBinding('tcp_wrap');\x0d\nconst tls_wrap = internalBinding('tls_wrap');\x0d\nconst { Pipe\x2C constants: PipeConstants } = internalBinding('pipe_wrap');\x0d\nconst { owner_symbol } = require('internal/async_hooks').symbols;\x0d\nconst { isArrayBufferView } = require('internal/util/types');\x0d\nconst { SecureContext: NativeSecureContext } = internalBinding('crypto');\x0d\nconst {\x0d\n  ConnResetException\x2C\x0d\n  codes: {\x0d\n    ERR_INVALID_ARG_TYPE\x2C\x0d\n    ERR_INVALID_ARG_VALUE\x2C\x0d\n    ERR_MULTIPLE_CALLBACK\x2C\x0d\n    ERR_SOCKET_CLOSED\x2C\x0d\n    ERR_TLS_ALPN_CALLBACK_INVALID_RESULT\x2C\x0d\n    ERR_TLS_ALPN_CALLBACK_WITH_PROTOCOLS\x2C\x0d\n    ERR_TLS_DH_PARAM_SIZE\x2C\x0d\n    ERR_TLS_HANDSHAKE_TIMEOUT\x2C\x0d\n    ERR_TLS_INVALID_CONTEXT\x2C\x0d\n    ERR_TLS_INVALID_STATE\x2C\x0d\n    ERR_TLS_RENEGOTIATION_DISABLED\x2C\x0d\n    ERR_TLS_RENEGOTIATION_UNSUPPORTED\x2C\x0d\n    ERR_TLS_REQUIRED_SERVER_NAME\x2C\x0d\n    ERR_TLS_SESSION_ATTACK\x2C\x0d\n    ERR_TLS_SNI_FROM_SERVER\x2C\x0d\n  }\x2C\x0d\n} = require('internal/errors');\x0d\nconst { onpskexchange: kOnPskExchange } = internalBinding('symbols');\x0d\nconst {\x0d\n  getOptionValue\x2C\x0d\n  getAllowUnauthorized\x2C\x0d\n} = require('internal/options');\x0d\nconst {\x0d\n  validateBoolean\x2C\x0d\n  validateBuffer\x2C\x0d\n  validateFunction\x2C\x0d\n  validateInt32\x2C\x0d\n  validateNumber\x2C\x0d\n  validateObject\x2C\x0d\n  validateString\x2C\x0d\n  validateUint32\x2C\x0d\n} = require('internal/validators');\x0d\nconst {\x0d\n  InternalX509Certificate\x2C\x0d\n} = require('internal/crypto/x509');\x0d\nconst traceTls = getOptionValue('--trace-tls');\x0d\nconst tlsKeylog = getOptionValue('--tls-keylog');\x0d\nconst { appendFile } = require('fs');\x0d\nconst kConnectOptions = Symbol('connect-options');\x0d\nconst kDisableRenegotiation = Symbol('disable-renegotiation');\x0d\nconst kErrorEmitted = Symbol('error-emitted');\x0d\nconst kHandshakeTimeout = Symbol('handshake-timeout');\x0d\nconst kRes = Symbol('res');\x0d\nconst kSNICallback = Symbol('snicallback');\x0d\nconst kALPNCallback = Symbol('alpncallback');\x0d\nconst kEnableTrace = Symbol('enableTrace');\x0d\nconst kPskCallback = Symbol('pskcallback');\x0d\nconst kPskIdentityHint = Symbol('pskidentityhint');\x0d\nconst kPendingSession = Symbol('pendingSession');\x0d\nconst kIsVerified = Symbol('verified');\x0d\n\x0d\nconst noop = () => {};\x0d\n\x0d\nconst kTLSSessionStatePrefix = Buffer.from('\\0nodejs:tls:session:1\\0');\x0d\n\x0d\nfunction getSessionServerIdentity(options) {\x0d\n  return options?.servername ||\x0d\n         options?.host ||\x0d\n         options?.socket?._host ||\x0d\n         'localhost';\x0d\n}\x0d\n\x0d\nfunction wrapSessionState(session\x2C options) {\x0d\n  if (!Buffer.isBuffer(session) || options?.isServer)\x0d\n    return session;\x0d\n\x0d\n  const servername = Buffer.from(getSessionServerIdentity(options)\x2C 'utf8');\x0d\n  const servernameLength = Buffer.allocUnsafe(2);\x0d\n  servernameLength.writeUInt16BE(servername.length\x2C 0);\x0d\n\x0d\n  return Buffer.concat([\x0d\n    kTLSSessionStatePrefix\x2C\x0d\n    servernameLength\x2C\x0d\n    servername\x2C\x0d\n    session\x2C\x0d\n  ]);\x0d\n}\x0d\n\x0d\nfunction unwrapSessionState(session) {\x0d\n  if (!Buffer.isBuffer(session) ||\x0d\n      session.length < kTLSSessionStatePrefix.length + 2 ||\x0d\n      Buffer.compare(\x0d\n        session.subarray(0\x2C kTLSSessionStatePrefix.length)\x2C\x0d\n        kTLSSessionStatePrefix\x2C\x0d\n      ) !== 0) {\x0d\n    return;\x0d\n  }\x0d\n\x0d\n  const start = kTLSSessionStatePrefix.length;\x0d\n  const servernameLength = session.readUInt16BE(start);\x0d\n  const servernameStart = start + 2;\x0d\n  const servernameEnd = servernameStart + servernameLength;\x0d\n  if (session.length < servernameEnd)\x0d\n    return;\x0d\n\x0d\n  return {\x0d\n    servername: session.toString('utf8'\x2C servernameStart\x2C servernameEnd)\x2C\x0d\n    session: session.subarray(servernameEnd)\x2C\x0d\n  };\x0d\n}\x0d\n\x0d\nfunction getSessionForReuse(session\x2C options) {\x0d\n  if (typeof session === 'string')\x0d\n    session = Buffer.from(session\x2C 'latin1');\x0d\n\x0d\n  if (options?.isServer)\x0d\n    return session;\x0d\n\x0d\n  const wrappedSession = unwrapSessionState(session);\x0d\n  if (wrappedSession !== undefined) {\x0d\n    const servername = getSessionServerIdentity(options);\x0d\n    if (wrappedSession.servername !== servername) {\x0d\n      debug('ignore session for %s: authenticated for %s'\x2C\x0d\n            servername\x2C wrappedSession.servername);\x0d\n      return;\x0d\n    }\x0d\n\x0d\n    return wrappedSession.session;\x0d\n  }\x0d\n\x0d\n  if (Buffer.isBuffer(session) && options?.rejectUnauthorized !== false) {\x0d\n    debug('ignore raw session for verified client connection to %s'\x2C\x0d\n          getSessionServerIdentity(options));\x0d\n    return;\x0d\n  }\x0d\n\x0d\n  return session;\x0d\n}\x0d\n\x0d\nlet ipServernameWarned = false;\x0d\nlet tlsTracingWarned = false;\x0d\n\x0d\n// Server side times how long a handshake is taking to protect against slow\x0d\n// handshakes being used for DoS.\x0d\nfunction onhandshakestart(now) {\x0d\n  debug('server onhandshakestart');\x0d\n\x0d\n  const { lastHandshakeTime } = this;\x0d\n  assert(now >= lastHandshakeTime\x2C\x0d\n         `now (${now}) < lastHandshakeTime (${lastHandshakeTime})`);\x0d\n\x0d\n  this.lastHandshakeTime = now;\x0d\n\x0d\n  // If this is the first handshake we can skip the rest of the checks.\x0d\n  if (lastHandshakeTime === 0)\x0d\n    return;\x0d\n\x0d\n  if ((now - lastHandshakeTime) >= tls.CLIENT_RENEG_WINDOW * 1000)\x0d\n    this.handshakes = 1;\x0d\n  else\x0d\n    this.handshakes++;\x0d\n\x0d\n  const owner = this[owner_symbol];\x0d\n\x0d\n  assert(owner._tlsOptions.isServer);\x0d\n\x0d\n  if (this.handshakes > tls.CLIENT_RENEG_LIMIT) {\x0d\n    owner._emitTLSError(new ERR_TLS_SESSION_ATTACK());\x0d\n    return;\x0d\n  }\x0d\n\x0d\n  if (owner[kDisableRenegotiation])\x0d\n    owner._emitTLSError(new ERR_TLS_RENEGOTIATION_DISABLED());\x0d\n}\x0d\n\x0d\nfunction onhandshakedone() {\x0d\n  debug('server onhandshakedone');\x0d\n\x0d\n  const owner = this[owner_symbol];\x0d\n  assert(owner._tlsOptions.isServer);\x0d\n\x0d\n  // `newSession` callback wasn't called yet\x0d\n  if (owner._newSessionPending) {\x0d\n    owner._securePending = true;\x0d\n    return;\x0d\n  }\x0d\n\x0d\n  owner._finishInit();\x0d\n}\x0d\n\x0d\n\x0d\nfunction loadSession(hello) {\x0d\n  debug('server onclienthello'\x2C\x0d\n        'sessionid.len'\x2C hello.sessionId.length\x2C\x0d\n        'ticket?'\x2C hello.tlsTicket\x2C\x0d\n  );\x0d\n  const owner = this[owner_symbol];\x0d\n\x0d\n  let once = false;\x0d\n  function onSession(err\x2C session) {\x0d\n    debug('server resumeSession callback(err %j\x2C sess? %s)'\x2C err\x2C !!session);\x0d\n    if (once)\x0d\n      return owner.destroy(new ERR_MULTIPLE_CALLBACK());\x0d\n    once = true;\x0d\n\x0d\n    if (err)\x0d\n      return owner.destroy(err);\x0d\n\x0d\n    if (owner._handle === null)\x0d\n      return owner.destroy(new ERR_SOCKET_CLOSED());\x0d\n\x0d\n    owner._handle.loadSession(session);\x0d\n    // Session is loaded. End the parser to allow handshaking to continue.\x0d\n    owner._handle.endParser();\x0d\n  }\x0d\n\x0d\n  if (hello.sessionId.length <= 0 ||\x0d\n      hello.tlsTicket ||\x0d\n      (owner.server &&\x0d\n      !(() => {\x0d\n        try {\x0d\n          return owner.server.emit('resumeSession'\x2C hello.sessionId\x2C onSession);\x0d\n        } catch (err) {\x0d\n          onSession(err);\x0d\n          return true;\x0d\n        }\x0d\n      })())) {\x0d\n    // Sessions without identifiers can't be resumed.\x0d\n    // Sessions with tickets can be resumed directly from the ticket\x2C no server\x0d\n    // session storage is necessary.\x0d\n    // Without a call to a resumeSession listener\x2C a session will never be\x0d\n    // loaded\x2C so end the parser to allow handshaking to continue.\x0d\n    owner._handle.endParser();\x0d\n  }\x0d\n}\x0d\n\x0d\n\x0d\nfunction loadSNI(info) {\x0d\n  const owner = this[owner_symbol];\x0d\n  const servername = info.servername;\x0d\n  if (!servername || !owner._SNICallback)\x0d\n    return requestOCSP(owner\x2C info);\x0d\n\x0d\n  let once = false;\x0d\n  try {\x0d\n    owner._SNICallback(servername\x2C (err\x2C context) => {\x0d\n      if (once)\x0d\n        return owner.destroy(new ERR_MULTIPLE_CALLBACK());\x0d\n      once = true;\x0d\n\x0d\n      if (err)\x0d\n        return owner.destroy(err);\x0d\n\x0d\n      if (owner._handle === null)\x0d\n        return owner.destroy(new ERR_SOCKET_CLOSED());\x0d\n\x0d\n      // TODO(indutny): eventually disallow raw `SecureContext`\x0d\n      if (context)\x0d\n        owner._handle.sni_context = context.context || context;\x0d\n\x0d\n      requestOCSP(owner\x2C info);\x0d\n    });\x0d\n  } catch (err) {\x0d\n    owner.destroy(err);\x0d\n  }\x0d\n}\x0d\n\x0d\n\x0d\nfunction callALPNCallback(protocolsBuffer) {\x0d\n  const handle = this;\x0d\n  const socket = handle[owner_symbol];\x0d\n\x0d\n  try {\x0d\n    const servername = handle.getServername();\x0d\n\x0d\n    // Collect all the protocols from the given buffer:\x0d\n    const protocols = [];\x0d\n    let offset = 0;\x0d\n    while (offset < protocolsBuffer.length) {\x0d\n      const protocolLen = protocolsBuffer[offset];\x0d\n      offset += 1;\x0d\n\x0d\n      const protocol = protocolsBuffer.slice(offset\x2C offset + protocolLen);\x0d\n      offset += protocolLen;\x0d\n\x0d\n      protocols.push(protocol.toString('ascii'));\x0d\n    }\x0d\n\x0d\n    const selectedProtocol = socket[kALPNCallback]({\x0d\n      servername\x2C\x0d\n      protocols\x2C\x0d\n    });\x0d\n\x0d\n    // Undefined -> all proposed protocols rejected\x0d\n    if (selectedProtocol === undefined) return undefined;\x0d\n\x0d\n    const protocolIndex = protocols.indexOf(selectedProtocol);\x0d\n    if (protocolIndex === -1) {\x0d\n      throw new ERR_TLS_ALPN_CALLBACK_INVALID_RESULT(selectedProtocol\x2C protocols);\x0d\n    }\x0d\n    let protocolOffset = 0;\x0d\n    for (let i = 0; i < protocolIndex; i++) {\x0d\n      protocolOffset += 1 + protocols[i].length;\x0d\n    }\x0d\n\x0d\n    return protocolOffset;\x0d\n  } catch (err) {\x0d\n    socket.destroy(err);\x0d\n    return undefined;\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction requestOCSP(socket\x2C info) {\x0d\n  if (!info.OCSPRequest || !socket.server)\x0d\n    return requestOCSPDone(socket);\x0d\n\x0d\n  let ctx = socket._handle.sni_context;\x0d\n\x0d\n  if (!ctx) {\x0d\n    ctx = socket.server._sharedCreds;\x0d\n\x0d\n    // TLS socket is using a `net.Server` instead of a tls.TLSServer.\x0d\n    // Some TLS properties like `server._sharedCreds` will not be present\x0d\n    if (!ctx)\x0d\n      return requestOCSPDone(socket);\x0d\n  }\x0d\n\x0d\n  // TODO(indutny): eventually disallow raw `SecureContext`\x0d\n  if (ctx.context)\x0d\n    ctx = ctx.context;\x0d\n\x0d\n  if (socket.server.listenerCount('OCSPRequest') === 0) {\x0d\n    return requestOCSPDone(socket);\x0d\n  }\x0d\n\x0d\n  let once = false;\x0d\n  const onOCSP = (err\x2C response) => {\x0d\n    debug('server OCSPRequest done'\x2C 'handle?'\x2C !!socket._handle\x2C 'once?'\x2C once\x2C\x0d\n          'response?'\x2C !!response\x2C 'err?'\x2C err);\x0d\n    if (once)\x0d\n      return socket.destroy(new ERR_MULTIPLE_CALLBACK());\x0d\n    once = true;\x0d\n\x0d\n    if (err)\x0d\n      return socket.destroy(err);\x0d\n\x0d\n    if (socket._handle === null)\x0d\n      return socket.destroy(new ERR_SOCKET_CLOSED());\x