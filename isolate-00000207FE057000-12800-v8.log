{\x0d\n  async_id_symbol\x2C\x0d\n  owner_symbol\x2C\x0d\n} = require('internal/async_hooks').symbols;\x0d\nconst {\x0d\n  getLazy\x2C\x0d\n  kEmptyObject\x2C\x0d\n  once\x2C\x0d\n} = require('internal/util');\x0d\nconst {\x0d\n  onStreamRead\x2C\x0d\n} = require('internal/stream_base_commons');\x0d\nconst {\x0d\n  kReadBytesOrError\x2C\x0d\n  streamBaseState\x2C\x0d\n} = internalBinding('stream_wrap');\x0d\nconst {\x0d\n  validateNumber\x2C\x0d\n  validateOneOf\x2C\x0d\n  validateString\x2C\x0d\n} = require('internal/validators');\x0d\nconst assert = require('internal/assert');\x0d\nconst { getOptionValue } = require('internal/options');\x0d\n\x0d\nconst kOnKeylog = Symbol('onkeylog');\x0d\nconst kRequestOptions = Symbol('requestOptions');\x0d\nconst kRequestAsyncResource = Symbol('requestAsyncResource');\x0d\nconst kFreeSocketDataGuard = Symbol('freeSocketDataGuard');\x0d\n\x0d\n// New Agent code.\x0d\n\x0d\n// The largest departure from the previous implementation is that\x0d\n// an Agent instance holds connections for a variable number of host:ports.\x0d\n// Surprisingly\x2C this is still API compatible as far as third parties are\x0d\n// concerned. The only code that really notices the difference is the\x0d\n// request object.\x0d\n\x0d\n// Another departure is that all code related to HTTP parsing is in\x0d\n// ClientRequest.onSocket(). The Agent is now *strictly*\x0d\n// concerned with managing a connection pool.\x0d\n\x0d\nclass ReusedHandle {\x0d\n  constructor(type\x2C handle) {\x0d\n    this.type = type;\x0d\n    this.handle = handle;\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction freeSocketErrorListener(err) {\x0d\n  const socket = this;\x0d\n  debug('SOCKET ERROR on FREE socket:'\x2C err.message\x2C err.stack);\x0d\n  socket.destroy();\x0d\n  socket.emit('agentRemove');\x0d\n}\x0d\n\x0d\n// Guard against unsolicited data arriving while a socket is idle in the\x0d\n// freeSockets pool.  When the HTTPParser is detached the data would sit\x0d\n// in the TCP buffer and be silently consumed as the response for the\x0d\n// *next* request that reuses the socket (response-queue poisoning).\x0d\n// See: https://hackerone.com/reports/3582376\x0d\nfunction freeSocketOnReadGuard() {\x0d\n  const nread = streamBaseState[kReadBytesOrError];\x0d\n  if (nread === 0) return;\x0d\n\x0d\n  debug('READ on FREE socket - destroying poisoned socket');\x0d\n  this[owner_symbol].destroy();\x0d\n}\x0d\n\x0d\nfunction installFreeSocketDataGuard(socket) {\x0d\n  if (socket.readableLength > 0) {\x0d\n    debug('BUFFERED DATA on FREE socket - destroying poisoned socket');\x0d\n    socket.destroy();\x0d\n    return;\x0d\n  }\x0d\n\x0d\n  if (socket.connecting) {\x0d\n    socket[kFreeSocketDataGuard] = function onConnect() {\x0d\n      socket[kFreeSocketDataGuard] = null;\x0d\n      installFreeSocketDataGuard(socket);\x0d\n    };\x0d\n    socket.once('connect'\x2C socket[kFreeSocketDataGuard]);\x0d\n    return;\x0d\n  }\x0d\n\x0d\n  const handle = socket._handle;\x0d\n  if (handle) {\x0d\n    handle.onread = freeSocketOnReadGuard;\x0d\n    if (!handle.reading) {\x0d\n      handle.reading = true;\x0d\n      const err = handle.readStart();\x0d\n      if (err) socket.destroy();\x0d\n    }\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction removeFreeSocketDataGuard(socket) {\x0d\n  if (socket[kFreeSocketDataGuard]) {\x0d\n    socket.removeListener('connect'\x2C socket[kFreeSocketDataGuard]);\x0d\n    socket[kFreeSocketDataGuard] = null;\x0d\n  }\x0d\n\x0d\n  const handle = socket._handle;\x0d\n  if (handle?.onread === freeSocketOnReadGuard) {\x0d\n    handle.onread = onStreamRead;\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction Agent(options) {\x0d\n  if (!(this instanceof Agent))\x0d\n    return new Agent(options);\x0d\n\x0d\n  EventEmitter.call(this);\x0d\n\x0d\n  this.options = { __proto__: null\x2C ...options };\x0d\n\x0d\n  this.defaultPort = this.options.defaultPort || 80;\x0d\n  this.protocol = this.options.protocol || 'http:';\x0d\n\x0d\n  if (this.options.noDelay === undefined)