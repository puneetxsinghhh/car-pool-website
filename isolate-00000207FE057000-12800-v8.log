script-source,105,file:///C:/Users/Basant/Desktop/NodeJS/Car-Pool-Website/src/adapters/outbound/persistence/MySQLUserRepository.js,import UserRepository from "../../../application/ports/UserRepository.js";\x0d\nimport mysqlPool from "../../../infrastructure/database/mysqlDb.js";\x0d\n\x0d\n// Outbound Adapter:\x0d\n// Implements the UserRepository port using MySQL.\x0d\nexport default class MySQLUserRepository extends UserRepository {\x0d\n\x0d\n    constructor() {\x0d\n        super();\x0d\n\x0d\n        this.pool = mysqlPool;\x0d\n    }\x0d\n\x0d\n    async create(user) {\x0d\n\x0d\n        const query = `\x0d\n            INSERT INTO users (name\x2C email\x2C role)\x0d\n            VALUES (?\x2C ?\x2C ?)\x0d\n        `;\x0d\n\x0d\n        const values = [\x0d\n            user.name\x2C\x0d\n            user.email\x2C\x0d\n            user.role\x0d\n        ];\x0d\n\x0d\n        const [result] = await this.pool.execute(query\x2C values);\x0d\n\x0d\n        return {\x0d\n            id: result.insertId\x2C\x0d\n            name: user.name\x2C\x0d\n            email: user.email\x2C\x0d\n            role: user.role\x0d\n        };\x0d\n    }\x0d\n\x0d\n    async findById(id) {\x0d\n\x0d\n        const query = `\x0d\n            SELECT id\x2C name\x2C email\x2C role\x0d\n            FROM users\x0d\n            WHERE id = ?\x0d\n        `;\x0d\n\x0d\n        const [rows] = await this.pool.execute(query\x2C [id]);\x0d\n\x0d\n        return rows[0] || null;\x0d\n    }\x0d\n\x0d\n    async findAll() {\x0d\n\x0d\n        const query = `\x0d\n            SELECT id\x2C name\x2C email\x2C role\x0d\n            FROM users\x0d\n            ORDER BY id\x0d\n        `;\x0d\n\x0d\n        const [rows] = await this.pool.execute(query);\x0d\n\x0d\n        return rows;\x0d\n    }\x0d\n\x0d\n    async getDriverSummary(driverId) {\x0d\n\x0d\n    const query = `\x0d\n        SELECT\x0d\n            u.id AS driver_id\x2C\x0d\n            u.name AS driver_name\x2C\x0d\n\x0d\n            COUNT(DISTINCT r.id) AS total_rides\x2C\x0d\n\x0d\n            COUNT(DISTINCT b.passenger_id)\x0d\n                AS total_passengers\x2C\x0d\n\x0d\n            COALESCE(\x0d\n                SUM(r.total_seats)\x2C\x0d\n                0\x0d\n            ) AS total_seats\x2C\x0d\n\x0d\n            COALESCE(\x0d\n                SUM(r.available_seats)\x2C\x0d\n                0\x0d\n            ) AS available_seats\x0d\n\x0d\n        FROM users u\x0d\n\x0d\n        LEFT JOIN rides r\x0d\n            ON u.id = r.driver_id\x0d\n\x0d\n        LEFT JOIN bookings b\x0d\n            ON r.id = b.ride_id\x0d\n\x0d\n        WHERE u.id = ?\x0d\n          AND u.role = 'DRIVER'\x0d\n\x0d\n        GROUP BY\x0d\n            u.id\x2C\x0d\n            u.name\x0d\n    `;\x0d\n\x0d\n    const [rows] = await this.pool.query(\x0d\n        query\x2C\x0d\n        [driverId]\x0d\n    );\x0d\n\x0d\n    if (rows.length === 0) {\x0d\n        return null;\x0d\n    }\x0d\n\x0d\n    const row = rows[0];\x0d\n\x0d\n    return {\x0d\n        driverId: row.driver_id\x2C\x0d\n        driverName: row.driver_name\x2C\x0d\n        totalRides: Number(row.total_rides)\x2C\x0d\n        totalPassengers: Number(row.total_passengers)\x2C\x0d\n        totalSeats: Number(row.total_seats)\x2C\x0d\n        availableSeats: Number(row.available_seats)\x0d\n    };\x0d\n    }\x0d\n\x0d\n\x0d\n}
