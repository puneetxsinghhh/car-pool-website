script-source,131,node:internal/abort_controller,'use strict';\x0d\n\x0d\n// Modeled very closely on the AbortController implementation\x0d\n// in https://github.com/mysticatea/abort-controller (MIT license)\x0d\n\x0d\nconst {\x0d\n  ArrayPrototypePush\x2C\x0d\n  ObjectAssign\x2C\x0d\n  ObjectDefineProperties\x2C\x0d\n  ObjectDefineProperty\x2C\x0d\n  ObjectSetPrototypeOf\x2C\x0d\n  PromiseResolve\x2C\x0d\n  PromiseWithResolvers\x2C\x0d\n  SafeFinalizationRegistry\x2C\x0d\n  SafeSet\x2C\x0d\n  SafeWeakRef\x2C\x0d\n  Symbol\x2C\x0d\n  SymbolToStringTag\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst {\x0d\n  defineEventHandler\x2C\x0d\n  EventTarget\x2C\x0d\n  Event\x2C\x0d\n  kTrustEvent\x2C\x0d\n  kNewListener\x2C\x0d\n  kRemoveListener\x2C\x0d\n  kResistStopPropagation\x2C\x0d\n  kWeakHandler\x2C\x0d\n} = require('internal/event_target');\x0d\nconst { kMaxEventTargetListeners } = require('events');\x0d\nconst {\x0d\n  customInspectSymbol\x2C\x0d\n  kEmptyObject\x2C\x0d\n  kEnumerableProperty\x2C\x0d\n} = require('internal/util');\x0d\nconst { inspect } = require('internal/util/inspect');\x0d\nconst {\x0d\n  codes: {\x0d\n    ERR_ILLEGAL_CONSTRUCTOR\x2C\x0d\n    ERR_INVALID_ARG_TYPE\x2C\x0d\n    ERR_INVALID_THIS\x2C\x0d\n  }\x2C\x0d\n} = require('internal/errors');\x0d\nconst {\x0d\n  converters\x2C\x0d\n  createInterfaceConverter\x2C\x0d\n  createSequenceConverter\x2C\x0d\n} = require('internal/webidl');\x0d\n\x0d\nconst {\x0d\n  validateObject\x2C\x0d\n  validateUint32\x2C\x0d\n  kValidateObjectAllowObjects\x2C\x0d\n} = require('internal/validators');\x0d\n\x0d\nconst {\x0d\n  DOMException\x2C\x0d\n} = internalBinding('messaging');\x0d\n\x0d\nconst {\x0d\n  clearTimeout\x2C\x0d\n  setTimeout\x2C\x0d\n} = require('timers');\x0d\nconst assert = require('internal/assert');\x0d\n\x0d\nconst {\x0d\n  kDeserialize\x2C\x0d\n  kTransfer\x2C\x0d\n  kTransferList\x2C\x0d\n  markTransferMode\x2C\x0d\n} = require('internal/worker/js_transferable');\x0d\n\x0d\nlet _MessageChannel;\x0d\n\x0d\nconst kDontThrowSymbol = Symbol('kDontThrowSymbol');\x0d\n\x0d\n// Loading the MessageChannel and markTransferable have to be done lazily\x0d\n// because otherwise we'll end up with a require cycle that ends up with\x0d\n// an incomplete initialization of abort_controller.\x0d\n\x0d\nfunction lazyMessageChannel() {\x0d\n  _MessageChannel ??= require('internal/worker/io').MessageChannel;\x0d\n  return new _MessageChannel();\x0d\n}\x0d\n\x0d\nconst clearTimeoutRegistry = new SafeFinalizationRegistry(clearTimeout);\x0d\nconst dependantSignalsCleanupRegistry = new SafeFinalizationRegistry(\x0d\n  ({ sourceSignalRef\x2C dependantSignalRef\x2C sourceSignalsCleanupToken }) => {\x0d\n    sourceSignalsCleanupRegistry.unregister(sourceSignalsCleanupToken);\x0d\n\x0d\n    const sourceSignal = sourceSignalRef.deref();\x0d\n    if (sourceSignal === undefined) {\x0d\n      return;\x0d\n    }\x0d\n    sourceSignal[kDependantSignals].delete(dependantSignalRef);\x0d\n  });\x0d\n\x0d\nconst gcPersistentSignals = new SafeSet();\x0d\n\x0d\nconst sourceSignalsCleanupRegistry = new SafeFinalizationRegistry(({ sourceSignalRef\x2C composedSignalRef }) => {\x0d\n  const composedSignal = composedSignalRef.deref();\x0d\n  if (composedSignal !== undefined) {\x0d\n    composedSignal[kSourceSignals].delete(sourceSignalRef);\x0d\n\x0d\n    if (composedSignal[kSourceSignals].size === 0) {\x0d\n      // This signal will no longer abort. There's no need to keep it in the gcPersistentSignals set.\x0d\n      gcPersistentSignals.delete(composedSignal);\x0d\n    }\x0d\n  }\x0d\n});\x0d\n\x0d\nconst kAborted = Symbol('kAborted');\x0d\nconst kReason = Symbol('kReason');\x0d\nconst kCloneData = Symbol('kCloneData');\x0d\nconst kTimeout = Symbol('kTimeout');\x0d\nconst kMakeTransferable = Symbol('kMakeTransferable');\x0d\nconst kComposite = Symbol('kComposite');\x0d\nconst kFollowing = Symbol('kFollowing');\x0d\nconst kResultSignalWeakRef = Symbol('kResultSignalWeakRef');\x0d\nconst kSourceSigna