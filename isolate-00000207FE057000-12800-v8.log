script-source,372,C:\\Users\\Basant\\Desktop\\NodeJS\\Car-Pool-Website\\node_modules\\.pnpm\\mysql2@3.24.1_@types+node@26.2.0\\node_modules\\mysql2\\lib\\packets\\typed_parameter.js,'use strict';\n\nconst Types = require('../constants/types.js');\nconst Packet = require('./packet.js');\nconst StringParser = require('../parsers/string.js');\n\nconst INTEGER_BYTES = {\n  [Types.TINY]: 1\x2C\n  [Types.SHORT]: 2\x2C\n  [Types.YEAR]: 2\x2C\n  [Types.INT24]: 4\x2C\n  [Types.LONG]: 4\x2C\n  [Types.LONGLONG]: 8\x2C\n};\n\nconst TEMPORAL = [Types.DATE\x2C Types.DATETIME\x2C Types.TIMESTAMP];\n\n// MySQL rejects INT24\x2C YEAR\x2C ENUM\x2C SET\x2C BIT and GEOMETRY as bind types\x2C and\n// MariaDB rejects JSON and VECTOR. Each is transmitted as the narrowest type\n// both servers accept\x2C which carries the same value.\nconst WIRE_TYPE = {\n  [Types.INT24]: Types.LONG\x2C\n  [Types.YEAR]: Types.SHORT\x2C\n  [Types.ENUM]: Types.STRING\x2C\n  [Types.SET]: Types.STRING\x2C\n  [Types.VECTOR]: Types.BLOB\x2C\n};\n\n// Only these may be adopted from a server hint: they are valid bind types on\n// every server\x2C so upgrading can never make a working statement fail.\nconst HINT_UPGRADABLE = new Set([\n  Types.TINY\x2C\n  Types.SHORT\x2C\n  Types.LONG\x2C\n  Types.LONGLONG\x2C\n]);\n\nconst LENGTH_CODED = [\n  Types.DECIMAL\x2C\n  Types.NEWDECIMAL\x2C\n  Types.VARCHAR\x2C\n  Types.VAR_STRING\x2C\n  Types.STRING\x2C\n  Types.ENUM\x2C\n  Types.SET\x2C\n  Types.JSON\x2C\n  Types.VECTOR\x2C\n  Types.TINY_BLOB\x2C\n  Types.MEDIUM_BLOB\x2C\n  Types.LONG_BLOB\x2C\n  Types.BLOB\x2C\n];\n\nfunction writeNothing() {}\n\nconst TIME_PATTERN = /^(-)?(\\d+):([0-5]?\\d):([0-5]?\\d)(?:\\.(\\d{1\x2C6}))?$/;\n\nclass TypedParameter {\n  constructor(type\x2C value\x2C unsigned) {\n    this.type = type;\n    this.value = value;\n    this.unsigned = unsigned;\n  }\n\n  [Symbol.for('nodejs.util.inspect.custom')]() {\n    const name = Types[this.type] || `0x${this.type.toString(16)}`;\n    return `${name}${this.unsigned ? ' UNSIGNED' : ''}(${String(this.value)})`;\n  }\n}\n\nfunction toInteger(value\x2C name) {\n  switch (typeof value) {\n    case 'bigint':\n      return value;\n    case 'boolean':\n      return value ? 1n : 0n;\n    case 'number':\n      if (!Number.isInteger(value)) {\n        throw new TypeError(\n          `${name} parameter must be an integer\x2C got ${value}`\n        );\n      }\n      if (!Number.isSafeInteger(value)) {\n        throw new RangeError(\n          `${name} parameter ${value} exceeds Number.MAX_SAFE_INTEGER and has already lost precision; pass a string or BigInt instead`\n        );\n      }\n      return BigInt(value);\n    case 'string':\n      try {\n        return BigInt(value.trim());\n      } catch (cause) {\n        throw new TypeError(\n          `${name} parameter must be an integer\x2C got ${JSON.stringify(value)}`\x2C\n          { cause }\n        );\n      }\n    default:\n      throw new TypeError(\n        `${name} parameter must be an integer\x2C got ${typeof value}`\n      );\n  }\n}\n\nfunction checkedInteger(value\x2C type\x2C bytes\x2C unsigned) {\n  const name = Types[type];\n  const bits = BigInt(bytes * 8);\n  const n = toInteger(value\x2C name);\n  const min = unsigned ? 0n : -(1n << (bits - 1n));\n  const max = unsigned ? (1n << bits) - 1n : (1n << (bits - 1n)) - 1n;\n  if (n < min || n > max) {\n    throw new RangeError(\n      `${name}${unsigned ? ' UNSIGNED' : ''} parameter out of range: ${n} is not within ${min}..${max}`\n    );\n  }\n  return n;\n}\n\n// The server reports an integer type whenever it knows a placeholder holds one\x2C\n// and MySQL rejects a DOUBLE in some of those positions. Adopting the hint is\n// only safe when the value is already an integer that fits\x2C so every other case\n// returns null and keeps the type inferred from JavaScript.\nfunction integerHint(value\x2C type\x2C unsigned) {\n  const bytes = INTEGER_BYTES[type];\n  if (!bytes || !HINT_UPGRADABLE.has(type)) {\n    return null;\n  }\n  let n;\n  if (typeof value === 'bigint') {\n    n = value;\n  } else if (typeof value === 'boolean') {\n    n = value ? 1n : 0n;\n  } else if (typeof value === 'number' && Number.isSafeInteger(value)) {\n    n = BigInt(value);\n  } else {\n    return null;\n  }\n  const bits = BigInt(bytes * 8);\n  const min = unsigned ? 0n : -(1n << (bits - 1n));\n  const max = unsigned ? (1n << bits) - 1n : (1n << (bits - 1n)) - 1n;\n  if (n < min || n > max) {\n    return null;\n  }\n  return new TypedParameter(type\x2C n\x2C unsigned);\n}\n\nfunction wireType(type\x2C jsonAsString) {\n  if (type === Types.JSON && jsonAsString) {\n    return Types.VAR_STRING;\n  }\n  return WIRE_TYPE[type] || type;\n}\n\nfunction integerEncoder(type\x2C bytes) {\n  return (value\x2C unsigned) => {\n    const wire = BigInt.asUintN(\n      bytes * 8\x2C\n      checkedInteger(value\x2C type\x2C bytes\x2C unsigned)\n    );\n    return {\n      value: bytes === 8 ? wire : Number(wire)\x2C\n      length: bytes\x2C\n      writer(v) {\n        this.writeUIntLE(v\x2C bytes);\n      }\x2C\n    };\n  };\n}\n\nfunction toDate(value\x2C name) {\n  const date = value instanceof Date ? value : new Date(value);\n  if (Number.isNaN(date.getTime())) {\n    throw new TypeError(\n      `${name} parameter must be a valid Date\x2C got ${String(value)}`\n    );\n  }\n  return date;\n}\n\nfunction temporalEncoder(type\x2C timezone) {\n  const name = Types[type];\n  return (value) => ({\n    value: toDate(value\x2C name)\x2C\n    length: 12\x2C\n    writer(v) {\n      this.writeDate(v\x2C timezone);\n    }\x2C\n  });\n}\n\nfunction toTimeParts(value) {\n  if (typeof value === 'number') {\n    const negative = value < 0;\n    let rest = Math.abs(value);\n    const microseconds = Math.round((rest % 1000) * 1000);\n    rest = Math.floor(rest / 1000);\n    const seconds = rest % 60;\n    const minutes = Math.floor(rest / 60) % 60;\n    const totalHours = Math.floor(rest / 3600);\n    return {\n      negative\x2C\n      days: Math.floor(totalHours / 24)\x2C\n      hours: totalHours % 24\x2C\n      minutes\x2C\n      seconds\x2C\n      microseconds\x2C\n    };\n  }\n  const match = TIME_PATTERN.exec(String(value));\n  if (!match) {\n    throw new TypeError(\n      `TIME parameter must be 'HH:MM:SS[.ffffff]' or milliseconds\x2C got ${JSON.stringify(String(value))}`\n    );\n  }\n  const hours = Number(match[2]);\n  return {\n    negative: Boolean(match[1])\x2C\n    days: Math.floor(hours / 24)\x2C\n    hours: hours % 24\x2C\n    minutes: Number(match[3])\x2C\n    seconds: Number(match[4])\x2C\n    microseconds: match[5] ? Number(match[5].padEnd(6\x2C '0')) : 0\x2C\n  };\n}\n\nfunction timeEncoder() {\n  return (value) => {\n    const parts = toTimeParts(value);\n    return {\n      value: parts\x2C\n      length: Packet.timeLength(parts)\x2C\n      writer(v) {\n        this.writeTime(v);\n      }\x2C\n    };\n  };\n}\n\nfunction lengthCodedEncoder(encoding) {\n  return (value) => {\n    if (!Buffer.isBuffer(value)) {\n      const string = typeof value === 'string' ? value : String(value);\n      if (\n        StringParser.hasFastUtf8Write &&\n        (encoding === 'utf8' || encoding === 'utf-8')\n      ) {\n        const byteLength = Buffer.byteLength(string\x2C 'utf8');\n        return {\n          value: string\x2C\n          length: Packet.lengthCodedNumberLength(byteLength) + byteLength\x2C\n          byteLength\x2C\n          writer: Packet.prototype.writeLengthCodedUtf8String\x2C\n        };\n      }\n      value = StringParser.encode(string\x2C encoding);\n    }\n    return {\n      value\x2C\n      length: Packet.lengthCodedNumberLength(value.length) + value.length\x2C\n      writer: Packet.prototype.writeLengthCodedBuffer\x2C\n    };\n  };\n}\n\nfunction jsonEncoder(encoding) {\n  const encodeText = lengthCodedEncoder(encoding);\n  return (value) =>\n    encodeText(\n      typeof value === 'string' || Buffer.isBuffer(value)\n        ? value\n        : JSON.stringify(value)\n    );\n}\n\nfunction encoderFor(type\x2C encoding\x2C timezone) {\n  if (INTEGER_BYTES[type]) {\n    return integerEncoder(type\x2C INTEGER_BYTES[type]);\n  }\n  if (type === Types.DOUBLE) {\n    return (value) => ({\n      value: Number(value)\x2C\n      length: 8\x2C\n      writer: Packet.prototype.writeDouble\x2C\n    });\n  }\n  if (type === Types.FLOAT) {\n    return (value) => ({\n      value: Number(value)\x2C\n      length: 4\x2C\n      writer: Packet.prototype.writeFloat\x2C\n    });\n  }\n  if (TEMPORAL.includes(type)) {\n    return temporalEncoder(type\x2C timezone);\n  }\n  if (type === Types.TIME) {\n    return timeEncoder();\n  }\n  if (type === Types.JSON) {\n    return jsonEncoder(encoding);\n  }\n  if (LENGTH_CODED.includes(type)) {\n    return lengthCodedEncoder(encoding);\n  }\n  throw new TypeError(\n    `No parameter encoder for MySQL type 0x${type.toString(16)}`\n  );\n}\n\nfunction encodeTypedParameter(parameter\x2C encoding\x2C timezone\x2C jsonAsString) {\n  if (parameter.value === null || parameter.type === Types.NULL) {\n    return {\n      value: ''\x2C\n      type: wireType(parameter.type\x2C jsonAsString)\x2C\n      length: 0\x2C\n      writer: writeNothing\x2C\n      unsigned: parameter.unsigned\x2C\n      isNull: true\x2C\n    };\n  }\n  const encoded = encoderFor(\n    parameter.type\x2C\n    encoding\x2C\n    timezone\n  )(parameter.value\x2C parameter.unsigned);\n  return {\n    ...encoded\x2C\n    type: wireType(parameter.type\x2C jsonAsString)\x2C\n    unsigned: parameter.unsigned\x2C\n  };\n}\n\nconst ALIASES = {\n  MEDIUMTEXT: 'MEDIUM_BLOB'\x2C\n  LONGTEXT: 'LONG_BLOB'\x2C\n  TINYINT: 'TINY'\x2C\n  SMALLINT: 'SHORT'\x2C\n  MEDIUMINT: 'INT24'\x2C\n  INT: 'LONG'\x2C\n  INTEGER: 'LONG'\x2C\n  BIGINT: 'LONGLONG'\x2C\n  REAL: 'DOUBLE'\x2C\n  CHAR: 'STRING'\x2C\n  VARBINARY: 'VAR_STRING'\x2C\n  BINARY: 'STRING'\x2C\n  TEXT: 'BLOB'\x2C\n};\n\nconst SUPPORTED = [\n  ...Object.keys(INTEGER_BYTES)\x2C\n  Types.FLOAT\x2C\n  Types.DOUBLE\x2C\n  Types.TIME\x2C\n  ...TEMPORAL\x2C\n  ...LENGTH_CODED\x2C\n].map(Number);\n\nconst types = Object.create(null);\n\nfor (const type of SUPPORTED) {\n  const name = Types[type];\n  const bytes = INTEGER_BYTES[type];\n  const build = bytes\n    ? (value\x2C unsigned) =>\n        new TypedParameter(\n          type\x2C\n          value === null ? null : checkedInteger(value\x2C type\x2C bytes\x2C unsigned)\x2C\n          unsigned\n        )\n    : (value\x2C unsigned) => new TypedParameter(type\x2C value\x2C unsigned);\n  const factory = (value) => build(value\x2C false);\n  if (bytes) {\n    factory.unsigned = (value) => build(value\x2C true);\n  }\n  types[name] = factory;\n}\n\ntypes.NULL = () => new TypedParameter(Types.NULL\x2C null\x2C false);\n\nfor (const [alias\x2C target] of Object.entries(ALIASES)) {\n  if (types[target] && !types[alias]) {\n    types[alias] = types[target];\n  }\n}\n\nmodule.exports = {\n  TypedParameter\x2C\n  encodeTypedParameter\x2C\n  integerHint\x2C\n  types\x2C\n};\n
