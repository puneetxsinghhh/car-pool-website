script-source,451,<unknown>,(function anonymous(\n) {\nreturn ((function () {\n  return class TextRow {\n    constructor(fields) {\n    }\n    next(packet\x2C fields\x2C options) {\n      this.packet = packet;\n      const result = {};\n      result["ride_id"] = packet.parseLengthCodedIntNoBigCheck();\n      result["origin"] = packet.readLengthCodedString(fields[1].encoding);\n      result["destination"] = packet.readLengthCodedString(fields[2].encoding);\n      result["total_seats"] = packet.parseLengthCodedIntNoBigCheck();\n      result["available_seats"] = packet.parseLengthCodedIntNoBigCheck();\n      result["driver_id"] = packet.parseLengthCodedIntNoBigCheck();\n      result["driver_name"] = packet.readLengthCodedString(fields[6].encoding);\n      result["driver_email"] = packet.readLengthCodedString(fields[7].encoding);\n      result["passenger_id"] = packet.parseLengthCodedIntNoBigCheck();\n      result["passenger_name"] = packet.readLengthCodedString(fields[9].encoding);\n      result["passenger_email"] = packet.readLengthCodedString(fields[10].encoding);\n      return result;\n    }\n  };\n})())\n})
