script-source,112,file:///C:/Users/Basant/Desktop/NodeJS/Car-Pool-Website/src/application/useCases/JoinRide.js,export default class JoinRide {\x0d\n\x0d\n    constructor(\x0d\n        rideRepository\x2C\x0d\n        userRepository\x0d\n    ) {\x0d\n        this.rideRepository = rideRepository;\x0d\n        this.userRepository = userRepository;\x0d\n    }\x0d\n\x0d\n    async execute(rideId\x2C passengerId) {\x0d\n\x0d\n        // 1. Verify passenger\x0d\n        const passenger =\x0d\n            await this.userRepository.findById(passengerId);\x0d\n\x0d\n        if (!passenger) {\x0d\n            throw new Error("Passenger not found");\x0d\n        }\x0d\n\x0d\n        if (passenger.role !== "PASSENGER") {\x0d\n            throw new Error(\x0d\n                "User is not registered as a passenger"\x0d\n            );\x0d\n        }\x0d\n\x0d\n        // 2. Get ride\x0d\n        const ride =\x0d\n            await this.rideRepository.findById(rideId);\x0d\n\x0d\n        if (!ride) {\x0d\n            throw new Error("Ride not found");\x0d\n        }\x0d\n\x0d\n        // 3. Domain business rule\x0d\n        ride.join();\x0d\n\x0d\n        // 4. Atomic persistence operation\x0d\n        return await this.rideRepository.joinRide(\x0d\n            rideId\x2C\x0d\n            passengerId\x0d\n        );\x0d\n    }\x0d\n}
