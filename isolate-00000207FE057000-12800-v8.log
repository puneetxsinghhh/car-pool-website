d\n        (key) => JSONStringify(key) + JSONStringify(importAttributes[key]))\x2C\x0d\n      '\x2C');\x0d\n  }\x0d\n\x0d\n  #getModuleCachedImports(parentURL) {\x0d\n    let internalCache = super.get(parentURL);\x0d\n    if (internalCache == null) {\x0d\n      super.set(parentURL\x2C internalCache = { __proto__: null });\x0d\n    }\x0d\n    return internalCache;\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * @param {string} serializedKey\x0d\n   * @param {string} parentURL\x0d\n   * @returns {import('./loader').ModuleExports | Promise<import('./loader').ModuleExports>}\x0d\n   */\x0d\n  get(serializedKey\x2C parentURL) {\x0d\n    return this.#getModuleCachedImports(parentURL)[serializedKey];\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * @param {string} serializedKey\x0d\n   * @param {string} parentURL\x0d\n   * @param {{ format: string\x2C url: URL['href'] }} result\x0d\n   * @returns {ResolveCache}\x0d\n   */\x0d\n  set(serializedKey\x2C parentURL\x2C result) {\x0d\n    this.#getModuleCachedImports(parentURL)[serializedKey] = result;\x0d\n    return this;\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * @param {string} serializedKey\x0d\n   * @param {URL|string} parentURL\x0d\n   * @returns {boolean}\x0d\n   */\x0d\n  has(serializedKey\x2C parentURL) {\x0d\n    return serializedKey in this.#getModuleCachedImports(parentURL);\x0d\n  }\x0d\n}\x0d\n\x0d\n/**\x0d\n * Cache the results of the `load` step of the module resolution and loading process.\x0d\n */\x0d\nclass LoadCache extends SafeMap {\x0d\n  get(url\x2C type = kImplicitTypeAttribute) {\x0d\n    validateString(url\x2C 'url');\x0d\n    validateString(type\x2C 'type');\x0d\n    return super.get(url)?.[type];\x0d\n  }\x0d\n  set(url\x2C type = kImplicitTypeAttribute\x2C job) {\x0d\n    validateString(url\x2C 'url');\x0d\n    validateString(type\x2C 'type');\x0d\n\x0d\n    const { ModuleJobBase } = require('internal/modules/esm/module_job');\x0d\n    if (job instanceof ModuleJobBase !== true &&\x0d\n        typeof job !== 'function') {\x0d\n      throw new ERR_INVALID_ARG_TYPE('job'\x2C 'ModuleJob'\x2C job);\x0d\n    }\x0d\n    debug(`Storing ${url} (${\x0d\n      type === kImplicitTypeAttribute ? 'implicit type' : type\x0d\n    }) in ModuleLoadMap`);\x0d\n    const cachedJobsForUrl = super.get(url) ?? { __proto__: null };\x0d\n    cachedJobsForUrl[type] = job;\x0d\n    return super.set(url\x2C cachedJobsForUrl);\x0d\n  }\x0d\n  has(url\x2C type = kImplicitTypeAttribute) {\x0d\n    validateString(url\x2C 'url');\x0d\n    validateString(type\x2C 'type');\x0d\n    return super.get(url)?.[type] !== undefined;\x0d\n  }\x0d\n  delete(url\x2C type = kImplicitTypeAttribute) {\x0d\n    const cached = super.get(url);\x0d\n    if (cached) {\x0d\n      cached[type] = undefined;\x0d\n    }\x0d\n  }\x0d\n}\x0d\n\x0d\nmodule.exports = {\x0d\n  LoadCache\x2C\x0d\n  ResolveCache\x2C\x0d\n};\x0d\n
