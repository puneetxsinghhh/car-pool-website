script-source,89,file:///C:/Users/Basant/Desktop/NodeJS/Car-Pool-Website/src/app.js,import express from "express";\x0d\n\x0d\n// Database\x0d\nimport pool from "./infrastructure/database/db.js";\x0d\nimport mysqlPool from "./infrastructure/database/mysqlDb.js";\x0d\n\x0d\n\x0d\n// PostgresSQL Outbound adapters\x0d\nimport PostgreSQLUserRepository\x0d\n    from "./adapters/outbound/persistence/PostgreSQLUserRepository.js";\x0d\n\x0d\nimport PostgreSQLRideRepository\x0d\n    from "./adapters/outbound/persistence/PostgreSQLRideRepository.js";\x0d\n\x0d\nimport PostgreSQLBookingRepository\x0d\n    from "./adapters/outbound/persistence/PostgreSQLBookingRepository.js";\x0d\n\x0d\n// MySQL outbound adapters\x0d\nimport MySQLUserRepository\x0d\n    from "./adapters/outbound/persistence/MySQLUserRepository.js";\x0d\n\x0d\nimport MySQLRideRepository\x0d\n    from "./adapters/outbound/persistence/MySQLRideRepository.js";\x0d\n\x0d\nimport MySQLBookingRepository\x0d\n    from "./adapters/outbound/persistence/MySQLBookingRepository.js";    \x0d\n\x0d\n// Use cases\x0d\nimport CreateUser\x0d\n    from "./application/useCases/CreateUser.js";\x0d\n\x0d\nimport CreateRide\x0d\n    from "./application/useCases/CreateRide.js";\x0d\n\x0d\nimport GetRides\x0d\n    from "./application/useCases/GetRides.js";\x0d\n\x0d\nimport GetRideById\x0d\n    from "./application/useCases/GetRideById.js";\x0d\n\x0d\nimport JoinRide\x0d\n    from "./application/useCases/JoinRide.js";\x0d\n\x0d\nimport GetUserRides\x0d\n    from "./application/useCases/GetUserRides.js";\x0d\n\x0d\nimport GetRideDetails\x0d\n    from "./application/useCases/GetRideDetails.js";    \x0d\n\x0d\nimport GetDriverSummary\x0d\n    from "./application/useCases/GetDriverSummary.js";\x0d\n\x0d\n\x0d\n// Controllers\x0d\nimport UserController\x0d\n    from "./adapters/inbound/http/controllers/UserController.js";\x0d\n\x0d\nimport RideController\x0d\n    from "./adapters/inbound/http/controllers/RideController.js";\x0d\n\x0d\n// Routes\x0d\nimport createUserRoutes\x0d\n    from "./adapters/inbound/http/routes/userRoutes.js";\x0d\n\x0d\nimport createRideRoutes\x0d\n    from "./adapters/inbound/http/routes/rideRoutes.js";\x0d\n\x0d\n// Error - Handler\x0d\nimport errorHandler\x0d\n    from "./adapters/inbound/http/errors/errorHandler.js";    \x0d\n\x0d\n\x0d\nconst app = express();\x0d\n\x0d\nconst PORT = 3000;\x0d\n\x0d\n\x0d\n// --------------------------------------------------\x0d\n// Middleware\x0d\n// --------------------------------------------------\x0d\n\x0d\napp.use(express.json());\x0d\n\x0d\n\x0d\n// --------------------------------------------------\x0d\n// Outbound Adapters / Repositories\x0d\n// --------------------------------------------------\x0d\n\x0d\n// // postgres\x0d\n\x0d\n// const userRepository =\x0d\n//     new PostgreSQLUserRepository(pool);\x0d\n\x0d\n// const rideRepository =\x0d\n//     new PostgreSQLRideRepository(pool);\x0d\n\x0d\n// const bookingRepository =\x0d\n//     new PostgreSQLBookingRepository(pool);\x0d\n\x0d\n\x0d\n// sql   \x0d\nconst userRepository =\x0d\n    new MySQLUserRepository();\x0d\n\x0d\nconst rideRepository =\x0d\n    new MySQLRideRepository();\x0d\n\x0d\nconst bookingRepository =\x0d\n    new MySQLBookingRepository(); \x0d\n\x0d\n// --------------------------------------------------\x0d\n// Use Cases\x0d\n// --------------------------------------------------\x0d\n\x0d\nconst createUser =\x0d\n    new CreateUser(userRepository);\x0d\n\x0d\nconst createRide =\x0d\n    new CreateRide(\x0d\n        rideRepository\x2C\x0d\n        userRepository\x0d\n    );\x0d\n\x0d\nconst getRides =\x0d\n    new GetRides(rideRepository);\x0d\n\x0d\nconst getRideById =\x0d\n    new GetRideById(rideRepository);\x0d\n\x0d\nconst joinRide =\x0d\n    new JoinRide(\x0d\n        rideRepository\x2C\x0d\n        userRepository\x0d\n        // bookingRepository\x0d\n    );\x0d\n\x0d\nconst getUserRides =\x0d\n    new GetUserRides(bookingRepository);\x0d\n\x0d\nconst getRideDetails = \x0d\n    new GetRideDetails(rideRepository);    \x0d\n\x0d\nconst getDriverSummary =\x0d\n    new GetDriverSummary(userRepository);\x0d\n\x0d\n// --------------------------------------------------\x0d\n// Controllers\x0d\n// --------------------------------------------------\x0d\n\x0d\nconst userController =\x0d\n    new UserController(\x0d\n        createUser\x2C\x0d\n        getUserRides\x2C \x0d\n        getDriverSummary\x0d\n    );\x0d\n\x0d\nconst rideController =\x0d\n    new RideController(\x0d\n        createRide\x2C\x0d\n        getRides\x2C\x0d\n        getRideById\x2C\x0d\n        joinRide\x2C \x0d\n        getRideDetails\x0d\n    );\x0d\n\x0d\n\x0d\n// --------------------------------------------------\x0d\n// Routes\x0d\n// --------------------------------------------------\x0d\n\x0d\napp.use(\x0d\n    "/api/users"\x2C\x0d\n    createUserRoutes(userController)\x0d\n);\x0d\n\x0d\napp.use(\x0d\n    "/api/rides"\x2C\x0d\n    createRideRoutes(rideController)\x0d\n);\x0d\n\x0d\n// --------------------------------------------------\x0d\n// Health Check\x0d\n// --------------------------------------------------\x0d\n\x0d\napp.get("/"\x2C (req\x2C res) => {\x0d\n    res.json({\x0d\n        message: "Car Pool API is running"\x0d\n    });\x0d\n});\x0d\n\x0d\n\x0d\n// --------------------------------------------------\x0d\n// Error Handler\x0d\n// --------------------------------------------------\x0d\napp.use(errorHandler); \x0d\n\x0d\n\x0d\n// --------------------------------------------------\x0d\n// Start Server\x0d\n// --------------------------------------------------\x0d\napp.listen(PORT\x2C () => {\x0d\n    console.log(\x0d\n        `Car Pool API running on http://localhost:${PORT}`\x0d\n    );\x0d\n});\x0d\n
