script-source,239,node:_http_client,// Copyright Joyent\x2C Inc. and other Node contributors.\x0d\n//\x0d\n// Permission is hereby granted\x2C free of charge\x2C to any person obtaining a\x0d\n// copy of this software and associated documentation files (the\x0d\n// "Software")\x2C to deal in the Software without restriction\x2C including\x0d\n// without limitation the rights to use\x2C copy\x2C modify\x2C merge\x2C publish\x2C\x0d\n// distribute\x2C sublicense\x2C and/or sell copies of the Software\x2C and to permit\x0d\n// persons to whom the Software is furnished to do so\x2C subject to the\x0d\n// following conditions:\x0d\n//\x0d\n// The above copyright notice and this permission notice shall be included\x0d\n// in all copies or substantial portions of the Software.\x0d\n//\x0d\n// THE SOFTWARE IS PROVIDED "AS IS"\x2C WITHOUT WARRANTY OF ANY KIND\x2C EXPRESS\x0d\n// OR IMPLIED\x2C INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF\x0d\n// MERCHANTABILITY\x2C FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN\x0d\n// NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM\x2C\x0d\n// DAMAGES OR OTHER LIABILITY\x2C WHETHER IN AN ACTION OF CONTRACT\x2C TORT OR\x0d\n// OTHERWISE\x2C ARISING FROM\x2C OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE\x0d\n// USE OR OTHER DEALINGS IN THE SOFTWARE.\x0d\n\x0d\n'use strict';\x0d\n\x0d\nconst {\x0d\n  ArrayIsArray\x2C\x0d\n  Boolean\x2C\x0d\n  Error\x2C\x0d\n  NumberIsFinite\x2C\x0d\n  ObjectAssign\x2C\x0d\n  ObjectDefineProperty\x2C\x0d\n  ObjectKeys\x2C\x0d\n  ObjectSetPrototypeOf\x2C\x0d\n  ReflectApply\x2C\x0d\n  String\x2C\x0d\n  Symbol\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst net = require('net');\x0d\nconst assert = require('internal/assert');\x0d\nconst {\x0d\n  kEmptyObject\x2C\x0d\n  once\x2C\x0d\n} = require('internal/util');\x0d\nconst {\x0d\n  _checkIsHttpToken: checkIsHttpToken\x2C\x0d\n  freeParser\x2C\x0d\n  parsers\x2C\x0d\n  HTTPParser\x2C\x0d\n  calculateLenientFlags\x2C\x0d\n  prepareError\x2C\x0d\n  kSkipPendingData\x2C\x0d\n} = require('_http_common');\x0d\nconst {\x0d\n  kUniqueHeaders\x2C\x0d\n  parseUniqueHeadersOption\x2C\x0d\n  OutgoingMessage\x2C\x0d\n} = require('_http_outgoing');\x0d\nconst Agent = require('_http_agent');\x0d\nconst { Buffer } = require('buffer');\x0d\nconst { defaultTriggerAsyncIdScope } = require('internal/async_hooks');\x0d\nconst { URL\x2C urlToHttpOptions\x2C isURL } = require('internal/url');\x0d\nconst {\x0d\n  kOutHeaders\x2C\x0d\n  kNeedDrain\x2C\x0d\n  isTraceHTTPEnabled\x2C\x0d\n  traceBegin\x2C\x0d\n  traceEnd\x2C\x0d\n  getNextTraceEventId\x2C\x0d\n  kProxyConfig\x2C\x0d\n  checkShouldUseProxy\x2C\x0d\n} = require('internal/http');\x0d\nconst {\x0d\n  ConnResetException\x2C\x0d\n  codes: {\x0d\n    ERR_HTTP_HEADERS_SENT\x2C\x0d\n    ERR_INVALID_ARG_TYPE\x2C\x0d\n    ERR_INVALID_ARG_VALUE\x2C\x0d\n    ERR_INVALID_HTTP_TOKEN\x2C\x0d\n    ERR_INVALID_PROTOCOL\x2C\x0d\n    ERR_UNESCAPED_CHARACTERS\x2C\x0d\n  }\x2C\x0d\n} = require('internal/errors');\x0d\nconst {\x0d\n  validateInteger\x2C\x0d\n  validateBoolean\x2C\x0d\n  validateOneOf\x2C\x0d\n  validatePort\x2C\x0d\n  validateString\x2C\x0d\n} = require('internal/validators');\x0d\nconst { getTimerDuration } = require('internal/timers');\x0d\nconst {\x0d\n  hasObserver\x2C\x0d\n  startPerf\x2C\x0d\n  stopPerf\x2C\x0d\n} = require('internal/perf/observe');\x0d\n\x0d\nconst kClientRequestStatistics = Symbol('ClientRequestStatistics');\x0d\n\x0d\nconst dc = require('diagnostics_channel');\x0d\nconst onClientRequestCreatedChannel = dc.channel('http.client.request.created');\x0d\nconst onClientRequestStartChannel = dc.channel('http.client.request.start');\x0d\nconst onClientRequestErrorChannel = dc.channel('http.client.request.error');\x0d\nconst onClientResponseFinishChannel = dc.channel('http.client.response.finish');\x0d\n\x0d\nfunction emitErrorEvent(request\x2C error) {\x0d\n  if (onClientRequestErrorChannel.hasSubscribers) {\x0d\n    onClientRequestErrorChannel.publish({\x0d\n      request\x2C\x0d\n      error\x2C\x0d\n    });\x0d\n  }\x0d\n  request.emit('error'\x2C error);\x0d\n}\x0d\n\x0d\nconst { addAbortSignal\x2C finished } = require('stream');\x0d\n\x0d\nlet debug = require('internal/util/debuglog').debuglog('http'\x2C (fn) => {\x0d\n  debug = fn;\x0d\n});\x0d\n\x0d\nconst INVALID_PATH_REGEX = /[^\\u0021-\\u00ff]/;\x0d\nconst kError = Symbol('kError');\x0d\nconst kPath = Symbol('kPath');\x0d\n\x0d\nconst HTTP_CLIENT_TRACE_EVENT_NAME = 'http.client.request';\x0d\n\x0d\nfunction validateHost(host\x2C name) {\x0d\n  if (host !== null && host !== undefined && typeof host !== 'string') {\x0d\n    throw new ERR_INVALID_ARG_TYPE(`options.${name}`\x2C\x0d\n                                   ['string'\x2C 'undefined'\x2C 'null']\x2C\x0d\n                                   host);\x0d\n  }\x0d\n  return host;\x0d\n}\x0d\n\x0d\nclass HTTPClientAsyncResource {\x0d\n  constructor(type\x2C req) {\x0d\n    this.type = type;\x0d\n    this.req = req;\x0d\n  }\x0d\n}\x0d\n\x0d\n// The only documented shape is [k\x2C v\x2C k\x2C v\x2C ...]. Here we also accept [[k\x2C v]\x2C [k\x2C v]\x2C ...].\x0d\n// for backward compatibility\x2C and reject others. Also reject if there are duplicate Host entries.\x0d\n// Returns the Host header value\x2C or undefined if absent.\x0d\nfunction getHostFromHeaderArray(headers) {\x0d\n  let host;\x0d\n  const isPairs = headers.length > 0 && ArrayIsArray(headers[0]);\x0d\n  if (isPairs) {\x0d\n    for (let i = 0; i < headers.length; i++) {\x0d\n      const entry = headers[i];\x0d\n      if (!ArrayIsArray(entry)) {\x0d\n        throw new ERR_INVALID_ARG_VALUE(`options.headers[${i}]`\x2C typeof entry\x2C\x0d\n                                        'must be an array when headers is passed as an array of pairs');\x0d\n      }\x0d\n      if (`${entry[0]}`.toLowerCase() === 'host') {\x0d\n        if (host !== undefined) {\x0d\n          throw new ERR_INVALID_ARG_VALUE('options.headers'\x2C '(redacted)'\x2C\x0d\n                                          'must not contain duplicate Host headers');\x0d\n        }\x0d\n        host = `${entry[1]}`;\x0d\n      }\x0d\n    }\x0d\n  } else {\x0d\n    for (let i = 0; i + 1 < headers.length; i += 2) {\x0d\n      if (`${headers[i]}`.toLowerCase() === 'host') {\x0d\n        if (host !== undefined) {\x0d\n          throw new ERR_INVALID_ARG_VALUE('options.headers'\x2C '(redacted)'\x2C\x0d\n                                          'must not contain duplicate Host headers');\x0d\n        }\x0d\n        host = `${headers[i + 1]}`;\x0d\n      }\x0d\n    }\x0d\n  }\x0d\n  return host;\x0d\n}\x0d\n\x0d\nfunction authoritiesMatch(canonicalHost\x2C hostFromHeader) {\x0d\n  let parsed;\x0d\n  try {\x0d\n    parsed = new URL(`http://${hostFromHeader}`);\x0d\n  } catch {\x0d\n    return false;\x0d\n  }\x0d\n  if (parsed.username || parsed.password ||\x0d\n      parsed.pathname !== '/' || parsed.search || parsed.hash) {\x0d\n    return false;\x0d\n  }\x0d\n  return parsed.host === canonicalHost;\x0d\n}\x0d\n\x0d\n// https://datatracker.ietf.org/doc/html/rfc9112#section-3.2\x0d\n// When the request target is in absolute-form\x2C ensure it is consistent with\x0d\n// the request authority: same scheme\x2C no userinfo\x2C and an authority\x0d\n// component agree with options.host[:port].\x0d\nfunction validateRequestAuthority(pathOption\x2C proxyAuthority\x2C userHostHeader\x2C headerArray) {\x0d\n  validatePort(proxyAuthority.port\x2C 'options.port'\x2C true);\x0d\n  pathOption = `${pathOption}`;\x0d\n  const requestBase = new URL(`http://${proxyAuthority.host}`);\x0d\n  requestBase.port = proxyAuthority.port;\x0d\n\x0d\n  const result = { requestBase };\x0d\n  if (headerArray !== undefined) {\x0d\n    const host = getHostFromHeaderArray(headerArray);\x0d\n    // Since we don't mutate the header array to normalize the Host value\x2C unlike\x0d\n    // in the case of other shapes of headers provided\x2C we check that it is identical\x0d\n    