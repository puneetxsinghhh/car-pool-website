script-source,309,node:internal/crypto/webcrypto,'use strict';\x0d\n\x0d\nconst {\x0d\n  ArrayIsArray\x2C\x0d\n  ArrayPrototypeSlice\x2C\x0d\n  FunctionPrototypeCall\x2C\x0d\n  JSONParse\x2C\x0d\n  JSONStringify\x2C\x0d\n  ObjectDefineProperties\x2C\x0d\n  ObjectKeys\x2C\x0d\n  ObjectPrototypeHasOwnProperty\x2C\x0d\n  ObjectSetPrototypeOf\x2C\x0d\n  PromiseReject\x2C\x0d\n  PromiseResolve\x2C\x0d\n  ReflectApply\x2C\x0d\n  ReflectConstruct\x2C\x0d\n  SafeArrayIterator\x2C\x0d\n  StringPrototypeRepeat\x2C\x0d\n  StringPrototypeSlice\x2C\x0d\n  StringPrototypeStartsWith\x2C\x0d\n  SymbolIterator\x2C\x0d\n  SymbolToStringTag\x2C\x0d\n  TypedArrayPrototypeGetBuffer\x2C\x0d\n} = primordials;\x0d\n\x0d\nconst {\x0d\n  CShakeJob\x2C\x0d\n  kWebCryptoKeyFormatRaw\x2C\x0d\n  kWebCryptoKeyFormatPKCS8\x2C\x0d\n  kWebCryptoKeyFormatSPKI\x2C\x0d\n  kWebCryptoCipherEncrypt\x2C\x0d\n  kWebCryptoCipherDecrypt\x2C\x0d\n} = internalBinding('crypto');\x0d\n\x0d\nconst {\x0d\n  decodeUTF8\x2C\x0d\n  encodeUtf8String\x2C\x0d\n} = internalBinding('encoding_binding');\x0d\n\x0d\nconst {\x0d\n  codes: {\x0d\n    ERR_ILLEGAL_CONSTRUCTOR\x2C\x0d\n    ERR_INVALID_THIS\x2C\x0d\n  }\x2C\x0d\n} = require('internal/errors');\x0d\n\x0d\nconst {\x0d\n  CryptoKey\x2C\x0d\n  getCryptoKeyAlgorithm\x2C\x0d\n  getCryptoKeyExtractable\x2C\x0d\n  getCryptoKeyHandle\x2C\x0d\n  getCryptoKeyType\x2C\x0d\n  getCryptoKeyUsages\x2C\x0d\n  getCryptoKeyUsagesMask\x2C\x0d\n  hasCryptoKeyUsage\x2C\x0d\n  importGenericSecretKey\x2C\x0d\n  toPublicCryptoKey\x2C\x0d\n} = require('internal/crypto/keys');\x0d\n\x0d\nconst {\x0d\n  asyncDigest\x2C\x0d\n} = require('internal/crypto/hash');\x0d\n\x0d\nconst {\x0d\n  cleanupWebCryptoResult\x2C\x0d\n  getBlockSize\x2C\x0d\n  jobPromiseThen\x2C\x0d\n  normalizeAlgorithm\x2C\x0d\n  normalizeHashName\x2C\x0d\n  numBitsToBytes\x2C\x0d\n  prepareWebCryptoResult\x2C\x0d\n  validateMaxBufferLength\x2C\x0d\n} = require('internal/crypto/util');\x0d\n\x0d\nconst {\x0d\n  emitExperimentalWarning\x2C\x0d\n  kEnumerableProperty\x2C\x0d\n  lazyDOMException\x2C\x0d\n  setOwnProperty\x2C\x0d\n} = require('internal/util');\x0d\n\x0d\nconst {\x0d\n  getRandomValues: _getRandomValues\x2C\x0d\n  randomUUID: _randomUUID\x2C\x0d\n} = require('internal/crypto/random');\x0d\n\x0d\nconst {\x0d\n  isPromise\x2C\x0d\n} = require('internal/util/types');\x0d\n\x0d\nlet webidl;\x0d\n\x0d\n// WebCrypto methods return promises\x2C including for synchronous validation\x0d\n// failures. Keep that conversion in one place so method bodies stay readable.\x0d\nfunction callSubtleCryptoMethod(fn\x2C receiver\x2C args) {\x0d\n  try {\x0d\n    const result = ReflectApply(fn\x2C receiver\x2C args);\x0d\n    if (isPromise(result))\x0d\n      return result;\x0d\n    // PromiseResolve() performs thenable assimilation for object results.\x0d\n    // Shadow inherited then accessors while it resolves synchronous results.\x0d\n    const shouldCleanupResult = prepareWebCryptoResult(result);\x0d\n    try {\x0d\n      return PromiseResolve(result);\x0d\n    } finally {\x0d\n      if (shouldCleanupResult)\x0d\n        cleanupWebCryptoResult(result);\x0d\n    }\x0d\n  } catch (err) {\x0d\n    return PromiseReject(err);\x0d\n  }\x0d\n}\x0d\n\x0d\nconst kArgumentContexts = [\x0d\n  '1st argument'\x2C\x0d\n  '2nd argument'\x2C\x0d\n  '3rd argument'\x2C\x0d\n  '4th argument'\x2C\x0d\n  '5th argument'\x2C\x0d\n  '6th argument'\x2C\x0d\n  '7th argument'\x2C\x0d\n];\x0d\n\x0d\nfunction prepareSubtleMethod(receiver\x2C method\x2C argLength\x2C required) {\x0d\n  if (receiver !== subtle) throw new ERR_INVALID_THIS('SubtleCrypto');\x0d\n\x0d\n  webidl ??= require('internal/crypto/webidl');\x0d\n  const prefix = `Failed to execute '${method}' on 'SubtleCrypto'`;\x0d\n  webidl.requiredArguments(argLength\x2C required\x2C { prefix });\x0d\n  return prefix;\x0d\n}\x0d\n\x0d\nfunction convertSubtleArgument(prefix\x2C converter\x2C value\x2C index) {\x0d\n  return webidl.converters[converter](value\x2C {\x0d\n    prefix\x2C\x0d\n    context: kArgumentContexts[index]\x2C\x0d\n  });\x0d\n}\x0d\n\x0d\nfunction digest(algorithm\x2C data) {\x0d\n  return callSubtleCryptoMethod(digestImpl\x2C this\x2C arguments);\x0d\n}\x0d\n\x0d\nfunction digestImpl(algorithm\x2C data) {\x0d\n  const prefix = prepareSubtleMethod(this\x2C 'digest'\x2C arguments.length\x2C 2);\x0d\n  let i = 0;\x0d\n  algorithm = convertSubtleArgument(\x0d\n    prefix\x2C 'AlgorithmIdentifier'\x2C algorithm\x2C i++);\x0d\n  data = convertSubtleArgument(prefix\x2C 'BufferSource'\x2C data\x2C i++);\x0d\n\x0d\n  const normalizedAlgorithm = normalizeAlgorithm(algorithm\x2C 'digest');\x0d\n\x0d\n  return FunctionPrototypeCall(asyncDigest\x2C this\x2C normalizedAlgorithm\x2C data);\x0d\n}\x0d\n\x0d\nfunction randomUUID() {\x0d\n  if (this !== crypto) throw new ERR_INVALID_THIS('Crypto');\x0d\n  return _randomUUID();\x0d\n}\x0d\n\x0d\nfunction generateKey(\x0d\n  algorithm\x2C\x0d\n  extractable\x2C\x0d\n  keyUsages) {\x0d\n  return callSubtleCryptoMethod(generateKeyImpl\x2C this\x2C arguments);\x0d\n}\x0d\n\x0d\nfunction generateKeyImpl(\x0d\n  algorithm\x2C\x0d\n  extractable\x2C\x0d\n  keyUsages) {\x0d\n  const prefix = prepareSubtleMethod(this\x2C 'generateKey'\x2C arguments.length\x2C 3);\x0d\n  let i = 0;\x0d\n  algorithm = convertSubtleArgument(\x0d\n    prefix\x2C 'AlgorithmIdentifier'\x2C algorithm\x2C i++);\x0d\n  extractable = convertSubtleArgument(prefix\x2C 'boolean'\x2C extractable\x2C i++);\x0d\n  const usages = convertSubtleArgument(\x0d\n    prefix\x2C 'sequence<KeyUsage>'\x2C keyUsages\x2C i++);\x0d\n\x0d\n  const normalizedAlgorithm = normalizeAlgorithm(algorithm\x2C 'generateKey');\x0d\n  switch (normalizedAlgorithm.name) {\x0d\n    case 'RSASSA-PKCS1-v1_5':\x0d\n      // Fall through\x0d\n    case 'RSA-PSS':\x0d\n      // Fall through\x0d\n    case 'RSA-OAEP':\x0d\n      return require('internal/crypto/rsa')\x0d\n        .rsaKeyGenerate(normalizedAlgorithm\x2C extractable\x2C usages);\x0d\n    case 'Ed25519':\x0d\n      // Fall through\x0d\n    case 'Ed448':\x0d\n      // Fall through\x0d\n    case 'X25519':\x0d\n      // Fall through\x0d\n    case 'X448':\x0d\n      return require('internal/crypto/cfrg')\x0d\n        .cfrgGenerateKey(normalizedAlgorithm\x2C extractable\x2C usages);\x0d\n    case 'ECDSA':\x0d\n      // Fall through\x0d\n    case 'ECDH':\x0d\n      return require('internal/crypto/ec')\x0d\n        .ecGenerateKey(normalizedAlgorithm\x2C extractable\x2C usages);\x0d\n    case 'HMAC':\x0d\n      return require('internal/crypto/mac')\x0d\n        .hmacGenerateKey(normalizedAlgorithm\x2C extractable\x2C usages);\x0d\n    case 'AES-CTR':\x0d\n      // Fall through\x0d\n    case 'AES-CBC':\x0d\n      // Fall through\x0d\n    case 'AES-GCM':\x0d\n      // Fall through\x0d\n    case 'AES-OCB':\x0d\n      // Fall through\x0d\n    case 'AES-KW':\x0d\n      return require('internal/crypto/aes')\x0d\n        .aesGenerateKey(normalizedAlgorithm\x2C extractable\x2C usages);\x0d\n    case 'ChaCha20-Poly1305':\x0d\n      return require('internal/crypto/chacha20_poly1305')\x0d\n        .c20pGenerateKey(normalizedAlgorithm\x2C extractable\x2C usages);\x0d\n    case 'ML-DSA-44':\x0d\n      // Fall through\x0d\n    case 'ML-DSA-65':\x0d\n      // Fall through\x0d\n    case 'ML-DSA-87':\x0d\n      return require('internal/crypto/ml_dsa')\x0d\n        .mlDsaGenerateKey(normalizedAlgorithm\x2C extractable\x2C usages);\x0d\n    case 'ML-KEM-512':\x0d\n      // Fall through\x0d\n    case 'ML-KEM-768':\x0d\n      // Fall through\x0d\n    case 'ML-KEM-1024':\x0d\n      return require('internal/crypto/ml_kem')\x0d\n        .mlKemGenerateKey(normalizedAlgorithm\x2C extractable\x2C usages);\x0d\n    case 'KMAC128':\x0d\n      // Fall through\x0d\n    case 'KMAC256':\x0d\n      return require('internal/crypto/mac')\x0d\n        .kmacGenerateKey(normalizedAlgorithm\x2C extractable\x2C usages);\x0d\n    /* c8 ignore start */\x0d\n    default: {\x0d\n      const assert = require('internal/assert');\x0d\n      assert.fail('Unreachable code');\x0d\n    }\x0d\n    /* c8 ignore stop */\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction deriveBits(algorithm\x2C baseKey\x2C length = null) {\x0d\n  return callSubtleCryptoMethod(deriveBitsImpl\x2C this\x2C arguments);\x0d\n}\x0d\n\x0d\nfunction deriveBitsImpl(algorithm\x2C baseKey\x2C length = null) {\x0d\n  const prefix = prepareSubtleMethod(this\x2C 'deriveBits'\x2C arguments.length\x2C 2);\x0d\n  let i = 0;\x0d\n  algorithm = convertSubtleArgument(\x0d\n    prefix\x2C 'AlgorithmIdentifier'\x2C algorithm\x2C i++);\x0d\n  baseKey = convertSubtleArgument(prefix\x2C 'CryptoKey'\x2C baseKey\x2C i++);\x0d\n  if (length !== null) {\x0d\n    length = convertSubtleArgument(prefix\x2C 'unsigned long'\x2C length\x2C i++);\x0d\n  }\x0d\n\x0d\n  const normalizedAlgorithm = normalizeAlgorithm(algorithm\x2C 'deriveBits');\x0d\n  if (!hasCryptoKeyUsage(baseKey\x2C 'deriveBits')) {\x0d\n    throw lazyDOMException(\x0d\n      'baseKey does not have deriveBits usage'\x2C\x0d\n      'InvalidAccessError');\x0d\n  }\x0d\n  if (getCryptoKeyAlgorithm(baseKey).name !== normalizedAlgorithm.name)\x0d\n    throw lazyDOMException('Key algorithm mismatch'\x2C 'InvalidAccessError');\x0d\n  switch (normalizedAlgorithm.name) {\x0d\n    case 'X25519':\x0d\n      // Fall through\x0d\n    case 'X448':\x0d\n      // Fall through\x0d\n    case 'ECDH':\x0d\n      return require('internal/crypto/diffiehellman')\x0d\n        .ecdhDeriveBits(normalizedAlgorithm\x2C baseKey\x2C length);\x0d\n    case 'HKDF':\x0d\n      return require('internal/crypto/hkdf')\x0d\n        .hkdfDeriveBits(normalizedAlgorithm\x2C baseKey\x2C length);\x0d\n    case 'PBKDF2':\x0d\n      return require('internal/crypto/pbkdf2')\x0d\n        .pbkdf2DeriveBits(normalizedAlgorithm\x2C baseKey\x2C length);\x0d\n    case 'Argon2d':\x0d\n      // Fall through\x0d\n    case 'Argon2i':\x0d\n      // Fall through\x0d\n    case 'Argon2id':\x0d\n      return require('internal/crypto/argon2')\x0d\n        .argon2DeriveBits(normalizedAlgorithm\x2C baseKey\x2C length);\x0d\n    /* c8 ignore start */\x0d\n    default: {\x0d\n      const assert = require('internal/assert');\x0d\n      assert.fail('Unreachable code');\x0d\n    }\x0d\n    /* c8 ignore stop */\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction getKeyLength({ name\x2C length\x2C hash }) {\x0d\n  switch (name) {\x0d\n    case 'AES-CTR':\x0d\n    case 'AES-CBC':\x0d\n    case 'AES-GCM':\x0d\n    case 'AES-OCB':\x0d\n    case 'AES-KW':\x0d\n      if (length !== 128 && length !== 192 && length !== 256)\x0d\n        throw lazyDOMException('Invalid key length'\x2C 'OperationError');\x0d\n\x0d\n      return length;\x0d\n    case 'HMAC':\x0d\n      if (length === undefined) {\x0d\n        return getBlockSize(hash?.name);\x0d\n      }\x0d\n\x0d\n      if (typeof length === 'number' && length !== 0) {\x0d\n        return length;\x0d\n      }\x0d\n\x0d\n      throw lazyDOMException('Invalid key length'\x2C 'OperationError');\x0d\n    case 'KMAC128':\x0d\n    case 'KMAC256':\x0d\n      if (typeof length === 'number') {\x0d\n        return length;\x0d\n      }\x0d\n\x0d\n      return name === 'KMAC128' ? 128 : 256;\x0d\n    case 'HKDF':\x0d\n    case 'PBKDF2':\x0d\n    case 'Argon2d':\x0d\n    case 'Argon2i':\x0d\n    case 'Argon2id':\x0d\n      return null;\x0d\n    case 'ChaCha20-Poly1305':\x0d\n      return 256;\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction deriveKey(\x0d\n  algorithm\x2C\x0d\n  baseKey\x2C\x0d\n  derivedKeyType\x2C\x0d\n  extractable\x2C\x0d\n  keyUsages) {\x0d\n  return callSubtleCryptoMethod(deriveKeyImpl\x2C this\x2C arguments);\x0d\n}\x0d\n\x0d\nfunction deriveKeyImpl(\x0d\n  algorithm\x2C\x0d\n  baseKey\x2C\x0d\n  derivedKeyType\x2C\x0d\n  extractable\x2C\x0d\n  keyUsages) {\x0d\n  const prefix = prepareSubtleMethod(this\x2C 'deriveKey'\x2C arguments.length\x2C 5);\x0d\n  let i = 0;\x0d\n  algorithm = convertSubtleArgument(\x0d\n    prefix\x2C 'AlgorithmIdentifier'\x2C algorithm\x2C i++);\x0d\n  baseKey = convertSubtleArgument(prefix\x2C 'CryptoKey'\x2C baseKey\x2C i++);\x0d\n  derivedKeyType = convertSubtleArgument(\x0d\n    prefix\x2C 'AlgorithmIdentifier'\x2C derivedKeyType\x2C i++);\x0d\n  extractable = convertSubtleArgument(prefix\x2C 'boolean'\x2C extractable\x2C i++);\x0d\n  const usages = convertSubtleArgument(\x0d\n    prefix\x2C 'sequence<KeyUsage>'\x2C keyUsages\x2C i++);\x0d\n\x0d\n  const normalizedAlgorithm = normalizeAlgorithm(algorithm\x2C 'deriveBits');\x0d\n  const normalizedDerivedKeyAlgorithmImport =\x0d\n    normalizeAlgorithm(derivedKeyType\x2C 'importKey');\x0d\n  const normalizedDerivedKeyAlgorithmLength =\x0d\n    normalizeAlgorithm(derivedKeyType\x2C 'get key length');\x0d\n  if (!hasCryptoKeyUsage(baseKey\x2C 'deriveKey')) {\x0d\n    throw lazyDOMException(\x0d\n      'baseKey does not have deriveKey usage'\x2C\x0d\n      'InvalidAccessError');\x0d\n  }\x0d\n  if (getCryptoKeyAlgorithm(baseKey).name !== normalizedAlgorithm.name)\x0d\n    throw lazyDOMException('Key algorithm mismatch'\x2C 'InvalidAccessError');\x0d\n\x0d\n  const length = getKeyLength(normalizedDerivedKeyAlgorithmLength);\x0d\n  let secret;\x0d\n  switch (normalizedAlgorithm.name) {\x0d\n    case 'X25519':\x0d\n      // Fall through\x0d\n    case 'X448':\x0d\n      // Fall through\x0d\n    case 'ECDH':\x0d\n      secret = require('internal/crypto/diffiehellman')\x0d\n        .ecdhDeriveBits(normalizedAlgorithm\x2C baseKey\x2C length);\x0d\n      break;\x0d\n    case 'HKDF':\x0d\n      secret = require('internal/crypto/hkdf')\x0d\n        .hkdfDeriveBits(normalizedAlgorithm\x2C baseKey\x2C length);\x0d\n      break;\x0d\n    case 'PBKDF2':\x0d\n      secret = require('internal/crypto/pbkdf2')\x0d\n        .pbkdf2DeriveBits(normalizedAlgorithm\x2C baseKey\x2C length);\x0d\n      break;\x0d\n    case 'Argon2d':\x0d\n      // Fall through\x0d\n    case 'Argon2i':\x0d\n      // Fall through\x0d\n    case 'Argon2id':\x0d\n      secret = require('internal/crypto/argon2')\x0d\n        .argon2DeriveBits(normalizedAlgorithm\x2C baseKey\x2C length);\x0d\n      break;\x0d\n    /* c8 ignore start */\x0d\n    default: {\x0d\n      const assert = require('internal/assert');\x0d\n      assert.fail('Unreachable code');\x0d\n    }\x0d\n    /* c8 ignore stop */\x0d\n  }\x0d\n\x0d\n  return jobPromiseThen(secret\x2C (secret) => FunctionPrototypeCall(\x0d\n    importKeySync\x2C\x0d\n    this\x2C\x0d\n    'raw-secret'\x2C\x0d\n    secret\x2C\x0d\n    normalizedDerivedKeyAlgorithmImport\x2C\x0d\n    extractable\x2C\x0d\n    usages\x2C\x0d\n  ));\x0d\n}\x0d\n\x0d\nfunction exportKeySpki(key) {\x0d\n  switch (getCryptoKeyAlgorithm(key).name) {\x0d\n    case 'RSASSA-PKCS1-v1_5':\x0d\n      // Fall through\x0d\n    case 'RSA-PSS':\x0d\n      // Fall through\x0d\n    case 'RSA-OAEP':\x0d\n      return require('internal/crypto/rsa')\x0d\n        .rsaExportKey(key\x2C kWebCryptoKeyFormatSPKI);\x0d\n    case 'ECDSA':\x0d\n      // Fall through\x0d\n    case 'ECDH':\x0d\n      return require('internal/crypto/ec')\x0d\n        .ecExportKey(key\x2C kWebCryptoKeyFormatSPKI);\x0d\n    case 'Ed25519':\x0d\n      // Fall through\x0d\n    case 'Ed448':\x0d\n      // Fall through\x0d\n    case 'X25519':\x0d\n      // Fall through\x0d\n    case 'X448':\x0d\n      return require('internal/crypto/cfrg')\x0d\n        .cfrgExportKey(key\x2C kWebCryptoKeyFormatSPKI);\x0d\n    case 'ML-DSA-44':\x0d\n      // Fall through\x0d\n    case 'ML-DSA-65':\x0d\n      // Fall through\x0d\n    case 'ML-DSA-87':\x0d\n      return require('internal/crypto/ml_dsa')\x0d\n        .mlDsaExportKey(key\x2C kWebCryptoKeyFormatSPKI);\x0d\n    case 'ML-KEM-512':\x0d\n      // Fall through\x0d\n    case 'ML-KEM-768':\x0d\n      // Fall through\x0d\n    case 'ML-KEM-1024':\x0d\n      return require('internal/crypto/ml_kem')\x0d\n        .mlKemExportKey(key\x2C kWebCryptoKeyFormatSPKI);\x0d\n    default:\x0d\n      return undefined;\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction exportKeyPkcs8(key) {\x0d\n  switch (getCryptoKeyAlgorithm(key).name) {\x0d\n    case 'RSASSA-PKCS1-v1_5':\x0d\n      // Fall through\x0d\n    case 'RSA-PSS':\x0d\n      // Fall through\x0d\n    case 'RSA-OAEP':\x0d\n      return require('internal/crypto/rsa')\x0d\n        .rsaExportKey(key\x2C kWebCryptoKeyFormatPKCS8);\x0d\n    case 'ECDSA':\x0d\n      // Fall through\x0d\n    case 'ECDH':\x0d\n      return require('internal/crypto/ec')\x0d\n        .ecExportKey(key\x2C kWebCryptoKeyFormatPKCS8);\x0d\n    case 'Ed25519':\x0d\n      // Fall through\x0d\n    case 'Ed448':\x0d\n      // Fall through\x0d\n    case 'X25519':\x0d\n      // Fall through\x0d\n    case 'X448':\x0d\n      return require('internal/crypto/cfrg')\x0d\n        .cfrgExportKey(key\x2C kWebCryptoKeyFormatPKCS8);\x0d\n    case 'ML-DSA-44':\x0d\n      // Fall through\x0d\n    case 'ML-DSA-65':\x0d\n      // Fall through\x0d\n    case 'ML-DSA-87':\x0d\n      return require('internal/crypto/ml_dsa')\x0d\n        .mlDsaExportKey(key\x2C kWebCryptoKeyFormatPKCS8);\x0d\n    case 'ML-KEM-512':\x0d\n      // Fall through\x0d\n    case 'ML-KEM-768':\x0d\n      // Fall through\x0d\n    case 'ML-KEM-1024':\x0d\n      return require('internal/crypto/ml_kem')\x0d\n        .mlKemExportKey(key\x2C kWebCryptoKeyFormatPKCS8);\x0d\n    default:\x0d\n      return undefined;\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction exportKeyRawPublic(key\x2C format) {\x0d\n  switch (getCryptoKeyAlgorithm(key).name) {\x0d\n    case 'ECDSA':\x0d\n      // Fall through\x0d\n    case 'ECDH':\x0d\n      return require('internal/crypto/ec')\x0d\n        .ecExportKey(key\x2C kWebCryptoKeyFormatRaw);\x0d\n    case 'Ed25519':\x0d\n      // Fall through\x0d\n    case 'Ed448':\x0d\n      // Fall through\x0d\n    case 'X25519':\x0d\n      // Fall through\x0d\n    case 'X448':\x0d\n      return require('internal/crypto/cfrg')\x0d\n        .cfrgExportKey(key\x2C kWebCryptoKeyFormatRaw);\x0d\n    case 'ML-DSA-44':\x0d\n      // Fall through\x0d\n    case 'ML-DSA-65':\x0d\n      // Fall through\x0d\n    case 'ML-DSA-87': {\x0d\n      // ML-DSA keys don't recognize "raw"\x0d\n      if (format !== 'raw-public') {\x0d\n        return undefined;\x0d\n      }\x0d\n      return require('internal/crypto/ml_dsa')\x0d\n        .mlDsaExportKey(key\x2C kWebCryptoKeyFormatRaw);\x0d\n    }\x0d\n    case 'ML-KEM-512':\x0d\n      // Fall through\x0d\n    case 'ML-KEM-768':\x0d\n      // Fall through\x0d\n    case 'ML-KEM-1024': {\x0d\n      // ML-KEM keys don't recognize "raw"\x0d\n      if (format !== 'raw-public') {\x0d\n        return undefined;\x0d\n      }\x0d\n      return require('internal/crypto/ml_kem')\x0d\n        .mlKemExportKey(key\x2C kWebCryptoKeyFormatRaw);\x0d\n    }\x0d\n    default:\x0d\n      return undefined;\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction exportKeyRawSeed(key) {\x0d\n  switch (getCryptoKeyAlgorithm(key).name) {\x0d\n    case 'ML-DSA-44':\x0d\n      // Fall through\x0d\n    case 'ML-DSA-65':\x0d\n      // Fall through\x0d\n    case 'ML-DSA-87':\x0d\n      return require('internal/crypto/ml_dsa')\x0d\n        .mlDsaExportKey(key\x2C kWebCryptoKeyFormatRaw);\x0d\n    case 'ML-KEM-512':\x0d\n      // Fall through\x0d\n    case 'ML-KEM-768':\x0d\n      // Fall through\x0d\n    case 'ML-KEM-1024':\x0d\n      return require('internal/crypto/ml_kem')\x0d\n        .mlKemExportKey(key\x2C kWebCryptoKeyFormatRaw);\x0d\n    default:\x0d\n      return undefined;\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction exportKeyRawSecret(key\x2C format) {\x0d\n  switch (getCryptoKeyAlgorithm(key).name) {\x0d\n    case 'AES-CTR':\x0d\n      // Fall through\x0d\n    case 'AES-CBC':\x0d\n      // Fall through\x0d\n    case 'AES-GCM':\x0d\n      // Fall through\x0d\n    case 'AES-KW':\x0d\n      // Fall through\x0d\n    case 'HMAC':\x0d\n      return TypedArrayPrototypeGetBuffer(getCryptoKeyHandle(key).export());\x0d\n    case 'AES-OCB':\x0d\n      // Fall through\x0d\n    case 'KMAC128':\x0d\n      // Fall through\x0d\n    case 'KMAC256':\x0d\n      // Fall through\x0d\n    case 'ChaCha20-Poly1305':\x0d\n      if (format === 'raw-secret') {\x0d\n        return TypedArrayPrototypeGetBuffer(getCryptoKeyHandle(key).export());\x0d\n      }\x0d\n      return undefined;\x0d\n    default:\x0d\n      return undefined;\x0d\n  }\x0d\n}\x0d\n\x0d\nfunction exportKeyJWK(key) {\x0d\n  const algorithm = getCryptoKeyAlgorithm(key);\x0d\n  let alg;\x0d\n  switch (algorithm.name) {\x0d\n    case 'RSASSA-PKCS1-v1_5': {\x0d\n      alg = normalizeHashName(\x0d\n        algorithm.hash.name\x2C\x0d\n        normalizeHashName.kContextJwkRsa);\x0d\n      break;\x0d\n    }\x0d\n    case 'RSA-PSS': {\x0d\n      alg = normalizeHashName(\x0d\n        algorithm.hash.name\x2C\x0d\n        normalizeHashName.kContextJwkRsaPss);\x0d\n      break;\x0d\n    }\x0d\n    case 'RSA-OAEP': {\x0d\n      alg = normalizeHashName(\x0d\n        algorithm.hash.name\x2C\x0d\n        normalizeHashName.kContextJwkRsaOaep);\x0d\n      break;\x0d\n    }\x0d\n    case 'ECDSA':\x0d\n      // Fall through\x0d\n    case 'ECDH':\x0d\n      // Fall through\x0d\n    case 'X25519':\x0d\n      // Fall through\x0d\n    case 'X448':\x0d\n      // Fall through\x0d\n    case 'ML-DSA-44':\x0d\n      // Fall through\x0d\n    case 'ML-DSA-65':\x0d\n      // Fall through\x0d\n    case 'ML-DSA-87':\x0d\n      // Fall through\x0d\n    case 'ML-KEM-512':\x0d\n      // Fall through\x0d\n    case 'ML-KEM-768':\x0d\n      // Fall through\x0d\n    case 'ML-KEM-1024':\x0d\n      break;\x0d\n    case 'Ed25519':\x0d\n      // Fall through\x0d\n    case 'Ed448':\x0d\n      alg = algorithm.name;\x0d\n      break;\x0d\n    case 'AES-CTR':\x0d\n      // Fall through\x0d\n    case 'AES-CBC':\x0d\n      // Fall through\x0d\n    case 'AES-GCM':\x0d\n      // Fall through\x0d\n    case 'AES-OCB':\x0d\n      // Fall through\x0d\n    case 'AES-KW':\x0d\n      alg = require('internal/crypto/aes')\x0d\n        .getAlgorithmName(algorithm.name\x2C algorithm.length);\x0d\n      break;\x0d\n    case 'ChaCha20-Poly1305':\x0d\n      alg = 'C20P';\x0d\n      break;\x0d\n    case 'HMAC': {\x0d\n      alg = normalizeHashName(\x0d\n        algorithm.hash.name\x2C\x0d\n        normalizeHashName.kContextJwkHmac);\x0d\n      break;\x0d\n    }\x0d\n    case 'KMAC128':\x0d\n      alg = 'K128';\x0d\n      break;\x0d\n    case 'KMAC256': {\x0d\n      alg = 'K256';\x0d\n      break;\x0d\n    }\x0d\n    default:\x0d\n      return undefined;\x0d\n  }\x0d\n\x0d\n  // Keep `alg` in the object literal so an inherited setter cannot capture\x0d\n  // `parameters` before native export populates key material. Delete it for\x0d\n  // algorithms without a JWK alg value to keep the expected shape.\x0d\n  const parameters = {\x0d\n    key_ops: ArrayPrototypeSlice(getCryptoKeyUsages(key)\x2C 0)\x2C\x0d\n    ext: getCryptoKeyExtractable(key)\x2C\x0d\n    alg\x2C\x0d\n  };\x0d\n  if (alg === undefined) delete parameters.alg;\x0d\n\x0d\n  return getCryptoKeyHandle(key).exportJwk(parameters\x2C true);\x0d\n}\x0d\n\x0d\nfunction exportKeySync(format\x2C key) {\x0d\n  const algorithm = getCryptoKeyAlgorithm(key);\x0d\n  try {\x0d\n    normalizeAlgorithm(algorithm\x2C 'exportKey');\x0d\n  } catch {\x0d\n    throw lazyDOMException(\x0d\n      `${algorithm.name} key export is not supported`\x2C 'NotSupportedError');\x0d\n  }\x0d\n\x0d\n  if (!getCryptoKeyExtractable(key))\x0d\n    throw lazyDOMException('key is not extractable'\x2C 'InvalidAccessError');\x0d\n\x0d\n  const type = getCryptoKeyType(key);\x0d\n  let result;\x0d\n  switch (format) {\x0d\n    case 'spki': {\x0d\n      if (type === 'public') {\x0d\n        result = exportKeySpki(key);\x0d\n      }\x0d\n      break;\x0d\n    }\x0d\n    case 'pkcs8': {\x0d\n      if (type === 'private') {\x0d\n        result = exportKeyPkcs8(key);\x0d\n      }\x0d\n      break;\x0d\n    }\x0d\n    case 'jwk': {\x0d\n      result = exportKeyJWK(key);\x0d\n      break;\x0d\n    }\x0d\n    case 'raw-secret': {\x0d\n      if (type === 'secret') {\x0d\n        result = exportKeyRawSecret(key\x2C format);\x0d\n      }\x0d\n      break;\x0d\n    }\x0d\n    case 'raw-public': {\x0d\n      if (type === 'public') {\x0d\n        result = exportKeyRawPublic(key\x2C format);\x0d\n      }\x0d\n      break;\x0d\n    }\x0d\n    case 'raw-seed': {\x0d\n      if (type === 'private') {\x0d\n        result = exportKeyRawSeed(key);\x0d\n      }\x0d\n      break;\x0d\n    }\x0d\n    case 'raw': {\x0d\n      if (type === 'secret') {\x0d\n        result = exportKeyRawSecret(key\x2C format);\x0d\n      } else if (type === 'public') {\x0d\n        result = exportKeyRawPublic(key\x2C format);\x0d\n      }\x0d\n      break;\x0d\n    }\x0d\n  }\x0d\n\x0d\n  if (!result) {\x0d\n    throw lazyDOMException(\x0d\n      `Unable to export ${algorithm.name} ${type} key using ${format} format`\x2C\x0d\n      'NotSupportedError');\x0d\n  }\x0d\n\x0d\n  return result;\x0d\n}\x0d\n\x0d\nfunction exportKey(format\x2C key) {\x0d\n  return callSubtleCryptoMethod(exportKeyImpl\x2C this\x2C arguments);\x0d\n}\x0d\n\x0d\nfunction exportKeyImpl(format\x2C key) {\x0d\n  const prefix = prepareSubtleMethod(this\x2C 'exportKey'\x2C arguments.length\x2C 2);\x0d\n  let i = 0;\x0d\n  format = convertSubtleArgument(prefix\x2C 'KeyFormat'\x2C format\x2C i++);\x0d\n  key = convertSubtleArgument(prefix\x2C 'CryptoKey'\x2C key\x2C i++);\x0d\n\x0d\n  return exportKeySync(format\x2C key);\x0d\n}\x0d\n\x0d\n// Parsed JWK arrays are detached from Array.prototype but still need to pass\x0d\n// WebIDL sequence conversion\x2C which reads @@iterator from the value.\x0d\nfunction safeArrayIterator() {\x0d\n  return new SafeArrayIterator(this);\x0d\n}\x0d\n\x0d\n// The WebCrypto spec parses and stringifies JWKs in a fresh global object.\x0d\n// Detach internal JSON values from the current global's mutable prototypes to\x0d\n// approximate those fresh-realm semantics without creating a new realm.\x0d\nfunction detachFromUserPrototypes(value) {\x0d\n  if (value === null || typeof value !== 'object')\x0d\n    return;\x0d\n\x0d\n  ObjectSetPrototypeOf(value\x2C null);\x0d\n\x0d\n  if (ArrayIsArray(value)) {\x0d\n    setOwnProperty(value\x2C SymbolIterator\x2C safeArrayIterator);\x0d\n    for (let n = 0; n < value.length; n++)\x0d\n      detachFromUserPrototypes(value[n]);\x0d\n    return;\x0d\n  }\x0d\n\x0d\n  const keys = ObjectKeys(value);\x0d\n  for (let n = 0; n < keys.length; n++)\x0d\n    detachFromUserPrototypes(value[keys[n]]);\x0d\n}\x0d\n\x0d\n// Parse wrapped JWK bytes according to WebCrypto's "parse a JWK" procedure.\x0d\nfunction parseJwk(data) {\x0d\n  let key;\x0d\n  try {\x0d\n    // WebCrypto parses JWKs in a fresh global. Detach parsed JSON values\x0d\n    // from user-mutated prototypes before WebIDL dictionary conversion.\x0d\n    // Wrapped JWKs may be produced outside WebCrypto\x2C so parse using the\x0d\n    // spec-required UTF-8.\x0d\n    const json = decodeUTF8(data\x2C false\x2C true);\x0d\n    const result = JSONParse(json);\x0d\n    detachFromUserPrototypes(result);\x0d\n    key = webidl.converters.JsonWebKey(result);\x0d\n  } catch (err) {\x0d\n    throw lazyDOMException(\x0d\n      'Invalid wrapped JWK key'\x2C\x0d\n      { name: 'DataError'\x2C cause: err });\x0d\n  }\x0d\n\x0d\n  if (!ObjectPrototypeHasOwnProperty(key\x2C 'kty')) {\x0d\n    throw lazyDOMException(\x0d\n      'Invalid wrapped JWK key'\x2C\x0d\n      'DataError');\x0d\n  }\x0d\n\x0d\n  return key;\x0d\n}\x0d\n\x0d\nfunction aliasKeyFormat(format\x2C alias) {\x0d\n  return format === alias ? 'raw' : format;\x0d\n}\x0d\n\x0d\nfunction importKeySync(format\x2C keyData\x2C algorithm\x2C extractable\x2C usages) {\x0d\n  let result;\x0d\n  switch (algorithm.name) {\x0d\n    case 'RSASSA-PKCS1-v1_5':\x0d\n      // Fall through\x0d\n    case 'RSA-PSS':\x0d\n      // Fall through\x0d\n    case 'RSA-OAEP':\x0d\n      result = require('internal/crypto/rsa')\x0d\n        .rsaImportKey(\x0d\n          format\x2C\x0d\n          keyData\x2C\x0d\n          algorithm\x2C\x0d\n          extractable\x2C\x0d\n          usages);\x0d\n      break;\x0d\n    case 'ECDSA':\x0d\n      // Fall through\x0d\n    case 'ECDH':\x0d\n      format = aliasKeyFormat(format\x2C 'raw-public');\x0d\n      result = require('internal/crypto/ec')\x0d\n        .ecImportKey(\x0d\n          format\x2C\x0d\n          keyData\x2C\x0d\n          algorithm\x2C\x0d\n          extractable\x2C\x0d\n          usages);\x0d\n      break;\x0d\n    case 'Ed25519':\x0d\n      // Fall through\x0d\n    case 'Ed448':\x0d\n      // Fall through\x0d\n    case 'X25519':\x0d\n      // Fall through\x0d\n    case 'X448':\x0d\n      format = aliasKeyFormat(format\x2C 'raw-public');\x0d\n      result = require('internal/crypto/cfrg')\x0d\n        .cfrgImportKey(\x0d\n          format\x2C\x0d\n          keyData\x2C\x0d\n          algorithm\x2C\x0d\n          extractable\x2C\x0d\n          usages);\x0d\n      break;\x0d\n    case 'HMAC':\x0d\n      // Fall through\x0d\n    case 'KMAC128':\x0d\n      // Fall through\x0d\n    case 'KMAC256':\x0d\n      result = require('internal/crypto/mac')\x0d\n        .macImportKey(\x0d\n          format\x2C\x0d\n          keyData\x2C\x0d\n          algorithm\x2C\x0d\n          extractable\x2C\x0d\n          usages);\x0d\n      break;\x0d\n    case 'AES-CTR':\x0d\n      // Fall through\x0d\n    case 'AES-CBC':\x0d\n      // Fall through\x0d\n    case 'AES-GCM':\x0d\n      // Fall through\x0d\n    case 'AES-KW':\x0d\n      // Fall through\x0d\n    case 'AES-OCB':\x0d\n      result = require('internal/crypto/aes')\x0d\n        .aesImportKey(\x0d\n          algorithm\x2C\x0d\n          format\x2C\x0d\n          keyData\x2C\x0d\n          extractable\x2C\x0d\n          usages);\x0d\n      break;\x0d\n    case 'ChaCha20-Poly1305':\x0d\n      result = require('internal/crypto/chacha20_poly1305')\x0d\n        .c20pImportKey(\x0d\n          algorithm\x2C\x0d\n          format\x2C\x0d\n          keyData\x2C\x0d\n          extractable\x2C\x0d\n          usages);\x0d\n     