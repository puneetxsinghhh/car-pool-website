\x0d\n\x0d\n    // TODO(joyeecheung): use ModuleJobSync for kRequireInImportedCJS too.\x0d\n    const ModuleJobCtor = (requestType === kImportInRequiredESM ? ModuleJobSync : ModuleJob);\x0d\n    const isMain = (parentURL === undefined);\x0d\n    const inspectBrk = (isMain && getOptionValue('--inspect-brk'));\x0d\n    job = new ModuleJobCtor(\x0d\n      this\x2C\x0d\n      url\x2C\x0d\n      importAttributes\x2C\x0d\n      moduleOrModulePromise\x2C\x0d\n      request.phase\x2C\x0d\n      isMain\x2C\x0d\n      inspectBrk\x2C\x0d\n      requestType\x2C\x0d\n    );\x0d\n\x0d\n    this.loadCache.set(url\x2C importAttributes.type\x2C job);\x0d\n\x0d\n    return job;\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * Get a (possibly not yet fully linked) module job from the cache\x2C or create one and return its Promise.\x0d\n   * @param {string} [parentURL] The URL of the module where the module request is initiated.\x0d\n   *   It's undefined if it's from the root module.\x0d\n   * @param {ModuleRequest} request Module request.\x0d\n   * @param {ModuleRequestType} requestType Type of the module request.\x0d\n   * @returns {Promise<ModuleJobBase>|ModuleJobBase}\x0d\n   */\x0d\n  getOrCreateModuleJob(parentURL\x2C request\x2C requestType) {\x0d\n    let maybePromise;\x0d\n    if (requestType === kRequireInImportedCJS || requestType === kImportInRequiredESM) {\x0d\n      // In these two cases\x2C resolution must be synchronous.\x0d\n      maybePromise = this.resolveSync(parentURL\x2C request);\x0d\n      assert(!isPromise(maybePromise));\x0d\n    } else {\x0d\n      maybePromise = this.#resolve(parentURL\x2C request);\x0d\n    }\x0d\n\x0d\n    const afterResolve = (resolveResult) => {\x0d\n      return this.#getOrCreateModuleJobAfterResolve(parentURL\x2C resolveResult\x2C request\x2C requestType);\x0d\n    };\x0d\n\x0d\n    if (isPromise(maybePromise)) {\x0d\n      return PromisePrototypeThen(maybePromise\x2C afterResolve);\x0d\n    }\x0d\n    return afterResolve(maybePromise);\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * This method is usually called indirectly as part of the loading processes.\x0d\n   * Use directly with caution.\x0d\n   * @param {string} specifier The first parameter of an `import()` expression.\x0d\n   * @param {string} parentURL Path of the parent importing the module.\x0d\n   * @param {Record<string\x2C string>} importAttributes Validations for the\x0d\n   *   module import.\x0d\n   * @param {number} [phase] The phase of the import.\x0d\n   * @param {boolean} [isEntryPoint] Whether this is the realm-level entry point.\x0d\n   * @returns {Promise<ModuleExports>}\x0d\n   */\x0d\n  async import(specifier\x2C parentURL\x2C importAttributes\x2C phase = kEvaluationPhase\x2C isEntryPoint = false) {\x0d\n    return onImport.tracePromise(async () => {\x0d\n      const request = { specifier\x2C phase\x2C attributes: importAttributes\x2C __proto__: null };\x0d\n      let moduleJob;\x0d\n      try {\x0d\n        moduleJob = await this.getOrCreateModuleJob(parentURL\x2C request);\x0d\n      } catch (e) {\x0d\n        if (e?.code === 'ERR_ASYNC_LOADER_REQUEST_NEVER_SETTLED') {\x0d\n          return new Promise(() => {});\x0d\n        }\x0d\n        throw e;\x0d\n      }\x0d\n      if (phase === kSourcePhase) {\x0d\n        const module = await moduleJob.modulePromise;\x0d\n        return module.getModuleSourceObject();\x0d\n      }\x0d\n      const { module } = await moduleJob.run(isEntryPoint);\x0d\n      return module.getNamespace();\x0d\n    }\x2C {\x0d\n      __proto__: null\x2C\x0d\n      parentURL\x2C\x0d\n      url: specifier\x2C\x0d\n    });\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * @see {@link AsyncLoaderHooks.register}\x0d\n   * @returns {any}\x0d\n   */\x0d\n  register(specifier\x2C parentURL\x2C data\x2C transferList\x2C isInternal) {\x0d\n    if (!this.#asyncLoaderHooks) {\x0d\n      // On the loader hook worker thread\x2C the #asyncLoaderHooks must already have been initialized\x0d\n      // to be an instance of AsyncLoaderHooksOnLoaderHookWorker\x2C so this branch can only ever\x0d\n      // be hit on a non-loader-hook thread that will talk to the loader hook worker thread.\x0d\n      const { AsyncLoaderHooksProxiedToLoaderHookWorker } = require('internal/modules/esm/hooks');\x0d\n      this.#setAsyncLoaderHooks(new AsyncLoaderHooksProxiedToLoaderHookWorker());\x0d\n    }\x0d\n    return this.#asyncLoaderHooks.register(`${specifier}`\x2C `${parentURL}`\x2C data\x2C transferList\x2C isInternal);\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * Resolve a module request to a URL identifying the location of the module. Handles customization hooks\x2C\x0d\n   * if any.\x0d\n   * @param {string} [parentURL] The URL of the module where the module request is initiated.\x0d\n   *   It's undefined if it's from the root module.\x0d\n   * @param {ModuleRequest} request Module request.\x0d\n   * @returns {Promise<ResolveResult>|ResolveResult}\x0d\n   */\x0d\n  #resolve(parentURL\x2C request) {\x0d\n    if (this.isForAsyncLoaderHookWorker) {\x0d\n      const specifier = `${request.specifier}`;\x0d\n      const importAttributes = request.attributes ?? kEmptyObject;\x0d\n      // TODO(joyeecheung): invoke the synchronous hooks in the default step on loader thread.\x0d\n      return this.#asyncLoaderHooks.resolve(specifier\x2C parentURL\x2C importAttributes);\x0d\n    }\x0d\n\x0d\n    return this.resolveSync(parentURL\x2C request);\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * Either return a cached resolution\x2C or perform the default resolution which is synchronous\x2C and\x0d\n   * cache the result.\x0d\n   * @param {string} specifier See {@link resolve}.\x0d\n   * @param {{ parentURL?: string\x2C importAttributes: ImportAttributes\x2C conditions?: string[]}} context\x0d\n   * @returns {{ format: string\x2C url: string }}\x0d\n   */\x0d\n  #cachedDefaultResolve(specifier\x2C context) {\x0d\n    const { parentURL\x2C importAttributes } = context;\x0d\n    const requestKey = this.#resolveCache.serializeKey(specifier\x2C importAttributes);\x0d\n    const cachedResult = this.#resolveCache.get(requestKey\x2C parentURL);\x0d\n    if (cachedResult != null) {\x0d\n      return cachedResult;\x0d\n    }\x0d\n\x0d\n    const result = defaultResolve(specifier\x2C context);\x0d\n    this.#resolveCache.set(requestKey\x2C parentURL\x2C result);\x0d\n    return result;\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * This is the default resolve step for module.registerHooks()\x2C which incorporates asynchronous hooks\x0d\n   * from module.register() which are run in a blocking fashion for it to be synchronous.\x0d\n   * @param {{isResolvedByDefaultResolve: boolean}} out Output object to track whether the default resolve was used\x0d\n   *   without polluting the user-visible resolve result.\x0d\n   * @param {string|URL} specifier See {@link resolveSync}.\x0d\n   * @param {{ parentURL?: string\x2C importAttributes: ImportAttributes\x2C conditions?: string[]}} context\x0d\n   *   See {@link resolveSync}.\x0d\n   * @returns {{ format: string\x2C url: string }}\x0d\n   */\x0d\n  #resolveAndMaybeBlockOnLoaderThread(out\x2C specifier\x2C context) {\x0d\n    if (this.#asyncLoaderHooks?.resolveSync) {\x0d\n      return this.#asyncLoaderHooks.resolveSync(specifier\x2C context.parentURL\x2C context.importAttributes);\x0d\n    }\x0d\n    out.isResolvedByDefaultResolve = true;\x0d\n    return this.#cachedDefaultResolve(specifier\x2C context);\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * Similar to {@link resolve}\x2C but the results are always synchronously returned. If there are any\x0d\n   * asynchronous resolve hooks from module.register()\x2C it will block until the results are returned\x0d\n   * from the loader thread for this to be synchronous.\x0d\n   * This is here to support `import.meta.resolve()`\x2C `require()` in imported CJS\x2C and\x0d\n   * `module.registerHooks()` hooks.\x0d\n   * @param {string} [parentURL] See {@link resolve}.\x0d\n   * @param {ModuleRequest} request See {@link resolve}.\x0d\n   * @param {boolean} [shouldSkipSyncHooks] Whether to skip the synchronous hooks registered by module.registerHooks().\x0d\n   *   This is used to maintain compatibility for the re-invented require.resolve (in imported CJS customized\x0d\n   *   by module.register()`) which invokes the CJS resolution separately from the hook chain.\x0d\n   * @returns {ResolveResult}\x0d\n   */\x0d\n  resolveSync(parentURL\x2C request\x2C shouldSkipSyncHooks = false) {\x0d\n    const specifier = `${request.specifier}`;\x0d\n    const importAttributes = request.attributes ?? kEmptyObject;\x0d\n    // Use an output parameter to track the state and avoid polluting the user-visible resolve results.\x0d\n    const out = { isResolvedByDefaultResolve: false\x2C __proto__: null };\x0d\n\x0d\n    let result;\x0d\n    let isResolvedBySyncHooks = false;\x0d\n    if (!shouldSkipSyncHooks && syncResolveHooks.length) {\x0d\n      // Has module.registerHooks() hooks\x2C chain the asynchronous hooks in the default step.\x0d\n      result = resolveWithSyncHooks(specifier\x2C parentURL\x2C importAttributes\x2C this.#defaultConditions\x2C\x0d\n                                    this.#resolveAndMaybeBlockOnLoaderThread.bind(this\x2C out));\x0d\n      // If the default step ran\x2C sync hooks did not short-circuit the resolution.\x0d\n      isResolvedBySyncHooks = !out.isResolvedByDefaultResolve;\x0d\n    } else {\x0d\n      const context = {\x0d\n        ...request\x2C\x0d\n        conditions: this.#defaultConditions\x2C\x0d\n        parentURL\x2C\x0d\n        importAttributes\x2C\x0d\n        __proto__: null\x2C\x0d\n      };\x0d\n      result = this.#resolveAndMaybeBlockOnLoaderThread(out\x2C specifier\x2C context);\x0d\n    }\x0d\n    result.isResolvedBySyncHooks = isResolvedBySyncHooks;\x0d\n    return result;\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * Provide source that is understood by one of Node's translators. Handles customization hooks\x2C\x0d\n   * if any.\x0d\n   * @typedef {{\x0d\n   *   format: ModuleFormat\x2C\x0d\n   *   source: ModuleSource\x2C\x0d\n   *   responseURL?: string\x2C\x0d\n   *   isSourceLoadedSynchronously: boolean\x2C\x0d\n   * }} LoadResult\x0d\n   * @param {string} url The URL of the module to be loaded.\x0d\n   * @param {object} context Metadata about the module\x0d\n   * @returns {Promise<LoadResult> | LoadResult}}\x0d\n   */\x0d\n  load(url\x2C context) {\x0d\n    if (this.isForAsyncLoaderHookWorker) {\x0d\n      // TODO(joyeecheung): invoke the synchronous hooks in the default step on loader thread.\x0d\n      return this.#asyncLoaderHooks.load(url\x2C context);\x0d\n    }\x0d\n    return this.#loadSync(url\x2C context);\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * This is the default load step for module.registerHooks()\x2C which incorporates asynchronous hooks\x0d\n   * from module.register() which are run in a blocking fashion for it to be synchronous.\x0d\n   * @param {{isSourceLoadedSynchronously: boolean}} out\x0d\n   *   Output object to track whether the source was loaded synchronously without polluting\x0d\n   *   the user-visible load result.\x0d\n   * @param {string} url See {@link load}\x0d\n   * @param {object} context See {@link load}\x0d\n   * @returns {{ format: ModuleFormat\x2C source: ModuleSource }}\x0d\n   */\x0d\n  #loadAndMaybeBlockOnLoaderThread(out\x2C url\x2C context) {\x0d\n    if (this.#asyncLoaderHooks?.loadSync) {\x0d\n      out.isSourceLoadedSynchronously = false;\x0d\n      return this.#asyncLoaderHooks.loadSync(url\x2C context);\x0d\n    }\x0d\n    out.isSourceLoadedSynchronously = true;\x0d\n    return defaultLoadSync(url\x2C context);\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * Similar to {@link load} but this is always run synchronously. If there are asynchronous hooks\x0d\n   * from module.register()\x2C this blocks on the loader thread for it to return synchronously.\x0d\n   *\x0d\n   * This is here to support `require()` in imported CJS and `module.registerHooks()` hooks.\x0d\n   * @param {string} url See {@link load}\x0d\n   * @param {object} [context] See {@link load}\x0d\n   * @returns {LoadResult}\x0d\n   */\x0d\n  #loadSync(url\x2C context) {\x0d\n    // Use an output parameter to track the state and avoid polluting the user-visible resolve results.\x0d\n    const out = {\x0d\n      isSourceLoadedSynchronously: true\x2C\x0d\n      __proto__: null\x2C\x0d\n    };\x0d\n    let result;\x0d\n    if (syncLoadHooks.length) {\x0d\n      // Has module.registerHooks() hooks\x2C chain the asynchronous hooks in the default step.\x0d\n      // TODO(joyeecheung): construct the ModuleLoadContext in the loaders directly instead\x0d\n      // of converting them from plain objects in the hooks.\x0d\n      result = loadWithSyncHooks(\x0d\n        url\x2C\x0d\n        context.format\x2C\x0d\n        context.importAttributes\x2C\x0d\n        this.#defaultConditions\x2C\x0d\n        this.#loadAndMaybeBlockOnLoaderThread.bind(this\x2C out)\x2C\x0d\n        validateLoadSloppy\x2C\x0d\n      );\x0d\n    } else {\x0d\n      result = this.#loadAndMaybeBlockOnLoaderThread(out\x2C url\x2C context);\x0d\n    }\x0d\n    result.isSourceLoadedSynchronously = out.isSourceLoadedSynchronously;\x0d\n    return result;\x0d\n  }\x0d\n\x0d\n  validateLoadResult(url\x2C format) {\x0d\n    if (format == null) {\x0d\n      throwUnknownModuleFormat(url\x2C format);\x0d\n    }\x0d\n  }\x0d\n\x0d\n  importMetaInitialize(meta\x2C context) {\x0d\n    if (this.#asyncLoaderHooks) {\x0d\n      return this.#asyncLoaderHooks.importMetaInitialize(meta\x2C context\x2C this);\x0d\n    }\x0d\n    importMetaInitializer ??= require('internal/modules/esm/initialize_import_meta').initializeImportMeta;\x0d\n    meta = importMetaInitializer(meta\x2C context\x2C this);\x0d\n    return meta;\x0d\n  }\x0d\n\x0d\n  /**\x0d\n   * Block until the async loader hooks have been initialized.\x0d\n   *\x0d\n   * No-op when no hooks have been supplied.\x0d\n   */\x0d\n  waitForAsyncLoaderHookInitialization() {\x0d\n    this.#asyncLoaderHooks?.waitForLoaderHookInitialization();\x0d\n  }\x0d\n}\x0d\nObjectSetPrototypeOf(ModuleLoader.prototype\x2C null);\x0d\n\x0d\nlet emittedLoaderFlagWarning = false;\x0d\n/**\x0d\n * A loader instance is used as the main entry point for loading ES modules. Currently\x2C this is a singleton; there is\x0d\n * only one used for loading the main module and everything in its dependency graph\x2C though separate instances of this\x0d\n * class might be instantiated as part of bootstrap for other purposes.\x0d\n * @param {AsyncLoaderHooksOnLoaderHookWorker|undefined} [asyncLoaderHooks]\x0d\n *   Only provided when run on the loader hook thread.\x0d\n * @returns {ModuleLoader}\x0d\n */\x0d\nfunction createModuleLoader(asyncLoaderHooks) {\x0d\n  // Don't spawn a new loader hook worker if we are already in a loader hook worker to avoid infinite recursion.\x0d\n  if (shouldSpawnLoaderHookWorker()) {\x0d\n    assert(asyncLoaderHooks === undefined\x2C 'asyncLoaderHooks should only be provided on the loader hook thread itself');\x0d\n    const userLoaderPaths = getOptionValue('--experimental-loader');\x0d\n    if (userLoaderPaths.length > 0) {\x0d\n      if (!emittedLoaderFlagWarning) {\x0d\n        const readableURIEncode = (string) => ArrayPrototypeReduce(\x0d\n          [\x0d\n            [/'/g\x2C '%27']\x2C // We need to URL-encode the single quote as it's the delimiter for the --import flag.\x0d\n            [/%22/g\x2C '"']\x2C // We can decode the double quotes to improve readability.\x0d\n            [/%2F/ig\x2C '/']\x2C // We can decode the slashes to improve readability.\x0d\n          ]\x2C\x0d\n          (str\x2C { 0: regex\x2C 1: replacement }) => RegExpPrototypeSymbolReplace(hardenRegExp(regex)\x2C str\x2C replacement)\x2C\x0d\n          encodeURIComponent(string));\x0d\n        process.emitWarning(\x0d\n          '`--experimental-loader` may be removed in the future; instead use `register()`:\\n' +\x0d\n          `--import 'data:text/javascript\x2Cimport { register } from "node:module"; import { pathToFileURL } from "node:url"; ${ArrayPrototypeJoin(\x0d\n            ArrayPrototypeMap(userLoaderPaths\x2C (loader) => `register(${readableURIEncode(JSONStringify(loader))}\x2C pathToFileURL("./"))`)\x2C\x0d\n            '; '\x2C\x0d\n          )};'`\x2C\x0d\n          'ExperimentalWarning'\x2C\x0d\n        );\x0d\n        emittedLoaderFlagWarning = true;\x0d\n      }\x0d\n      const { AsyncLoaderHooksProxiedToLoaderHookWorker } = require('internal/modules/esm/hooks');\x0d\n      asyncLoaderHooks = new AsyncLoaderHooksProxiedToLoaderHookWorker();\x0d\n    }\x0d\n  }\x0d\n\x0d\n  return new ModuleLoader(asyncLoaderHooks);\x0d\n}\x0d\n\x0d\nlet cascadedLoader;\x0d\n\x0d\n/**\x0d\n * This is a singleton ESM loader that integrates the loader hooks\x2C if any.\x0d\n * It it used by other internal built-ins when they need to load user-land ESM code\x0d\n * while also respecting hooks.\x0d\n * When built-ins need access to this loader\x2C they should do\x0d\n * require('internal/module/esm/loader').getOrInitializeCascadedLoader()\x0d\n * lazily only right before the loader is actually needed\x2C and don't do it\x0d\n * in the top-level\x2C to avoid circular dependencies.\x0d\n * @param {AsyncLoaderHooksOnLoaderHookWorker|undefined} [asyncLoaderHooks]\x0d\n *   Only provided when run on the loader hook thread.\x0d\n * @returns {ModuleLoader}\x0d\n */\x0d\nfunction getOrInitializeCascadedLoader(asyncLoaderHooks) {\x0d\n  cascadedLoader ??= createModuleLoader(asyncLoaderHooks);\x0d\n  return cascadedLoader;\x0d\n}\x0d\n\x0d\nfunction isCascadedLoaderInitialized() {\x0d\n  return cascadedLoader !== undefined;\x0d\n}\x0d\n\x0d\n/**\x0d\n * Register a single loader programmatically.\x0d\n * @param {string|URL} specifier\x0d\n * @param {string|URL} [parentURL] Base to use when resolving `specifier`; optional if\x0d\n *   `specifier` is absolute. Same as `options.parentUrl`\x2C just inline\x0d\n * @param {object} [options] Additional options to apply\x2C described below.\x0d\n *