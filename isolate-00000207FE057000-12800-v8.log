script-source,270,C:\\Users\\Basant\\Desktop\\NodeJS\\Car-Pool-Website\\node_modules\\.pnpm\\wrappy@1.0.2\\node_modules\\wrappy\\wrappy.js,// Returns a wrapper function that returns a wrapped callback\n// The wrapper function should do some stuff\x2C and return a\n// presumably different callback function.\n// This makes sure that own properties are retained\x2C so that\n// decorations and such are not lost along the way.\nmodule.exports = wrappy\nfunction wrappy (fn\x2C cb) {\n  if (fn && cb) return wrappy(fn)(cb)\n\n  if (typeof fn !== 'function')\n    throw new TypeError('need wrapper function')\n\n  Object.keys(fn).forEach(function (k) {\n    wrapper[k] = fn[k]\n  })\n\n  return wrapper\n\n  function wrapper() {\n    var args = new Array(arguments.length)\n    for (var i = 0; i < args.length; i++) {\n      args[i] = arguments[i]\n    }\n    var ret = fn.apply(this\x2C args)\n    var cb = args[args.length-1]\n    if (typeof ret === 'function' && ret !== cb) {\n      Object.keys(cb).forEach(function (k) {\n        ret[k] = cb[k]\n      })\n    }\n    return ret\n  }\n}\n
