script-source,118,file:///C:/Users/Basant/Desktop/NodeJS/Car-Pool-Website/src/adapters/inbound/http/routes/userRoutes.js,import { Router } from "express";\x0d\n\x0d\nimport {\x0d\n    validateCreateUser\x0d\n} from "../validators/userValidator.js";\x0d\n\x0d\nexport default function createUserRoutes(userController) {\x0d\n\x0d\n    const router = Router();\x0d\n\x0d\n    // Post api for creating the user : driver or passenger\x0d\n    router.post( "/"\x2C\x0d\n    validateCreateUser\x2C  (req\x2C res\x2C next) =>\x0d\n        userController.create(req\x2C res\x2C next)\x0d\n    );\x0d\n\x0d\n    // get api for id & rides // \x0d\n    router.get("/:id/rides"\x2C (req\x2C res\x2C next) =>\x0d\n        {\x0d\n            // debugger;\x0d\n            userController.getRides(req\x2C res\x2C next);\x0d\n        }\x0d\n    );\x0d\n\x0d\n    router.get(\x0d\n    "/:id/summary"\x2C\x0d\n    (req\x2C res\x2C next) =>\x0d\n        userController.getDriverSummary(\x0d\n            req\x2C\x0d\n            res\x2C\x0d\n            next\x0d\n        )\x0d\n    );\x0d\n\x0d\n\x0d\n    return router;\x0d\n}\x0d\n
